@model AccessDeniedViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Access Denied";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-lg rounded-4 p-5 text-center bg-body">
            <div class="display-4 text-danger mb-3"><i class="bi bi-shield-x"></i></div>
            <h1 class="h4 fw-bold mb-2">Access Denied</h1>
            <p class="text-body-secondary mb-4">
                You do not have the required role or permission to access this resource.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-speedometer2 me-1"></i>Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
