@using System.Text.Json
@model ExitDetailsPageViewModel
@{
    var r = Model.Request;
    var rd = Model.Readiness;
    var set = Model.Settlement;
    var iv = Model.ExitInterview;
    ViewData["Title"] = $"{r.SeparationNumber} — {r.EmployeeName}";
    ViewData["BreadcrumbParent"] = "Separation & Exit";
    var camelOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var effLwd = r.ApprovedLastWorkingDay ?? r.RequestedLastWorkingDay;
    var stBadge = r.SeparationStatus switch
    {
        "Completed" => "bg-success-subtle text-success-emphasis",
        "Settled" => "bg-info-subtle text-info-emphasis",
        "ClearanceInProgress" or "HrApproved" => "bg-primary-subtle text-primary-emphasis",
        "ManagerApproved" => "bg-warning-subtle text-warning-emphasis",
        "Submitted" => "bg-secondary-subtle text-secondary-emphasis",
        _ => "bg-danger-subtle text-danger-emphasis"
    };
    var canShowInterview = Model.CanManage || Model.IsOwner || (iv != null && !iv.IsConfidential);
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>All Separations
        </a>
        @if ((Model.IsOwner || Model.CanManage) && r.SeparationStatus is "Submitted" or "ManagerApproved")
        {
            <button type="button" class="btn btn-outline-warning btn-sm"
                    onclick='HrmsExit.withdrawSeparation(@r.SeparationId, @Html.Raw(JsonSerializer.Serialize(r.SeparationNumber)))'>
                <i class="bi bi-arrow-return-left me-1"></i>Withdraw Request
            </button>
        }
        @if (Model.CanManagerApprove && !Model.CanManage && !Model.IsOwner && r.SeparationStatus == "Submitted")
        {
            <button type="button" class="btn btn-primary btn-sm"
                    onclick='HrmsExit.openReviewModal(@r.SeparationId, "ManagerApprove", @Html.Raw(JsonSerializer.Serialize($"{r.SeparationNumber} — {r.EmployeeName}")), @Html.Raw(JsonSerializer.Serialize(effLwd.ToString("yyyy-MM-dd"))), false, true)'>
                <i class="bi bi-check2 me-1"></i>Manager Approve
            </button>
            <button type="button" class="btn btn-outline-danger btn-sm"
                    onclick='HrmsExit.openReviewModal(@r.SeparationId, "Reject", @Html.Raw(JsonSerializer.Serialize($"{r.SeparationNumber} — {r.EmployeeName}")), null, false, true)'>
                <i class="bi bi-x-lg me-1"></i>Reject
            </button>
        }
        @if (Model.CanManage && r.SeparationStatus is "Submitted" or "ManagerApproved")
        {
            <button type="button" class="btn btn-success btn-sm"
                    onclick='HrmsExit.openReviewModal(@r.SeparationId, "HrApprove", @Html.Raw(JsonSerializer.Serialize($"{r.SeparationNumber} — {r.EmployeeName}")), @Html.Raw(JsonSerializer.Serialize(effLwd.ToString("yyyy-MM-dd"))), @(r.IsNoticeWaived ? "true" : "false"), @(r.IsRehireEligible ? "true" : "false"))'>
                <i class="bi bi-check2-circle me-1"></i>HR Approve &amp; Start Clearance
            </button>
            <button type="button" class="btn btn-outline-danger btn-sm"
                    onclick='HrmsExit.openReviewModal(@r.SeparationId, "Reject", @Html.Raw(JsonSerializer.Serialize($"{r.SeparationNumber} — {r.EmployeeName}")), null, false, true)'>
                <i class="bi bi-x-lg me-1"></i>Reject
            </button>
        }
        @if (Model.CanManage && r.SeparationStatus is "ClearanceInProgress" or "Settled")
        {
            <button type="button" class="btn btn-danger btn-sm"
                    onclick='HrmsExit.finalizeExit(@r.SeparationId, @Html.Raw(JsonSerializer.Serialize(r.EmployeeName)))'>
                <i class="bi bi-shield-check me-1"></i>Finalize Exit &amp; Deactivate
            </button>
        }
    </div>
}

<!-- Live Offboarding Readiness Strip -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary fw-semibold">Active Company Assets</div>
                <div class="fs-4 fw-bold @(rd.ActiveAssetsCount > 0 ? "text-danger" : "text-success")">@rd.ActiveAssetsCount</div>
                <div class="small text-body-secondary">
                    @(rd.ActiveAssetsCount > 0 ? "Must return before finalization" : "All assets returned")
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary fw-semibold">Active Loans &amp; Advances</div>
                <div class="fs-4 fw-bold @(rd.ActiveLoansCount > 0 ? "text-warning" : "text-success")">@rd.ActiveLoanBalance.ToString("C2")</div>
                <div class="small text-body-secondary">@rd.ActiveLoansCount active loan account(s)</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary fw-semibold">Encashable Leave Balance</div>
                <div class="fs-4 fw-bold text-primary">@rd.EncashableLeaveDays.ToString("F1") <span class="fs-6 fw-normal text-body-secondary">days</span></div>
                <div class="small text-body-secondary">Eligible for F&amp;F encashment</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary fw-semibold">Monthly Base Reference</div>
                <div class="fs-4 fw-bold text-info">@((rd.MonthlyBaseSalary / 12m).ToString("C2"))</div>
                <div class="small text-body-secondary">Annual: @rd.MonthlyBaseSalary.ToString("C0")</div>
            </div>
        </div>
    </div>
</div>

<!-- Profile & Clearance Checklist Row -->
<div class="row g-3 mb-3">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-person-badge me-2 text-primary"></i>Separation Case Overview</h6>
                <span class="badge @stBadge">@r.SeparationStatus</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-5 text-body-secondary">Employee</dt>
                    <dd class="col-7 fw-semibold">@r.EmployeeName <span class="text-body-secondary fw-normal">(@r.EmployeeCode)</span></dd>
                    <dt class="col-5 text-body-secondary">Department / Role</dt>
                    <dd class="col-7">@r.DepartmentName &bull; @r.DesignationTitle</dd>
                    <dt class="col-5 text-body-secondary">Branch / Manager</dt>
                    <dd class="col-7">@(r.BranchName ?? "Corporate") &bull; @(r.ManagerName ?? "None")</dd>
                    <dt class="col-5 text-body-secondary">Hire Date</dt>
                    <dd class="col-7">@(r.HireDate?.ToString("dd MMM yyyy") ?? "-")</dd>
                    <dt class="col-5 text-body-secondary">Separation Type</dt>
                    <dd class="col-7 fw-semibold">@r.SeparationType (@r.ReasonCategory)</dd>
                    <dt class="col-5 text-body-secondary">Submitted</dt>
                    <dd class="col-7">@r.SubmissionDate.ToString("dd MMM yyyy")</dd>
                    <dt class="col-5 text-body-secondary">Requested / Approved LWD</dt>
                    <dd class="col-7">
                        @r.RequestedLastWorkingDay.ToString("dd MMM yyyy")
                        @if (r.ApprovedLastWorkingDay.HasValue)
                        {
                            <span class="text-primary fw-semibold"> &rarr; @r.ApprovedLastWorkingDay.Value.ToString("dd MMM yyyy")</span>
                        }
                    </dd>
                    <dt class="col-5 text-body-secondary">Notice Compliance</dt>
                    <dd class="col-7">
                        @r.NoticePeriodDays days required
                        @if (r.IsNoticeWaived)
                        {
                            <span class="badge bg-info-subtle text-info-emphasis ms-1">Waived</span>
                        }
                        else if (r.NoticeShortfallDays > 0)
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis ms-1">@r.NoticeShortfallDays d shortfall</span>
                        }
                        else
                        {
                            <span class="badge bg-success-subtle text-success-emphasis ms-1">Compliant</span>
                        }
                    </dd>
                    <dt class="col-5 text-body-secondary">Rehire Eligibility</dt>
                    <dd class="col-7">
                        <span class="badge @(r.IsRehireEligible ? "bg-success-subtle text-success-emphasis" : "bg-danger-subtle text-danger-emphasis")">
                            @(r.IsRehireEligible ? "Eligible" : "Not Eligible")
                        </span>
                    </dd>
                    @if (!string.IsNullOrWhiteSpace(r.EmployeeComments))
                    {
                        <dt class="col-5 text-body-secondary">Employee Notes</dt>
                        <dd class="col-7">@r.EmployeeComments</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(r.ManagerComments))
                    {
                        <dt class="col-5 text-body-secondary">Manager Notes</dt>
                        <dd class="col-7">@r.ManagerComments</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(r.HrComments))
                    {
                        <dt class="col-5 text-body-secondary">HR Notes</dt>
                        <dd class="col-7">@r.HrComments</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-list-check me-2 text-primary"></i>Multi-Department Exit Clearance Checklist</h6>
                @{
                    var clearedCnt = Model.ClearanceItems.Count(c => c.ClearanceStatus is "Cleared" or "Waived");
                }
                <span class="badge bg-primary-subtle text-primary-emphasis">@clearedCnt / @Model.ClearanceItems.Count Cleared</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Scope</th>
                                <th>Clearance Item</th>
                                <th>Status</th>
                                <th class="text-end">Recovery</th>
                                <th>Remarks</th>
                                @if (Model.CanManage)
                                {
                                    <th class="text-end">Action</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ClearanceItems.Any())
                            {
                                <tr><td colspan="@(Model.CanManage ? 6 : 5)" class="text-center text-body-secondary py-4">No clearance items configured.</td></tr>
                            }
                            else
                            {
                                @foreach (var item in Model.ClearanceItems)
                                {
                                    var cBadge = item.ClearanceStatus switch
                                    {
                                        "Cleared" => "bg-success-subtle text-success-emphasis",
                                        "Waived" => "bg-info-subtle text-info-emphasis",
                                        "Hold" => "bg-danger-subtle text-danger-emphasis",
                                        _ => "bg-warning-subtle text-warning-emphasis"
                                    };
                                    <tr>
                                        <td><span class="badge bg-secondary-subtle text-secondary-emphasis">@item.DepartmentScope</span></td>
                                        <td>
                                            <div class="fw-semibold">@item.ItemName</div>
                                            @if (item.IsMandatory)
                                            {
                                                <span class="text-danger" style="font-size: 0.72rem;">Mandatory</span>
                                            }
                                            else
                                            {
                                                <span class="text-body-secondary" style="font-size: 0.72rem;">Optional</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @cBadge">@item.ClearanceStatus</span>
                                            @if (item.ClearedDate.HasValue)
                                            {
                                                <div class="text-body-secondary" style="font-size: 0.72rem;">@item.ClearedDate.Value.ToString("dd MMM yy")</div>
                                            }
                                        </td>
                                        <td class="text-end fw-semibold">@(item.RecoveryAmount > 0 ? item.RecoveryAmount.ToString("C2") : "-")</td>
                                        <td>@(item.Remarks ?? "-")</td>
                                        @if (Model.CanManage)
                                        {
                                            <td class="text-end">
                                                @if (r.SeparationStatus is not ("Completed" or "Rejected" or "Withdrawn"))
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                                            onclick='HrmsExit.openClearanceModal(@Html.Raw(JsonSerializer.Serialize(item, camelOpts)))'>
                                                        Update
                                                    </button>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Full & Final Settlement + Exit Interview Row -->
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-cash-coin me-2 text-success"></i>Full &amp; Final Settlement</h6>
                <div class="d-flex gap-2 align-items-center">
                    @if (set != null)
                    {
                        var setBadge = set.SettlementStatus switch
                        {
                            "Paid" => "bg-success-subtle text-success-emphasis",
                            "Approved" => "bg-info-subtle text-info-emphasis",
                            _ => "bg-warning-subtle text-warning-emphasis"
                        };
                        <span class="badge @setBadge">@set.SettlementStatus</span>
                    }
                    @if (Model.CanManage && r.SeparationStatus is not ("Rejected" or "Withdrawn" or "Completed") && (set == null || set.SettlementStatus != "Paid"))
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                onclick='HrmsExit.openSettlementModal(@r.SeparationId, @Html.Raw(JsonSerializer.Serialize(set, camelOpts)), @Html.Raw(JsonSerializer.Serialize(rd, camelOpts)))'>
                            <i class="bi bi-calculator me-1"></i>@(set == null ? "Calculate F&F" : "Recalculate")
                        </button>
                    }
                </div>
            </div>
            <div class="card-body">
                @if (set == null)
                {
                    <div class="text-center text-body-secondary py-4 small">
                        Full &amp; Final settlement has not been calculated yet.
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-center mb-2 small">
                        <span class="text-body-secondary">Settlement Ref: <strong class="font-monospace">@set.SettlementNumber</strong></span>
                        <span class="text-body-secondary">Worked Days: <strong>@set.WorkedDaysInFinalMonth</strong></span>
                    </div>
                    <table class="table table-sm small mb-3">
                        <tbody>
                            <tr class="table-light"><th colspan="2">Earnings</th></tr>
                            <tr><td>Prorated Final Month Salary</td><td class="text-end">@set.ProratedSalaryPay.ToString("C2")</td></tr>
                            <tr><td>Leave Encashment (@set.EncashableLeaveDays.ToString("F1") days)</td><td class="text-end">@set.LeaveEncashmentAmount.ToString("C2")</td></tr>
                            <tr><td>Gratuity / Severance</td><td class="text-end">@set.GratuityOrSeverance.ToString("C2")</td></tr>
                            <tr><td>Bonus / Other Earnings</td><td class="text-end">@set.BonusOrOtherEarnings.ToString("C2")</td></tr>
                            <tr class="fw-semibold"><td>Gross Earnings</td><td class="text-end text-success">@set.GrossEarnings.ToString("C2")</td></tr>

                            <tr class="table-light"><th colspan="2">Recoveries &amp; Deductions</th></tr>
                            <tr><td>Outstanding Loan Recovery</td><td class="text-end text-danger">-@set.OutstandingLoanRecovery.ToString("C2")</td></tr>
                            <tr><td>Asset / Notice Shortfall Recovery</td><td class="text-end text-danger">-@set.AssetOrNoticeRecovery.ToString("C2")</td></tr>
                            <tr><td>Tax &amp; Other Deductions</td><td class="text-end text-danger">-@set.TaxAndOtherDeductions.ToString("C2")</td></tr>
                            <tr class="fw-semibold"><td>Total Deductions</td><td class="text-end text-danger">-@set.TotalDeductions.ToString("C2")</td></tr>

                            <tr class="table-primary fw-bold fs-6">
                                <td>Net Payable Amount</td>
                                <td class="text-end">@set.NetPayableAmount.ToString("C2")</td>
                            </tr>
                        </tbody>
                    </table>

                    @if (!string.IsNullOrWhiteSpace(set.PaymentReference) || set.PaidDate.HasValue)
                    {
                        <div class="small text-body-secondary mb-2">
                            Payment Ref: <strong>@(set.PaymentReference ?? "-")</strong> &bull; Paid: <strong>@(set.PaidDate?.ToString("dd MMM yyyy") ?? "-")</strong>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(set.Notes))
                    {
                        <div class="small text-body-secondary mb-3">@set.Notes</div>
                    }

                    @if (Model.CanManage)
                    {
                        <div class="d-flex gap-2">
                            @if (set.SettlementStatus == "Draft")
                            {
                                <button type="button" class="btn btn-sm btn-success"
                                        onclick='HrmsExit.approveSettlement(@set.SettlementId, @Html.Raw(JsonSerializer.Serialize(set.SettlementNumber)))'>
                                    <i class="bi bi-check2-circle me-1"></i>Approve Settlement
                                </button>
                            }
                            else if (set.SettlementStatus == "Approved")
                            {
                                <button type="button" class="btn btn-sm btn-primary"
                                        onclick='HrmsExit.openSettlementPayModal(@set.SettlementId, @Html.Raw(JsonSerializer.Serialize(set.SettlementNumber)), @set.NetPayableAmount)'>
                                    <i class="bi bi-bank me-1"></i>Mark as Paid
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-chat-square-quote me-2 text-info"></i>Exit Interview &amp; Feedback</h6>
                @if ((Model.CanManage || Model.IsOwner) && r.SeparationStatus is not ("Rejected" or "Withdrawn"))
                {
                    <button type="button" class="btn btn-sm btn-outline-info"
                            onclick='HrmsExit.openExitInterviewModal(@r.SeparationId, @Html.Raw(JsonSerializer.Serialize(iv, camelOpts)), @Html.Raw(JsonSerializer.Serialize($"{r.SeparationNumber} — {r.EmployeeName}")))'>
                        <i class="bi bi-pencil-square me-1"></i>@(iv == null ? "Record Interview" : "Update Feedback")
                    </button>
                }
            </div>
            <div class="card-body">
                @if (!canShowInterview)
                {
                    <div class="text-center text-body-secondary py-4 small">
                        <i class="bi bi-lock fs-4 d-block mb-1"></i>Exit interview feedback is restricted to HR and the separating employee.
                    </div>
                }
                else if (iv == null)
                {
                    <div class="text-center text-body-secondary py-4 small">
                        No exit interview recorded yet for this separation.
                    </div>
                }
                else
                {
                    <div class="row g-2 mb-3 text-center small">
                        <div class="col-3">
                            <div class="p-2 rounded bg-body-tertiary">
                                <div class="text-body-secondary">Overall</div>
                                <div class="fw-bold fs-5">@iv.OverallSatisfactionRating/5</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="p-2 rounded bg-body-tertiary">
                                <div class="text-body-secondary">Manager</div>
                                <div class="fw-bold fs-5">@iv.ManagerSupportRating/5</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="p-2 rounded bg-body-tertiary">
                                <div class="text-body-secondary">Work-Life</div>
                                <div class="fw-bold fs-5">@iv.WorkLifeBalanceRating/5</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="p-2 rounded bg-body-tertiary">
                                <div class="text-body-secondary">Pay</div>
                                <div class="fw-bold fs-5">@iv.CompensationRating/5</div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge @(iv.WouldRecommendCompany ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                            @(iv.WouldRecommendCompany ? "Would Recommend" : "Would Not Recommend")
                        </span>
                        <span class="badge @(iv.WouldConsiderRejoining ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                            @(iv.WouldConsiderRejoining ? "Open to Rejoining" : "Not Open to Rejoining")
                        </span>
                        @if (iv.IsConfidential)
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis">Confidential</span>
                        }
                    </div>
                    <dl class="row mb-0 small">
                        <dt class="col-5 text-body-secondary">Interview Date</dt>
                        <dd class="col-7">@iv.InterviewDate.ToString("dd MMM yyyy")</dd>
                        <dt class="col-5 text-body-secondary">Primary Reason</dt>
                        <dd class="col-7 fw-semibold">@iv.PrimaryLeavingReason</dd>
                        @if (!string.IsNullOrWhiteSpace(iv.LikedMost))
                        {
                            <dt class="col-5 text-body-secondary">Liked Most</dt>
                            <dd class="col-7">@iv.LikedMost</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(iv.ImprovementSuggestions))
                        {
                            <dt class="col-5 text-body-secondary">Improvements</dt>
                            <dd class="col-7">@iv.ImprovementSuggestions</dd>
                        }
                        @if (Model.CanManage && !string.IsNullOrWhiteSpace(iv.InterviewerNotes))
                        {
                            <dt class="col-5 text-body-secondary">HR Interviewer Notes</dt>
                            <dd class="col-7">@iv.InterviewerNotes</dd>
                        }
                    </dl>
                }
            </div>
        </div>
    </div>
</div>

<!-- Review Separation Modal -->
<div class="modal fade" id="reviewSeparationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="revModalTitle">Review Separation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="reviewSeparationForm" onsubmit="event.preventDefault(); HrmsExit.submitAjaxForm('#reviewSeparationForm', '@Url.Action("Review")', '#reviewSeparationModal');">
                @Html.AntiForgeryToken()
                <input type="hidden" id="revSepId" name="SeparationId" value="@r.SeparationId" />
                <input type="hidden" id="revAction" name="Action" value="HrApprove" />
                <div class="modal-body">
                    <div class="fw-semibold mb-3" id="revLabel">@r.SeparationNumber — @r.EmployeeName</div>
                    <div class="mb-3" id="revLwdGroup">
                        <label class="form-label small fw-semibold">Approved Last Working Day</label>
                        <input type="date" id="revLwd" name="ApprovedLastWorkingDay" class="form-control" />
                    </div>
                    <div class="mb-3 d-none" id="revHrOptionsGroup">
                        <div class="form-check form-switch mb-2">
                            <input type="hidden" name="IsNoticeWaived" value="false" />
                            <input class="form-check-input" type="checkbox" id="revWaived" name="IsNoticeWaived" value="true" />
                            <label class="form-check-label small fw-semibold" for="revWaived">Waive Notice Period Shortfall</label>
                        </div>
                        <div class="form-check form-switch">
                            <input type="hidden" name="IsRehireEligible" value="false" />
                            <input class="form-check-input" type="checkbox" id="revRehire" name="IsRehireEligible" value="true" checked />
                            <label class="form-check-label small fw-semibold" for="revRehire">Eligible for Rehire</label>
                        </div>
                    </div>
                    <div>
                        <label class="form-label small fw-semibold">Comments</label>
                        <textarea id="revComments" name="Comments" class="form-control" rows="3" maxlength="600"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="revSubmitBtn">Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.CanManage)
{
    <!-- Update Clearance Item Modal -->
    <div class="modal fade" id="clearanceItemModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Update Clearance Sign-Off</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="clearanceItemForm" onsubmit="event.preventDefault(); HrmsExit.submitAjaxForm('#clearanceItemForm', '@Url.Action("UpdateClearanceItem")', '#clearanceItemModal');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="clrItemId" name="ClearanceItemId" value="0" />
                    <div class="modal-body">
                        <div class="fw-semibold mb-3" id="clrItemLabel"></div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-semibold">Status</label>
                                <select id="clrStatus" name="ClearanceStatus" class="form-select">
                                    <option value="Cleared">Cleared</option>
                                    <option value="Waived">Waived</option>
                                    <option value="Hold">Hold</option>
                                    <option value="Pending">Pending</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold">Recovery Amount</label>
                                <input type="number" step="0.01" min="0" id="clrRecovery" name="RecoveryAmount" class="form-control" value="0" />
                            </div>
                        </div>
                        <div>
                            <label class="form-label small fw-semibold">Sign-Off Remarks</label>
                            <textarea id="clrRemarks" name="Remarks" class="form-control" rows="2" maxlength="400"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Clearance</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Calculate Final Settlement Modal -->
    <div class="modal fade" id="settlementCalcModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-calculator me-2 text-primary"></i>Calculate Full &amp; Final Settlement</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="settlementCalcForm" onsubmit="event.preventDefault(); HrmsExit.submitAjaxForm('#settlementCalcForm', '@Url.Action("CalculateSettlement")', '#settlementCalcModal');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="setSepId" name="SeparationId" value="@r.SeparationId" />
                    <div class="modal-body">
                        <div class="alert alert-light border small mb-3">
                            Leave optional fields blank to auto-calculate prorated salary, encashable leave balance, active loan payoff, clearance recoveries, and notice shortfall recovery.
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Worked Days in Final Month</label>
                                <input type="number" min="0" max="31" id="setWorkedDays" name="WorkedDaysInFinalMonth" class="form-control" placeholder="Auto (LWD day)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Encashable Leave Days</label>
                                <input type="number" step="0.5" min="0" max="365" id="setLeaveDays" name="EncashableLeaveDays" class="form-control" placeholder="Auto from balance" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Gratuity / Severance</label>
                                <input type="number" step="0.01" min="0" id="setGratuity" name="GratuityOrSeverance" class="form-control" value="0" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Bonus / Other Earnings</label>
                                <input type="number" step="0.01" min="0" id="setBonus" name="BonusOrOtherEarnings" class="form-control" value="0" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Outstanding Loan Recovery</label>
                                <input type="number" step="0.01" min="0" id="setLoanRec" name="OutstandingLoanRecovery" class="form-control" placeholder="Auto from loans" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Asset / Notice Recovery</label>
                                <input type="number" step="0.01" min="0" id="setAssetRec" name="AssetOrNoticeRecovery" class="form-control" placeholder="Auto from clearance + notice" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Tax &amp; Other Deductions</label>
                                <input type="number" step="0.01" min="0" id="setTax" name="TaxAndOtherDeductions" class="form-control" value="0" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small fw-semibold">Settlement Notes</label>
                                <input type="text" id="setNotes" name="Notes" class="form-control" maxlength="500" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Calculate &amp; Save Draft</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Mark Settlement Paid Modal -->
    <div class="modal fade" id="settlementPayModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-bank me-2 text-success"></i>Record Settlement Payout</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="settlementPayForm" onsubmit="event.preventDefault(); HrmsExit.submitAjaxForm('#settlementPayForm', '@Url.Action("UpdateSettlementStatus")', '#settlementPayModal');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="paySetId" name="SettlementId" value="0" />
                    <input type="hidden" name="SettlementStatus" value="Paid" />
                    <div class="modal-body">
                        <div class="fw-semibold mb-3" id="paySetLabel"></div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Payment / Bank Reference</label>
                            <input type="text" id="payRef" name="PaymentReference" class="form-control" maxlength="80" required />
                        </div>
                        <div>
                            <label class="form-label small fw-semibold">Paid Date</label>
                            <input type="date" id="payDate" name="PaidDate" class="form-control" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Confirm Payout</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Exit Interview Modal -->
<div class="modal fade" id="exitInterviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-chat-square-quote me-2 text-info"></i>Exit Interview &amp; Feedback</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="exitInterviewForm" onsubmit="event.preventDefault(); HrmsExit.submitAjaxForm('#exitInterviewForm', '@Url.Action("SaveExitInterview")', '#exitInterviewModal');">
                @Html.AntiForgeryToken()
                <input type="hidden" id="ivSepIdHidden" name="SeparationId" value="@r.SeparationId" />
                <div class="modal-body">
                    <div class="fw-semibold mb-3" id="ivLabel">@r.SeparationNumber — @r.EmployeeName</div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Interview Date <span class="text-danger">*</span></label>
                            <input type="date" id="ivDate" name="InterviewDate" class="form-control" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold">Primary Reason for Leaving <span class="text-danger">*</span></label>
                            <input type="text" id="ivReason" name="PrimaryLeavingReason" class="form-control" maxlength="200" required />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold">Overall (1-5)</label>
                            <input type="number" min="1" max="5" id="ivOverall" name="OverallSatisfactionRating" class="form-control" value="4" required />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold">Manager Support</label>
                            <input type="number" min="1" max="5" id="ivManager" name="ManagerSupportRating" class="form-control" value="4" required />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold">Work-Life Balance</label>
                            <input type="number" min="1" max="5" id="ivWlb" name="WorkLifeBalanceRating" class="form-control" value="4" required />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold">Compensation</label>
                            <input type="number" min="1" max="5" id="ivComp" name="CompensationRating" class="form-control" value="3" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">What Did You Like Most?</label>
                            <textarea id="ivLiked" name="LikedMost" class="form-control" rows="2" maxlength="500"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Suggestions for Improvement</label>
                            <textarea id="ivImprove" name="ImprovementSuggestions" class="form-control" rows="2" maxlength="500"></textarea>
                        </div>
                        @if (Model.CanManage)
                        {
                            <div class="col-12">
                                <label class="form-label small fw-semibold">HR Interviewer Notes</label>
                                <textarea id="ivNotes" name="InterviewerNotes" class="form-control" rows="2" maxlength="500"></textarea>
                            </div>
                        }
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input type="hidden" name="WouldRecommendCompany" value="false" />
                                <input class="form-check-input" type="checkbox" id="ivRecommend" name="WouldRecommendCompany" value="true" checked />
                                <label class="form-check-label small fw-semibold" for="ivRecommend">Would Recommend Company</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input type="hidden" name="WouldConsiderRejoining" value="false" />
                                <input class="form-check-input" type="checkbox" id="ivRejoin" name="WouldConsiderRejoining" value="true" checked />
                                <label class="form-check-label small fw-semibold" for="ivRejoin">Would Consider Rejoining</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input type="hidden" name="IsConfidential" value="false" />
                                <input class="form-check-input" type="checkbox" id="ivConf" name="IsConfidential" value="true" checked />
                                <label class="form-check-label small fw-semibold" for="ivConf">Confidential (HR Only)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info text-white">Save Feedback</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/exit.js" asp-append-version="true"></script>
}
