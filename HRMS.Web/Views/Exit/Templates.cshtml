@using System.Text.Json
@model List<HRMS.Models.Entities.ExitClearanceTemplate>
@{
    ViewData["Title"] = "Exit Clearance Checklist Templates";
    ViewData["BreadcrumbParent"] = "Separation & Exit";
    var camelOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

@section PageActions {
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Separation Cases
        </a>
        <button type="button" class="btn btn-primary btn-sm" onclick="HrmsExit.openTemplateModal()">
            <i class="bi bi-plus-lg me-1"></i>Add Clearance Item
        </button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-exit-datatable w-100">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Department Scope</th>
                        <th>Checklist Item</th>
                        <th>Description</th>
                        <th>Requirement</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td class="small font-monospace">@t.DisplayOrder</td>
                            <td><span class="badge bg-primary-subtle text-primary-emphasis">@t.DepartmentScope</span></td>
                            <td class="fw-semibold small">@t.ItemName</td>
                            <td class="small text-body-secondary">@(t.Description ?? "-")</td>
                            <td>
                                <span class="badge @(t.IsMandatory ? "bg-danger-subtle text-danger-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                                    @(t.IsMandatory ? "Mandatory" : "Optional")
                                </span>
                            </td>
                            <td>
                                <span class="badge @(t.IsActive ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                                    @(t.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary" title="Edit Template"
                                        onclick='HrmsExit.openTemplateModal(@Html.Raw(JsonSerializer.Serialize(t, camelOpts)))'>
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="Delete Template"
                                        onclick='HrmsExit.deleteTemplate(@t.TemplateId, @Html.Raw(JsonSerializer.Serialize(t.ItemName)))'>
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add / Edit Template Modal -->
<div class="modal fade" id="clearanceTemplateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tplModalTitle">Add Clearance Template</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="clearanceTemplateForm" onsubmit="event.preventDefault(); HrmsExit.submitAjaxForm('#clearanceTemplateForm', '@Url.Action("SaveTemplate")', '#clearanceTemplateModal');">
                @Html.AntiForgeryToken()
                <input type="hidden" id="tplId" name="TemplateId" value="0" />
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label small fw-semibold">Department Scope <span class="text-danger">*</span></label>
                            <select id="tplScope" name="DepartmentScope" class="form-select" required>
                                <option value="Manager">Manager</option>
                                <option value="IT">IT</option>
                                <option value="Assets">Assets</option>
                                <option value="AdminFacilities">AdminFacilities</option>
                                <option value="Finance">Finance</option>
                                <option value="HR">HR</option>
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold">Display Order</label>
                            <input type="number" min="1" max="100" id="tplOrder" name="DisplayOrder" class="form-control" value="1" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Checklist Item Name <span class="text-danger">*</span></label>
                            <input type="text" id="tplName" name="ItemName" class="form-control" maxlength="150" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Description / Instructions</label>
                            <textarea id="tplDesc" name="Description" class="form-control" rows="2" maxlength="300"></textarea>
                        </div>
                        <div class="col-6">
                            <div class="form-check form-switch">
                                <input type="hidden" name="IsMandatory" value="false" />
                                <input class="form-check-input" type="checkbox" id="tplMandatory" name="IsMandatory" value="true" checked />
                                <label class="form-check-label small fw-semibold" for="tplMandatory">Mandatory for Exit</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check form-switch">
                                <input type="hidden" name="IsActive" value="false" />
                                <input class="form-check-input" type="checkbox" id="tplActive" name="IsActive" value="true" checked />
                                <label class="form-check-label small fw-semibold" for="tplActive">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Template</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/exit.js" asp-append-version="true"></script>
}
