@using System.Text.Json
@model ExitIndexPageViewModel
@{
    ViewData["Title"] = Model.CanManage ? "Separation & Exit Management" : (Model.IsManager ? "Team & My Separations" : "My Separation Requests");
    ViewData["BreadcrumbParent"] = "Talent, Assets & Compliance";
    var camelOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Export" asp-route-departmentId="@Model.DepartmentId" asp-route-status="@Model.Status"
           asp-route-separationType="@Model.SeparationType" asp-route-search="@Model.Search"
           class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-download me-1"></i>Export CSV
        </a>
        @if (Model.CanManage)
        {
            <a asp-action="Interviews" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-chat-square-quote me-1"></i>Exit Interviews
            </a>
            <a asp-action="Templates" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-list-check me-1"></i>Clearance Templates
            </a>
        }
        @if (Model.CanManage || Model.CurrentEmployeeId.HasValue)
        {
            <button type="button" class="btn btn-primary btn-sm" onclick="HrmsExit.openSubmitModal()">
                <i class="bi bi-box-arrow-right me-1"></i>@(Model.CanManage ? "Initiate Separation" : "Submit Resignation")
            </button>
        }
    </div>
}

<!-- KPI Summary Strip -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary fw-semibold">Total Cases</div>
                <div class="fs-4 fw-bold">@Model.Kpi.TotalRequests</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-warning fw-semibold">Pending Approval</div>
                <div class="fs-4 fw-bold text-warning">@Model.Kpi.PendingApprovalCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-primary fw-semibold">In Clearance</div>
                <div class="fs-4 fw-bold text-primary">@Model.Kpi.ClearanceInProgressCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-success fw-semibold">Settled / Completed</div>
                <div class="fs-4 fw-bold text-success">@Model.Kpi.CompletedCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-info fw-semibold">Pending Settlements</div>
                <div class="fs-4 fw-bold text-info">@Model.Kpi.TotalPendingSettlementAmount.ToString("C0")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-secondary fw-semibold">Avg Exit Rating</div>
                <div class="fs-4 fw-bold">@Model.Kpi.AvgExitSatisfaction.ToString("F1") <span class="fs-6 text-body-secondary fw-normal">/ 5</span></div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Strip -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            @if (Model.CanManage)
            {
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Department</label>
                    <select name="departmentId" class="form-select form-select-sm">
                        <option value="">All Departments</option>
                        @foreach (var dept in Model.Departments)
                        {
                            <option value="@dept.DepartmentId" selected="@(Model.DepartmentId == dept.DepartmentId)">@dept.DepartmentName</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var st in new[] { "Submitted", "ManagerApproved", "ClearanceInProgress", "Settled", "Completed", "Rejected", "Withdrawn" })
                    {
                        <option value="@st" selected="@(string.Equals(Model.Status, st, StringComparison.OrdinalIgnoreCase))">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Separation Type</label>
                <select name="separationType" class="form-select form-select-sm">
                    <option value="">All Types</option>
                    @foreach (var tp in new[] { "Resignation", "Termination", "Retirement", "ContractEnd", "MutualSeparation" })
                    {
                        <option value="@tp" selected="@(string.Equals(Model.SeparationType, tp, StringComparison.OrdinalIgnoreCase))">@tp</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Keyword</label>
                <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Case #, employee code, name..." />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Separation Requests Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-exit-datatable w-100">
                <thead>
                    <tr>
                        <th>Case # &amp; Type</th>
                        <th>Employee</th>
                        <th>Timeline &amp; Notice</th>
                        <th>Clearance &amp; Assets</th>
                        <th class="text-end">Final Settlement</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Requests)
                    {
                        var stBadge = r.SeparationStatus switch
                        {
                            "Completed" => "bg-success-subtle text-success-emphasis",
                            "Settled" => "bg-info-subtle text-info-emphasis",
                            "ClearanceInProgress" or "HrApproved" => "bg-primary-subtle text-primary-emphasis",
                            "ManagerApproved" => "bg-warning-subtle text-warning-emphasis",
                            "Submitted" => "bg-secondary-subtle text-secondary-emphasis",
                            _ => "bg-danger-subtle text-danger-emphasis"
                        };
                        var pct = r.TotalClearanceItemsCount > 0 ? (int)Math.Round(100.0 * r.ClearedItemsCount / r.TotalClearanceItemsCount) : 0;
                        var effLwd = r.ApprovedLastWorkingDay ?? r.RequestedLastWorkingDay;
                        var isSelf = Model.CurrentEmployeeId.HasValue && Model.CurrentEmployeeId.Value == r.EmployeeId;
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@r.SeparationId" class="fw-semibold font-monospace text-decoration-none">@r.SeparationNumber</a>
                                <div class="small text-body-secondary">@r.SeparationType &bull; @r.ReasonCategory</div>
                            </td>
                            <td class="small">
                                <div class="fw-semibold">@r.EmployeeName <span class="text-body-secondary fw-normal">(@r.EmployeeCode)</span></div>
                                <div class="text-body-secondary">@r.DepartmentName &bull; @r.DesignationTitle</div>
                            </td>
                            <td class="small">
                                <div>LWD: <span class="fw-semibold">@effLwd.ToString("dd MMM yyyy")</span></div>
                                <div class="text-body-secondary">
                                    Sub: @r.SubmissionDate.ToString("dd MMM yy") &bull; @r.NoticePeriodDays d notice
                                    @if (r.NoticeShortfallDays > 0)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis ms-1">@r.NoticeShortfallDays d shortfall</span>
                                    }
                                </div>
                            </td>
                            <td class="small" style="min-width: 170px;">
                                <div class="d-flex justify-content-between mb-1">
                                    <span>Checklist: <strong>@r.ClearedItemsCount/@r.TotalClearanceItemsCount</strong></span>
                                    <span>@pct%</span>
                                </div>
                                <div class="progress mb-1" style="height: 5px;">
                                    <div class="progress-bar @(pct == 100 ? "bg-success" : "bg-primary")" style="width: @pct%"></div>
                                </div>
                                <div class="d-flex flex-wrap gap-1">
                                    @if (r.ActiveAssetsCount > 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger-emphasis">@r.ActiveAssetsCount Asset(s)</span>
                                    }
                                    @if (r.ActiveLoansCount > 0)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis">@r.ActiveLoansCount Loan(s)</span>
                                    }
                                    @if (r.HasExitInterview)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis">Interviewed</span>
                                    }
                                </div>
                            </td>
                            <td class="text-end small">
                                @if (!string.IsNullOrWhiteSpace(r.SettlementStatus))
                                {
                                    var setBadge = r.SettlementStatus switch
                                    {
                                        "Paid" => "bg-success-subtle text-success-emphasis",
                                        "Approved" => "bg-info-subtle text-info-emphasis",
                                        _ => "bg-secondary-subtle text-secondary-emphasis"
                                    };
                                    <div class="fw-semibold">@((r.SettlementNetAmount ?? 0m).ToString("C2"))</div>
                                    <span class="badge @setBadge">@r.SettlementStatus</span>
                                }
                                else
                                {
                                    <span class="text-body-secondary">Pending</span>
                                }
                            </td>
                            <td><span class="badge @stBadge">@r.SeparationStatus</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@r.SeparationId" class="btn btn-sm btn-outline-secondary" title="Offboarding 360°">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (Model.IsManager && !Model.CanManage && !isSelf && r.SeparationStatus == "Submitted")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary" title="Manager Approve"
                                            onclick='HrmsExit.openReviewModal(@r.SeparationId, "ManagerApprove", @Html.Raw(JsonSerializer.Serialize($"{r.SeparationNumber} — {r.EmployeeName}")), @Html.Raw(JsonSerializer.Serialize(effLwd.ToString("yyyy-MM-dd"))), @(r.IsNoticeWaived ? "true" : "false"), @(r.IsRehireEligible ? "true" : "false"))'>
                                        <i class="bi bi-check2"></i>
                                    </button>
                                }
                                @if (Model.CanManage && r.SeparationStatus is "Submitted" or "ManagerApproved")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success" title="HR Approve &amp; Start Clearance"
                                            onclick='HrmsExit.openReviewModal(@r.SeparationId, "HrApprove", @Html.Raw(JsonSerializer.Serialize($"{r.SeparationNumber} — {r.EmployeeName}")), @Html.Raw(JsonSerializer.Serialize(effLwd.ToString("yyyy-MM-dd"))), @(r.IsNoticeWaived ? "true" : "false"), @(r.IsRehireEligible ? "true" : "false"))'>
                                        <i class="bi bi-check2-circle"></i>
                                    </button>
                                }
                                @if ((isSelf || Model.CanManage) && r.SeparationStatus is "Submitted" or "ManagerApproved")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-warning" title="Withdraw"
                                            onclick='HrmsExit.withdrawSeparation(@r.SeparationId, @Html.Raw(JsonSerializer.Serialize(r.SeparationNumber)))'>
                                        <i class="bi bi-arrow-return-left"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Submit Resignation / Initiate Separation Modal -->
<div class="modal fade" id="submitSeparationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-box-arrow-right me-2 text-primary"></i>@(Model.CanManage ? "Initiate Separation Request" : "Submit Resignation Request")
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="submitSeparationForm" onsubmit="event.preventDefault(); HrmsExit.submitAjaxForm('#submitSeparationForm', '@Url.Action("Submit")', '#submitSeparationModal');">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        @if (Model.CanManage)
                        {
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Employee <span class="text-danger">*</span></label>
                                <select id="sepEmployeeId" name="EmployeeId" class="form-select hrms-select2" required>
                                    <option value="">Select active employee...</option>
                                    @foreach (var emp in Model.Employees)
                                    {
                                        <option value="@emp.EmployeeId">@emp.FullName (@emp.EmployeeCode) — @emp.DepartmentName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Separation Type <span class="text-danger">*</span></label>
                                <select id="sepType" name="SeparationType" class="form-select" required>
                                    <option value="Resignation">Resignation</option>
                                    <option value="Termination">Termination</option>
                                    <option value="Retirement">Retirement</option>
                                    <option value="ContractEnd">ContractEnd</option>
                                    <option value="MutualSeparation">MutualSeparation</option>
                                </select>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" name="EmployeeId" value="@(Model.CurrentEmployeeId ?? 0)" />
                            <input type="hidden" name="SeparationType" value="Resignation" />
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Separation Type</label>
                                <input type="text" class="form-control" value="Resignation" readonly />
                            </div>
                        }
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Reason Category <span class="text-danger">*</span></label>
                            <select id="sepReason" name="ReasonCategory" class="form-select" required>
                                <option value="BetterOpportunity">BetterOpportunity</option>
                                <option value="CareerChange">CareerChange</option>
                                <option value="Relocation">Relocation</option>
                                <option value="PersonalHealth">PersonalHealth</option>
                                <option value="Retirement">Retirement</option>
                                <option value="ContractCompletion">ContractCompletion</option>
                                @if (Model.CanManage)
                                {
                                    <option value="Performance">Performance</option>
                                    <option value="Misconduct">Misconduct</option>
                                    <option value="Redundancy">Redundancy</option>
                                }
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Submission Date <span class="text-danger">*</span></label>
                            <input type="date" id="sepSubDate" name="SubmissionDate" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Notice Period (Days)</label>
                            <input type="number" id="sepNoticeDays" name="NoticePeriodDays" class="form-control" min="0" max="180" value="30" @(Model.CanManage ? "" : "readonly") />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Requested Last Working Day <span class="text-danger">*</span></label>
                            <input type="date" id="sepLwd" name="RequestedLastWorkingDay" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Employee Remarks</label>
                            <textarea id="sepEmpComments" name="EmployeeComments" class="form-control" rows="2" maxlength="600" placeholder="Optional handover or resignation notes..."></textarea>
                        </div>
                        @if (Model.CanManage)
                        {
                            <div class="col-12">
                                <label class="form-label small fw-semibold">HR Notes</label>
                                <textarea id="sepHrComments" name="HrComments" class="form-control" rows="2" maxlength="600"></textarea>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input type="hidden" name="IsNoticeWaived" value="false" />
                                    <input class="form-check-input" type="checkbox" id="sepWaived" name="IsNoticeWaived" value="true" />
                                    <label class="form-check-label small fw-semibold" for="sepWaived">Waive Notice Shortfall Recovery</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input type="hidden" name="InitiateAsHrApproved" value="false" />
                                    <input class="form-check-input" type="checkbox" id="sepInitApproved" name="InitiateAsHrApproved" value="true" />
                                    <label class="form-check-label small fw-semibold" for="sepInitApproved">Start Clearance Immediately (HR Pre-Approved)</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Review Separation Modal -->
<div class="modal fade" id="reviewSeparationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="revModalTitle">Review Separation Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="reviewSeparationForm" onsubmit="event.preventDefault(); HrmsExit.submitAjaxForm('#reviewSeparationForm', '@Url.Action("Review")', '#reviewSeparationModal');">
                @Html.AntiForgeryToken()
                <input type="hidden" id="revSepId" name="SeparationId" value="0" />
                <input type="hidden" id="revAction" name="Action" value="HrApprove" />
                <div class="modal-body">
                    <div class="mb-3">
                        <div class="small text-body-secondary">Separation Case</div>
                        <div class="fw-semibold" id="revLabel"></div>
                    </div>
                    <div class="mb-3" id="revLwdGroup">
                        <label class="form-label small fw-semibold">Approved Last Working Day</label>
                        <input type="date" id="revLwd" name="ApprovedLastWorkingDay" class="form-control" />
                    </div>
                    <div class="mb-3 d-none" id="revHrOptionsGroup">
                        <div class="form-check form-switch mb-2">
                            <input type="hidden" name="IsNoticeWaived" value="false" />
                            <input class="form-check-input" type="checkbox" id="revWaived" name="IsNoticeWaived" value="true" />
                            <label class="form-check-label small fw-semibold" for="revWaived">Waive Notice Period Shortfall</label>
                        </div>
                        <div class="form-check form-switch">
                            <input type="hidden" name="IsRehireEligible" value="false" />
                            <input class="form-check-input" type="checkbox" id="revRehire" name="IsRehireEligible" value="true" checked />
                            <label class="form-check-label small fw-semibold" for="revRehire">Eligible for Rehire</label>
                        </div>
                    </div>
                    <div>
                        <label class="form-label small fw-semibold">Review Comments</label>
                        <textarea id="revComments" name="Comments" class="form-control" rows="3" maxlength="600"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="revSubmitBtn">Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/exit.js" asp-append-version="true"></script>
}
