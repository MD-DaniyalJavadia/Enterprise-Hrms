@using System.Text.Json
@model ExitInterviewsPageViewModel
@{
    ViewData["Title"] = "Exit Interviews & Feedback Analytics";
    ViewData["BreadcrumbParent"] = "Separation & Exit";
    var camelOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var total = Model.Interviews.Count;
    var avgOverall = total > 0 ? Model.Interviews.Average(i => i.OverallSatisfactionRating) : 0;
    var recPct = total > 0 ? (int)Math.Round(100.0 * Model.Interviews.Count(i => i.WouldRecommendCompany) / total) : 0;
    var rejoinPct = total > 0 ? (int)Math.Round(100.0 * Model.Interviews.Count(i => i.WouldConsiderRejoining) / total) : 0;
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Separation Cases
        </a>
        @if (Model.SeparationsWithoutInterview.Any() || Model.Interviews.Any())
        {
            <button type="button" class="btn btn-primary btn-sm" onclick="HrmsExit.openExitInterviewModal(null, null)">
                <i class="bi bi-plus-lg me-1"></i>Record Exit Interview
            </button>
        }
    </div>
}

<!-- KPI Cards -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary fw-semibold">Completed Interviews</div>
                <div class="fs-4 fw-bold">@total</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-primary fw-semibold">Avg Satisfaction</div>
                <div class="fs-4 fw-bold text-primary">@avgOverall.ToString("F1") <span class="fs-6 fw-normal text-body-secondary">/ 5</span></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-success fw-semibold">Would Recommend</div>
                <div class="fs-4 fw-bold text-success">@recPct% <span class="fs-6 fw-normal text-body-secondary">(@rejoinPct% rejoin)</span></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-warning fw-semibold">Awaiting Interview</div>
                <div class="fs-4 fw-bold text-warning">@Model.SeparationsWithoutInterview.Count</div>
            </div>
        </div>
    </div>
</div>

@if (Model.SeparationsWithoutInterview.Any())
{
    <div class="alert alert-warning border-0 shadow-sm d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div class="small">
            <i class="bi bi-exclamation-circle me-2"></i>
            <strong>@Model.SeparationsWithoutInterview.Count active separation(s)</strong> do not have an exit interview recorded yet.
        </div>
        <button type="button" class="btn btn-sm btn-warning"
                onclick='HrmsExit.openExitInterviewModal(@Model.SeparationsWithoutInterview.First().SeparationId, null)'>
            Conduct Next Interview
        </button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-exit-datatable w-100">
                <thead>
                    <tr>
                        <th>Employee &amp; Case</th>
                        <th>Interview Date</th>
                        <th class="text-center">Ratings (O / M / W / C)</th>
                        <th>Primary Leaving Reason</th>
                        <th>Sentiment</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var iv in Model.Interviews)
                    {
                        <tr>
                            <td class="small">
                                <a asp-action="Details" asp-route-id="@iv.SeparationId" class="fw-semibold text-decoration-none">@iv.EmployeeName</a>
                                <div class="text-body-secondary">@iv.EmployeeCode &bull; @iv.DepartmentName &bull; <span class="font-monospace">@iv.SeparationNumber</span></div>
                            </td>
                            <td class="small">@iv.InterviewDate.ToString("dd MMM yyyy")</td>
                            <td class="text-center small font-monospace">
                                <span class="badge bg-primary-subtle text-primary-emphasis">@iv.OverallSatisfactionRating</span>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">@iv.ManagerSupportRating</span>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">@iv.WorkLifeBalanceRating</span>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">@iv.CompensationRating</span>
                            </td>
                            <td class="small">
                                <div class="fw-semibold">@iv.PrimaryLeavingReason</div>
                                @if (!string.IsNullOrWhiteSpace(iv.ImprovementSuggestions))
                                {
                                    <div class="text-body-secondary text-truncate" style="max-width: 280px;" title="@iv.ImprovementSuggestions">@iv.ImprovementSuggestions</div>
                                }
                            </td>
                            <td class="small">
                                <div class="d-flex flex-wrap gap-1">
                                    <span class="badge @(iv.WouldRecommendCompany ? "bg-success-subtle text-success-emphasis" : "bg-danger-subtle text-danger-emphasis")">
                                        @(iv.WouldRecommendCompany ? "Recommends" : "No Rec")
                                    </span>
                                    <span class="badge @(iv.WouldConsiderRejoining ? "bg-info-subtle text-info-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                                        @(iv.WouldConsiderRejoining ? "Boomerang OK" : "No Rejoin")
                                    </span>
                                    @if (iv.IsConfidential)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis">Confidential</span>
                                    }
                                </div>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@iv.SeparationId" class="btn btn-sm btn-outline-secondary" title="Open Case">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-primary" title="Edit Interview"
                                        onclick='HrmsExit.openExitInterviewModal(@iv.SeparationId, @Html.Raw(JsonSerializer.Serialize(iv, camelOpts)))'>
                                    <i class="bi bi-pencil"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Record / Edit Exit Interview Modal -->
<div class="modal fade" id="exitInterviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-chat-square-quote me-2 text-primary"></i>Exit Interview Record</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="exitInterviewForm" onsubmit="event.preventDefault(); HrmsExit.submitAjaxForm('#exitInterviewForm', '@Url.Action("SaveExitInterview")', '#exitInterviewModal');">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold">Separation Case <span class="text-danger">*</span></label>
                            <select id="ivSepSelect" name="SeparationId" class="form-select hrms-select2" required>
                                <option value="">Select separation case...</option>
                                @if (Model.SeparationsWithoutInterview.Any())
                                {
                                    <optgroup label="Pending Exit Interview">
                                        @foreach (var sep in Model.SeparationsWithoutInterview)
                                        {
                                            <option value="@sep.SeparationId">@sep.SeparationNumber — @sep.EmployeeName (@sep.DepartmentName)</option>
                                        }
                                    </optgroup>
                                }
                                @if (Model.Interviews.Any())
                                {
                                    <optgroup label="Recorded Interviews">
                                        @foreach (var iv in Model.Interviews)
                                        {
                                            <option value="@iv.SeparationId">@iv.SeparationNumber — @iv.EmployeeName (@iv.DepartmentName)</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Interview Date <span class="text-danger">*</span></label>
                            <input type="date" id="ivDate" name="InterviewDate" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Primary Reason for Leaving <span class="text-danger">*</span></label>
                            <input type="text" id="ivReason" name="PrimaryLeavingReason" class="form-control" maxlength="200" required />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold">Overall (1-5)</label>
                            <input type="number" min="1" max="5" id="ivOverall" name="OverallSatisfactionRating" class="form-control" value="4" required />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold">Manager Support</label>
                            <input type="number" min="1" max="5" id="ivManager" name="ManagerSupportRating" class="form-control" value="4" required />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold">Work-Life Balance</label>
                            <input type="number" min="1" max="5" id="ivWlb" name="WorkLifeBalanceRating" class="form-control" value="4" required />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-semibold">Compensation</label>
                            <input type="number" min="1" max="5" id="ivComp" name="CompensationRating" class="form-control" value="3" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Liked Most</label>
                            <textarea id="ivLiked" name="LikedMost" class="form-control" rows="2" maxlength="500"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Improvement Suggestions</label>
                            <textarea id="ivImprove" name="ImprovementSuggestions" class="form-control" rows="2" maxlength="500"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Interviewer Notes</label>
                            <textarea id="ivNotes" name="InterviewerNotes" class="form-control" rows="2" maxlength="500"></textarea>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input type="hidden" name="WouldRecommendCompany" value="false" />
                                <input class="form-check-input" type="checkbox" id="ivRecommend" name="WouldRecommendCompany" value="true" checked />
                                <label class="form-check-label small fw-semibold" for="ivRecommend">Would Recommend</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input type="hidden" name="WouldConsiderRejoining" value="false" />
                                <input class="form-check-input" type="checkbox" id="ivRejoin" name="WouldConsiderRejoining" value="true" checked />
                                <label class="form-check-label small fw-semibold" for="ivRejoin">Open to Rejoining</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input type="hidden" name="IsConfidential" value="false" />
                                <input class="form-check-input" type="checkbox" id="ivConf" name="IsConfidential" value="true" checked />
                                <label class="form-check-label small fw-semibold" for="ivConf">Confidential (HR Only)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Interview</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/exit.js" asp-append-version="true"></script>
}
