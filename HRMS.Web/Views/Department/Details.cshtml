@model DepartmentFormViewModel
@{
    ViewData["Title"] = "Department Details";
    ViewData["BreadcrumbParent"] = "Departments";
}
<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
        <h2 class="h6 fw-bold mb-0"><i class="bi bi-diagram-2 me-2 text-primary"></i>@Model.DepartmentName (@Model.DepartmentCode)</h2>
        <div class="d-flex gap-2">
            @if (User.HasPermission("ORG.MANAGE"))
            {
                <a asp-action="Edit" asp-route-id="@Model.DepartmentId" class="btn btn-sm btn-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
            }
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to List</a>
        </div>
    </div>
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-body-secondary">Department Code</dt><dd class="col-sm-9">@Model.DepartmentCode</dd>
            <dt class="col-sm-3 text-body-secondary">Cost Center</dt><dd class="col-sm-9">@(Model.CostCenterCode ?? "-")</dd>
            <dt class="col-sm-3 text-body-secondary">Status</dt><dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>
        </dl>
    </div>
</div>
