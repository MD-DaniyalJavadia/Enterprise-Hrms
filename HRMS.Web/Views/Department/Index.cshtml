@model IEnumerable<DepartmentListItemViewModel>
@{
    ViewData["Title"] = "Departments";
    ViewData["BreadcrumbParent"] = "Organization";
    var searchTerm = ViewData["SearchTerm"]?.ToString();
    int? selectedBranchId = ViewData["SelectedBranchId"] as int?;
    var branches = ViewData["Branches"] as List<BranchListItemViewModel> ?? new();
}

@section PageActions {
    <div class="d-flex gap-2">
        <a asp-action="Export" asp-route-branchId="@selectedBranchId" asp-route-search="@searchTerm" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export CSV
        </a>
        @if (User.HasPermission("ORG.MANAGE"))
        {
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>New Department
            </a>
        }
    </div>
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Search</label>
                <input type="text" name="search" value="@searchTerm" class="form-control form-control-sm" placeholder="Department code or name..." />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Branch</label>
                <select name="branchId" class="form-select form-select-sm hrms-select2">
                    <option value="">All Branches</option>
                    @foreach (var b in branches)
                    {
                        <option value="@b.BranchId" selected="@(selectedBranchId == b.BranchId)">@b.BranchName</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-datatable w-100">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Department</th>
                        <th>Parent Dept</th>
                        <th>Branch</th>
                        <th>Cost Center</th>
                        <th>Employees</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.DepartmentCode</td>
                            <td class="fw-semibold">@item.DepartmentName</td>
                            <td>@(item.ParentDepartmentName ?? "-")</td>
                            <td>@(item.BranchName ?? "All Branches")</td>
                            <td>@(item.CostCenterCode ?? "-")</td>
                            <td>@item.EmployeeCount</td>
                            <td>
                                <span class="badge @(item.IsActive ? "bg-success-subtle text-success-emphasis" : "bg-danger-subtle text-danger-emphasis")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.DepartmentId" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                @if (User.HasPermission("ORG.MANAGE"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.DepartmentId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="HrmsOrg.confirmDelete('@Url.Action("Delete", new { id = item.DepartmentId })', 'Department')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts { <script src="~/js/organization.js" asp-append-version="true"></script> }
