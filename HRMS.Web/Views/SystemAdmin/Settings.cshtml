@using System.Text.Json
@model SystemSettingsPageViewModel
@{
    ViewData["Title"] = "System Configuration & Policies";
    ViewData["BreadcrumbParent"] = "Administration";
    var camelOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var categories = new[] { "General", "Security", "AttendanceLeave", "Payroll", "Workflow", "Notifications" };
}

@section PageActions {
    @if (Model.CanManageAdmin)
    {
        <button type="button" class="btn btn-primary btn-sm" onclick="HrmsAdmin.openSettingModal()">
            <i class="bi bi-sliders me-1"></i>Add Configuration Key
        </button>
    }
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Settings" class="btn btn-sm @(string.IsNullOrEmpty(Model.Category) ? "btn-primary" : "btn-outline-secondary")">All Categories</a>
            @foreach (var cat in categories)
            {
                <a asp-action="Settings" asp-route-category="@cat"
                   class="btn btn-sm @(Model.Category == cat ? "btn-primary" : "btn-outline-secondary")">@cat</a>
            }
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-admin-datatable w-100">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Setting Key</th>
                        <th>Value</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th>Updated</th>
                        @if (Model.CanManageAdmin)
                        {
                            <th class="text-end">Action</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Settings)
                    {
                        <tr>
                            <td><span class="badge bg-primary-subtle text-primary-emphasis">@s.Category</span></td>
                            <td class="small font-monospace fw-semibold">@s.SettingKey</td>
                            <td class="small fw-semibold">
                                @if (s.IsSensitive)
                                {
                                    <span class="text-body-secondary">••••••••</span>
                                }
                                else
                                {
                                    @s.SettingValue
                                }
                            </td>
                            <td class="small text-body-secondary">@s.DataType</td>
                            <td class="small text-body-secondary">@s.Description</td>
                            <td class="small text-body-secondary">@(s.ModifiedDate?.ToString("dd MMM yyyy HH:mm") ?? "Default")</td>
                            @if (Model.CanManageAdmin)
                            {
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            onclick='HrmsAdmin.openSettingModal(@Html.Raw(JsonSerializer.Serialize(s, camelOpts)))'>
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.CanManageAdmin)
{
    <div class="modal fade" id="systemSettingModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="stModalTitle">System Setting</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="systemSettingForm" onsubmit="event.preventDefault(); HrmsAdmin.submitAjaxForm('#systemSettingForm', '@Url.Action("SaveSetting")', '#systemSettingModal');">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Setting Key <span class="text-danger">*</span></label>
                            <input type="text" id="stKey" name="SettingKey" class="form-control font-monospace" maxlength="80" required />
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-semibold">Category</label>
                                <select id="stCategory" name="Category" class="form-select">
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat">@cat</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold">Data Type</label>
                                <select id="stDataType" name="DataType" class="form-select">
                                    <option value="Text">Text</option>
                                    <option value="Number">Number</option>
                                    <option value="Boolean">Boolean</option>
                                    <option value="Json">Json</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Value <span class="text-danger">*</span></label>
                            <input type="text" id="stValue" name="SettingValue" class="form-control" maxlength="500" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Description</label>
                            <textarea id="stDesc" name="Description" class="form-control" rows="2" maxlength="250"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Setting</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/system-admin.js" asp-append-version="true"></script>
}
