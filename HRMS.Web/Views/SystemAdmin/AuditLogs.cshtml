@model AuditLogsPageViewModel
@{
    ViewData["Title"] = "Audit Trail & Security Logs";
    ViewData["BreadcrumbParent"] = "Administration";
    var failedLogins = Model.LoginHistory.Count(x => !x.IsSuccess);
}

@section PageActions {
    <div class="d-flex gap-2">
        @if (Model.CanManageAdmin)
        {
            <a asp-action="ExportAuditLogs"
               asp-route-moduleName="@Model.ModuleName"
               asp-route-actionType="@Model.ActionType"
               asp-route-username="@Model.Username"
               asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
               asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
               asp-route-search="@Model.Search"
               class="btn btn-success btn-sm">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export Audit CSV
            </a>
        }
    </div>
}

<!-- Summary Cards -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary fw-semibold">Audit Events Found</div>
                <div class="fs-4 fw-bold text-primary">@Model.AuditLogs.Count</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-info fw-semibold">Sign-In Attempts</div>
                <div class="fs-4 fw-bold text-info">@Model.LoginHistory.Count</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-danger fw-semibold">Failed Sign-Ins</div>
                <div class="fs-4 fw-bold text-danger">@failedLogins</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-success fw-semibold">Successful Logins</div>
                <div class="fs-4 fw-bold text-success">@(Model.LoginHistory.Count - failedLogins)</div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Module</label>
                <select name="moduleName" class="form-select form-select-sm">
                    <option value="">All Modules</option>
                    @foreach (var m in new[] { "Authentication", "Organization", "Employees", "Attendance", "Leave", "Payroll", "Recruitment", "Loans", "Expenses", "Performance", "Training", "Assets", "Documents", "Separation", "Reports", "Workflows", "Notifications", "Administration" })
                    {
                        <option value="@m" selected="@(Model.ModuleName == m)">@m</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Action</label>
                <select name="actionType" class="form-select form-select-sm">
                    <option value="">All Actions</option>
                    @foreach (var a in new[] { "Login", "FailedLogin", "Logout", "PasswordChanged", "Create", "Update", "Delete", "Approve", "Reject", "Export" })
                    {
                        <option value="@a" selected="@(Model.ActionType == a)">@a</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Username</label>
                <input type="text" name="username" value="@Model.Username" class="form-control form-control-sm" placeholder="Username..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">From Date</label>
                <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">To Date</label>
                <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-funnel me-1"></i>Search</button>
                <a asp-action="AuditLogs" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabAuditTrail" type="button" role="tab">
            <i class="bi bi-journal-check me-1"></i>Enterprise Audit Trail (@Model.AuditLogs.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabLoginHistory" type="button" role="tab">
            <i class="bi bi-shield-exclamation me-1"></i>Login &amp; Security Attempts (@Model.LoginHistory.Count)
        </button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tabAuditTrail" role="tabpanel">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle hrms-admin-datatable w-100">
                        <thead>
                            <tr>
                                <th>Timestamp (UTC)</th>
                                <th>User</th>
                                <th>Action</th>
                                <th>Module / Entity</th>
                                <th>Description</th>
                                <th>IP Address</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.AuditLogs)
                            {
                                var actBadge = log.ActionType switch
                                {
                                    "Delete" or "Reject" or "FailedLogin" => "bg-danger-subtle text-danger-emphasis",
                                    "Create" or "Approve" or "Login" => "bg-success-subtle text-success-emphasis",
                                    "Export" => "bg-info-subtle text-info-emphasis",
                                    _ => "bg-secondary-subtle text-secondary-emphasis"
                                };
                                <tr>
                                    <td class="small font-monospace text-nowrap">@log.CreatedDate.ToString("dd MMM yyyy HH:mm:ss")</td>
                                    <td class="small fw-semibold">@(log.Username ?? "System")</td>
                                    <td><span class="badge @actBadge">@log.ActionType</span></td>
                                    <td class="small">
                                        <div>@log.ModuleName</div>
                                        <div class="text-body-secondary font-monospace">@log.EntityName @(string.IsNullOrEmpty(log.EntityId) ? "" : $"#{log.EntityId}")</div>
                                    </td>
                                    <td class="small">@log.Description</td>
                                    <td class="small font-monospace text-body-secondary">@(log.IpAddress ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="tabLoginHistory" role="tabpanel">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle hrms-admin-datatable w-100">
                        <thead>
                            <tr>
                                <th>Attempted (UTC)</th>
                                <th>Identifier</th>
                                <th>Outcome</th>
                                <th>Reason / Notes</th>
                                <th>IP Address</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lh in Model.LoginHistory)
                            {
                                <tr>
                                    <td class="small font-monospace text-nowrap">@lh.AttemptedAtUtc.ToString("dd MMM yyyy HH:mm:ss")</td>
                                    <td class="small fw-semibold">@lh.UsernameOrEmail</td>
                                    <td>
                                        <span class="badge @(lh.IsSuccess ? "bg-success-subtle text-success-emphasis" : "bg-danger-subtle text-danger-emphasis")">
                                            @(lh.IsSuccess ? "Success" : "Failed")
                                        </span>
                                    </td>
                                    <td class="small text-body-secondary">@(lh.FailureReason ?? "Authenticated")</td>
                                    <td class="small font-monospace text-body-secondary">@(lh.IpAddress ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/system-admin.js" asp-append-version="true"></script>
}
