@using System.Text.Json
@model List<HRMS.Models.Entities.LoanType>
@{
    ViewData["Title"] = "Loan & Advance Policies";
    ViewData["BreadcrumbParent"] = "Loans & Advances";
    var camelOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Loans &amp; Advances
        </a>
        <button type="button" class="btn btn-primary btn-sm" onclick="HrmsLoanExp.openLoanTypeModal()">
            <i class="bi bi-plus-lg me-1"></i>New Loan Policy
        </button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-le-datatable w-100">
                <thead>
                    <tr>
                        <th>Code &amp; Policy Name</th>
                        <th>Category</th>
                        <th class="text-end">Max Amount</th>
                        <th class="text-end">Interest % p.a.</th>
                        <th class="text-center">Max Tenure</th>
                        <th>Guarantor</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@t.TypeName</div>
                                <div class="small text-body-secondary">
                                    <span class="badge bg-light text-dark border me-1">@t.TypeCode</span>@t.Description
                                </div>
                            </td>
                            <td><span class="badge bg-info-subtle text-info-emphasis">@t.Category</span></td>
                            <td class="text-end fw-medium">@t.MaxAmount.ToString("C0")</td>
                            <td class="text-end">@t.DefaultInterestRate.ToString("0.00")%</td>
                            <td class="text-center">@t.MaxTenureMonths mos</td>
                            <td>@(t.RequiresGuarantor ? "Required" : "Optional")</td>
                            <td>
                                <span class="badge @(t.IsActive ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                                    @(t.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-primary" title="Edit Policy"
                                        onclick='HrmsLoanExp.openLoanTypeModal(@Html.Raw(JsonSerializer.Serialize(t, camelOpts)))'>
                                    <i class="bi bi-pencil"></i>
                                </button>
                                @if (t.LoansCount == 0)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Delete Policy"
                                            onclick='HrmsLoanExp.deleteLoanType(@t.LoanTypeId, @Html.Raw(JsonSerializer.Serialize(t.TypeName)))'>
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="loanTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ltModalTitle">Add Loan / Advance Policy</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="loanTypeForm" onsubmit="event.preventDefault(); HrmsLoanExp.submitAjaxForm('#loanTypeForm', '@Url.Action("SaveLoanType")', '#loanTypeModal');">
                @Html.AntiForgeryToken()
                <input type="hidden" id="ltId" name="LoanTypeId" value="0" />
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Code <span class="text-danger">*</span></label>
                            <input type="text" id="ltCode" name="TypeCode" class="form-control" maxlength="20" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold">Policy Name <span class="text-danger">*</span></label>
                            <input type="text" id="ltName" name="TypeName" class="form-control" maxlength="100" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Category</label>
                            <select id="ltCategory" name="Category" class="form-select" required>
                                <option value="Loan">Loan</option>
                                <option value="SalaryAdvance">Salary Advance</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Max Amount</label>
                            <input type="number" step="0.01" min="1" id="ltMaxAmt" name="MaxAmount" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Default Interest (% p.a.)</label>
                            <input type="number" step="0.01" min="0" max="100" id="ltRate" name="DefaultInterestRate" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Max Tenure (Months)</label>
                            <input type="number" min="1" max="120" id="ltTenure" name="MaxTenureMonths" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Description</label>
                            <textarea id="ltDesc" name="Description" class="form-control" rows="2" maxlength="400"></textarea>
                        </div>
                        <div class="col-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="ltGuarantor" name="RequiresGuarantor" value="true" />
                                <input type="hidden" name="RequiresGuarantor" value="false" />
                                <label class="form-check-label small" for="ltGuarantor">Requires Guarantor</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="ltActive" name="IsActive" value="true" checked />
                                <input type="hidden" name="IsActive" value="false" />
                                <label class="form-check-label small" for="ltActive">Policy Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Policy</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/loan-expense.js" asp-append-version="true"></script>
}
