@using System.Text.Json
@model LoanDetailsPageViewModel
@{
    ViewData["Title"] = $"Loan {Model.Loan.LoanNumber}";
    ViewData["BreadcrumbParent"] = "Loans & Advances";
    var canManage = User.HasPermission("LOAN.MANAGE");
    var pctPaid = Model.Loan.TotalPayableAmount > 0
        ? Math.Min(100, Math.Round((Model.Loan.PaidAmount / Model.Loan.TotalPayableAmount) * 100, 1))
        : 0;
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Loans
        </a>
        @if (canManage && Model.Loan.LoanStatus == "Pending")
        {
            <button type="button" class="btn btn-success btn-sm"
                    onclick='HrmsLoanExp.openReviewLoanModal(@Model.Loan.LoanId, @Html.Raw(JsonSerializer.Serialize($"{Model.Loan.LoanNumber} - {Model.Loan.EmployeeName}")), @Html.Raw(JsonSerializer.Serialize(Model.Loan.RepaymentStartDate.ToString("yyyy-MM-dd"))))'>
                <i class="bi bi-check2-circle me-1"></i>Approve &amp; Disburse
            </button>
        }
    </div>
}

<!-- Loan Summary Card -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-center">
            <div class="col-md-4">
                <div class="small text-body-secondary">Employee &amp; Policy</div>
                <h5 class="fw-bold mb-1">@Model.Loan.EmployeeName <span class="badge bg-light text-dark border ms-1">@Model.Loan.EmployeeCode</span></h5>
                <div class="small text-body-secondary">@Model.Loan.DepartmentName &bull; @Model.Loan.LoanTypeName (@Model.Loan.LoanCategory)</div>
                @if (!string.IsNullOrWhiteSpace(Model.Loan.Purpose))
                {
                    <div class="small mt-2 text-body-secondary"><strong>Purpose:</strong> @Model.Loan.Purpose</div>
                }
            </div>
            <div class="col-md-5">
                <div class="row g-2 small">
                    <div class="col-6">
                        <span class="text-body-secondary">Principal:</span>
                        <div class="fw-semibold">@Model.Loan.PrincipalAmount.ToString("C2")</div>
                    </div>
                    <div class="col-6">
                        <span class="text-body-secondary">Total Payable (@Model.Loan.InterestRatePercent.ToString("0.00")%):</span>
                        <div class="fw-semibold">@Model.Loan.TotalPayableAmount.ToString("C2")</div>
                    </div>
                    <div class="col-6">
                        <span class="text-body-secondary">Monthly EMI (@Model.Loan.TenureMonths mos):</span>
                        <div class="fw-semibold text-primary">@Model.Loan.MonthlyInstallment.ToString("C2")</div>
                    </div>
                    <div class="col-6">
                        <span class="text-body-secondary">Remaining Balance:</span>
                        <div class="fw-bold text-danger">@Model.Loan.RemainingBalance.ToString("C2")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="d-flex justify-content-between small mb-1">
                    <span>Repayment Progress</span>
                    <span class="fw-semibold">@pctPaid%</span>
                </div>
                <div class="progress mb-2" style="height: 8px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @pctPaid%"></div>
                </div>
                <div class="small text-body-secondary">
                    Status: <span class="badge bg-primary-subtle text-primary-emphasis">@Model.Loan.LoanStatus</span>
                    @if (Model.Loan.DisbursedDate.HasValue)
                    {
                        <span class="ms-1">&bull; Disbursed @Model.Loan.DisbursedDate.Value.ToString("dd MMM yyyy")</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Repayment Schedule Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent py-3">
        <h6 class="fw-bold mb-0"><i class="bi bi-calendar2-check me-2 text-primary"></i>EMI Repayment Ledger</h6>
    </div>
    <div class="card-body">
        @if (!Model.Schedule.Any())
        {
            <div class="text-center py-4 text-body-secondary">
                Repayment schedule will be generated once this loan application is approved and disbursed.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>EMI #</th>
                            <th>Due Date</th>
                            <th class="text-end">Principal</th>
                            <th class="text-end">Interest</th>
                            <th class="text-end">Installment</th>
                            <th class="text-end">Paid</th>
                            <th>Status</th>
                            <th>Paid Date / Reference</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inst in Model.Schedule)
                        {
                            var sBadge = inst.PaymentStatus switch
                            {
                                "Paid" => "bg-success-subtle text-success-emphasis",
                                "Skipped" => "bg-secondary-subtle text-secondary-emphasis",
                                _ => "bg-warning-subtle text-warning-emphasis"
                            };
                            <tr>
                                <td class="fw-semibold">#@inst.InstallmentNumber</td>
                                <td>@inst.DueDate.ToString("dd MMM yyyy")</td>
                                <td class="text-end">@inst.PrincipalComponent.ToString("N2")</td>
                                <td class="text-end">@inst.InterestComponent.ToString("N2")</td>
                                <td class="text-end fw-semibold">@inst.InstallmentAmount.ToString("N2")</td>
                                <td class="text-end text-success">@inst.PaidAmount.ToString("N2")</td>
                                <td><span class="badge @sBadge">@inst.PaymentStatus</span></td>
                                <td class="small">
                                    @(inst.PaidDate?.ToString("dd MMM yyyy") ?? "-")
                                    @if (!string.IsNullOrWhiteSpace(inst.PaymentReference))
                                    {
                                        <span class="text-body-secondary">(@inst.PaymentReference)</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (canManage && Model.Loan.LoanStatus == "Active" && inst.PaymentStatus == "Pending")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success"
                                                onclick="HrmsLoanExp.openRepaymentModal(@inst.ScheduleId, @inst.InstallmentNumber, @inst.InstallmentAmount)">
                                            <i class="bi bi-cash-coin me-1"></i>Record Payment
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (canManage)
{
    <!-- Review Loan Modal (when Pending) -->
    <div class="modal fade" id="reviewLoanModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-check2-circle me-2 text-success"></i>Review &amp; Disburse Loan</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="reviewLoanForm" onsubmit="event.preventDefault(); HrmsLoanExp.submitAjaxForm('#reviewLoanForm', '@Url.Action("ReviewLoan")', '#reviewLoanModal');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="revLoanId" name="LoanId" value="@Model.Loan.LoanId" />
                    <div class="modal-body">
                        <div class="mb-3 fw-semibold" id="revLoanLabel"></div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Decision</label>
                            <select id="revLoanStatus" name="ActionStatus" class="form-select" required>
                                <option value="Active">Approve &amp; Disburse (Generate EMI Schedule)</option>
                                <option value="Rejected">Reject Application</option>
                                <option value="Cancelled">Cancel Application</option>
                            </select>
                        </div>
                        <div id="revLoanScheduleFields" class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Disbursement Date</label>
                                <input type="date" name="DisbursedDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">First EMI Due Date</label>
                                <input type="date" id="revLoanStart" name="RepaymentStartDate" class="form-control" />
                            </div>
                        </div>
                        <div>
                            <label class="form-label small fw-semibold">Reviewer Remarks</label>
                            <textarea id="revLoanComments" name="ReviewerComments" class="form-control" rows="2" maxlength="400"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Confirm Decision</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Record EMI Repayment Modal -->
    <div class="modal fade" id="repaymentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-cash-coin me-2 text-success"></i>Record EMI Repayment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="repaymentForm" onsubmit="event.preventDefault(); HrmsLoanExp.submitAjaxForm('#repaymentForm', '@Url.Action("RecordRepayment")', '#repaymentModal');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="repScheduleId" name="ScheduleId" value="0" />
                    <div class="modal-body">
                        <div class="alert alert-info small mb-3" id="repInstLabel"></div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Payment Date <span class="text-danger">*</span></label>
                            <input type="date" name="PaidDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div>
                            <label class="form-label small fw-semibold">Payment / Payroll Reference</label>
                            <input type="text" id="repRef" name="PaymentReference" class="form-control" maxlength="80" placeholder="e.g., PAY-2026-11 or TXN-48201" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Record Payment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/loan-expense.js" asp-append-version="true"></script>
}
