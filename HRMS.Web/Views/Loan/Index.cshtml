@using System.Text.Json
@model LoansIndexPageViewModel
@{
    ViewData["Title"] = "Loans & Salary Advances";
    ViewData["BreadcrumbParent"] = "Loans & Expenses";
    var canManage = User.HasPermission("LOAN.MANAGE");
    var currentEmployeeId = User.GetEmployeeId();
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ExportLoans" asp-route-employeeId="@Model.EmployeeId" asp-route-status="@Model.Status" asp-route-search="@Model.SearchTerm"
           class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-download me-1"></i>Export CSV
        </a>
        @if (canManage)
        {
            <a asp-action="Types" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-sliders me-1"></i>Loan Policies
            </a>
        }
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#applyLoanModal">
            <i class="bi bi-plus-lg me-1"></i>Apply Loan / Advance
        </button>
    </div>
}

<!-- KPI Summary Strip -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-primary fw-semibold">Active Loans</div>
                <div class="fs-4 fw-bold text-primary">@Model.Kpi.ActiveLoansCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-warning fw-semibold">Pending Approval</div>
                <div class="fs-4 fw-bold text-warning">@Model.Kpi.PendingApprovalCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-info fw-semibold">Total Disbursed</div>
                <div class="fs-5 fw-bold text-info">@Model.Kpi.TotalDisbursedAmount.ToString("C0")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-6 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-danger fw-semibold">Outstanding Balance</div>
                <div class="fs-5 fw-bold text-danger">@Model.Kpi.TotalOutstandingBalance.ToString("C0")</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-success fw-semibold">Monthly EMI Recovery</div>
                <div class="fs-5 fw-bold text-success">@Model.Kpi.MonthlyRecoveryTotal.ToString("C0")</div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Strip -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            @if (canManage)
            {
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Employee</label>
                    <select name="employeeId" class="form-select form-select-sm hrms-select2">
                        <option value="">All Employees</option>
                        @foreach (var emp in Model.Employees)
                        {
                            <option value="@emp.EmployeeId" selected="@(Model.EmployeeId == emp.EmployeeId)">@emp.FullName (@emp.EmployeeCode)</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var st in new[] { "Pending", "Active", "Closed", "Rejected", "Cancelled" })
                    {
                        <option value="@st" selected="@(string.Equals(Model.Status, st, StringComparison.OrdinalIgnoreCase))">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Search</label>
                <input type="text" name="search" class="form-control form-control-sm" value="@Model.SearchTerm" placeholder="Loan #, employee name..." />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Loans Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-le-datatable w-100">
                <thead>
                    <tr>
                        <th>Loan # &amp; Policy</th>
                        <th>Employee</th>
                        <th class="text-end">Principal</th>
                        <th class="text-end">Monthly EMI</th>
                        <th class="text-end">Paid / Remaining</th>
                        <th>Start Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in Model.Loans)
                    {
                        var badge = loan.LoanStatus switch
                        {
                            "Active" => "bg-primary-subtle text-primary-emphasis",
                            "Closed" => "bg-success-subtle text-success-emphasis",
                            "Rejected" or "Cancelled" => "bg-danger-subtle text-danger-emphasis",
                            _ => "bg-warning-subtle text-warning-emphasis"
                        };
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@loan.LoanId" class="fw-semibold text-decoration-none">@loan.LoanNumber</a>
                                <div class="small text-body-secondary">@loan.LoanTypeName (@loan.LoanCategory)</div>
                            </td>
                            <td>
                                <div class="fw-medium">@loan.EmployeeName</div>
                                <div class="small text-body-secondary">@loan.EmployeeCode &bull; @loan.DepartmentName</div>
                            </td>
                            <td class="text-end">
                                <div class="fw-medium">@loan.PrincipalAmount.ToString("N2")</div>
                                <div class="small text-body-secondary">@loan.TenureMonths mos @@ @loan.InterestRatePercent.ToString("0.00")%</div>
                            </td>
                            <td class="text-end fw-semibold">@loan.MonthlyInstallment.ToString("N2")</td>
                            <td class="text-end small">
                                <div class="text-success fw-medium">Paid: @loan.PaidAmount.ToString("N2")</div>
                                <div class="text-danger">Bal: @loan.RemainingBalance.ToString("N2")</div>
                            </td>
                            <td class="small">@loan.RepaymentStartDate.ToString("dd MMM yyyy")</td>
                            <td><span class="badge @badge">@loan.LoanStatus</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@loan.LoanId" class="btn btn-sm btn-outline-primary" title="View EMI Schedule">
                                    <i class="bi bi-calendar3 me-1"></i>Schedule
                                </a>
                                @if (canManage && loan.LoanStatus == "Pending")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success" title="Review / Disburse"
                                            onclick='HrmsLoanExp.openReviewLoanModal(@loan.LoanId, @Html.Raw(JsonSerializer.Serialize($"{loan.LoanNumber} - {loan.EmployeeName}")), @Html.Raw(JsonSerializer.Serialize(loan.RepaymentStartDate.ToString("yyyy-MM-dd"))))'>
                                        <i class="bi bi-check2-circle me-1"></i>Review
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Apply Loan Modal -->
<div class="modal fade" id="applyLoanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-bank me-2 text-primary"></i>New Loan / Salary Advance Application</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="applyLoanForm" onsubmit="event.preventDefault(); HrmsLoanExp.submitAjaxForm('#applyLoanForm', '@Url.Action("SubmitLoan")', '#applyLoanModal');">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Employee <span class="text-danger">*</span></label>
                            @if (canManage)
                            {
                                <select name="EmployeeId" class="form-select" required>
                                    <option value="">Select Employee</option>
                                    @foreach (var emp in Model.Employees)
                                    {
                                        <option value="@emp.EmployeeId" selected="@(currentEmployeeId == emp.EmployeeId)">@emp.FullName (@emp.EmployeeCode)</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <select name="EmployeeId" class="form-select" required>
                                    @foreach (var emp in Model.Employees)
                                    {
                                        <option value="@emp.EmployeeId" selected>@emp.FullName (@emp.EmployeeCode)</option>
                                    }
                                </select>
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Loan / Advance Policy <span class="text-danger">*</span></label>
                            <select id="loanTypeSelect" name="LoanTypeId" class="form-select" required>
                                <option value="">Select Policy</option>
                                @foreach (var lt in Model.LoanTypes)
                                {
                                    <option value="@lt.LoanTypeId" data-max="@lt.MaxAmount" data-rate="@lt.DefaultInterestRate" data-tenure="@lt.MaxTenureMonths">
                                        @lt.TypeName (@lt.Category — Max @lt.MaxAmount.ToString("N0"))
                                    </option>
                                }
                            </select>
                            <div class="form-text small" id="loanPolicyHint"></div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Principal Amount <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" min="1" id="loanPrincipal" name="PrincipalAmount" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Tenure (Months) <span class="text-danger">*</span></label>
                            <input type="number" min="1" max="120" id="loanTenure" name="TenureMonths" class="form-control" value="6" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Repayment Start Date <span class="text-danger">*</span></label>
                            <input type="date" name="RepaymentStartDate" class="form-control" value="@(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).ToString("yyyy-MM-dd"))" required />
                        </div>
                        <div class="col-12">
                            <div class="alert alert-light border small mb-0">
                                Estimated Monthly Installment: <strong class="text-primary" id="loanEmiPreview">-</strong>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Purpose / Justification</label>
                            <textarea name="Purpose" class="form-control" rows="2" maxlength="400"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit Application</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (canManage)
{
    <!-- Review Loan Modal -->
    <div class="modal fade" id="reviewLoanModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-check2-circle me-2 text-success"></i>Review &amp; Disburse Loan</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="reviewLoanForm" onsubmit="event.preventDefault(); HrmsLoanExp.submitAjaxForm('#reviewLoanForm', '@Url.Action("ReviewLoan")', '#reviewLoanModal');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="revLoanId" name="LoanId" value="0" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <div class="small text-body-secondary">Application</div>
                            <div class="fw-semibold" id="revLoanLabel"></div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Decision <span class="text-danger">*</span></label>
                            <select id="revLoanStatus" name="ActionStatus" class="form-select" required>
                                <option value="Active">Approve &amp; Disburse (Generate EMI Schedule)</option>
                                <option value="Rejected">Reject Application</option>
                                <option value="Cancelled">Cancel Application</option>
                            </select>
                        </div>
                        <div id="revLoanScheduleFields" class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Disbursement Date</label>
                                <input type="date" name="DisbursedDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">First EMI Due Date</label>
                                <input type="date" id="revLoanStart" name="RepaymentStartDate" class="form-control" />
                            </div>
                        </div>
                        <div>
                            <label class="form-label small fw-semibold">Reviewer Remarks</label>
                            <textarea id="revLoanComments" name="ReviewerComments" class="form-control" rows="2" maxlength="400"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Confirm Decision</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/loan-expense.js" asp-append-version="true"></script>
}
