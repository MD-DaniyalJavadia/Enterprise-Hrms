@model BranchFormViewModel
@{
    ViewData["Title"] = Model.BranchId == 0 ? "Create Branch" : "Edit Branch";
    ViewData["BreadcrumbParent"] = "Branches";
    var isEdit = Model.BranchId > 0;
}
<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent border-bottom py-3">
        <h2 class="h6 fw-bold mb-0"><i class="bi bi-geo-alt me-2 text-primary"></i>@ViewData["Title"]</h2>
    </div>
    <div class="card-body p-4">
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="BranchId" />
            <input type="hidden" asp-for="CompanyId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="BranchCode" class="form-label small fw-semibold"></label>
                    <input asp-for="BranchCode" class="form-control" placeholder="e.g. BR-LDN" />
                    <span asp-validation-for="BranchCode" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="BranchName" class="form-label small fw-semibold"></label>
                    <input asp-for="BranchName" class="form-control" />
                    <span asp-validation-for="BranchName" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Email" class="form-label small fw-semibold"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Phone" class="form-label small fw-semibold"></label>
                    <input asp-for="Phone" class="form-control" />
                </div>
                <div class="col-md-8">
                    <label asp-for="AddressLine1" class="form-label small fw-semibold"></label>
                    <input asp-for="AddressLine1" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="City" class="form-label small fw-semibold"></label>
                    <input asp-for="City" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Country" class="form-label small fw-semibold"></label>
                    <input asp-for="Country" class="form-control" />
                </div>
                <div class="col-md-4 d-flex align-items-end gap-4">
                    <div class="form-check form-switch mb-2">
                        <input asp-for="IsHeadOffice" class="form-check-input" />
                        <label asp-for="IsHeadOffice" class="form-check-label small fw-semibold"></label>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label small fw-semibold"></label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>@(isEdit ? "Update Branch" : "Save Branch")</button>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
