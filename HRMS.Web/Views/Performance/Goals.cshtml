@using System.Text.Json
@model PerformanceGoalsPageViewModel
@{
    ViewData["Title"] = "Goals & KPIs";
    ViewData["BreadcrumbParent"] = "Performance & Training";
    var canManage = User.HasPermission("PERFORMANCE.MANAGE");
    var currentEmployeeId = User.GetEmployeeId();
    var camelOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-award me-1"></i>Appraisals
        </a>
        @if (canManage)
        {
            <button type="button" class="btn btn-primary btn-sm" onclick="HrmsPerfTrn.openGoalModal()">
                <i class="bi bi-plus-lg me-1"></i>Assign KPI / Goal
            </button>
        }
    </div>
}

<!-- Filter Strip -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Appraisal Cycle</label>
                <select name="cycleId" class="form-select form-select-sm hrms-select2">
                    <option value="">All Cycles</option>
                    @foreach (var c in Model.Cycles)
                    {
                        <option value="@c.CycleId" selected="@(Model.CycleId == c.CycleId)">@c.CycleCode — @c.CycleName</option>
                    }
                </select>
            </div>
            @if (canManage)
            {
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Employee</label>
                    <select name="employeeId" class="form-select form-select-sm hrms-select2">
                        <option value="">All Employees</option>
                        @foreach (var emp in Model.Employees)
                        {
                            <option value="@emp.EmployeeId" selected="@(Model.EmployeeId == emp.EmployeeId)">@emp.FullName (@emp.EmployeeCode)</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var st in new[] { "NotStarted", "InProgress", "Completed", "Deferred" })
                    {
                        <option value="@st" selected="@(string.Equals(Model.Status, st, StringComparison.OrdinalIgnoreCase))">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Goals" class="btn btn-outline-secondary btn-sm" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Goals Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-pt-datatable w-100">
                <thead>
                    <tr>
                        <th>Goal &amp; KPI Metric</th>
                        <th>Employee</th>
                        <th>Cycle</th>
                        <th class="text-center">Weight</th>
                        <th>Target / Achieved</th>
                        <th style="min-width: 140px;">Progress</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in Model.Goals)
                    {
                        var gBadge = g.GoalStatus switch
                        {
                            "Completed" => "bg-success-subtle text-success-emphasis",
                            "InProgress" => "bg-primary-subtle text-primary-emphasis",
                            "Deferred" => "bg-secondary-subtle text-secondary-emphasis",
                            _ => "bg-warning-subtle text-warning-emphasis"
                        };
                        <tr>
                            <td>
                                <div class="fw-semibold">@g.GoalTitle</div>
                                <div class="small text-body-secondary">@(g.KpiMetric ?? "-")</div>
                            </td>
                            <td>
                                <div class="fw-medium">@g.EmployeeName</div>
                                <div class="small text-body-secondary">@g.EmployeeCode &bull; @g.DepartmentName</div>
                            </td>
                            <td class="small">@g.CycleCode</td>
                            <td class="text-center fw-semibold">@g.WeightPercent.ToString("0")%</td>
                            <td class="small">
                                <div>Target: @(g.TargetValue ?? "-")</div>
                                <div class="text-success">Actual: @(g.AchievedValue ?? "-")</div>
                            </td>
                            <td>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>@g.ProgressPercent%</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar @(g.ProgressPercent >= 100 ? "bg-success" : "bg-primary")" style="width: @g.ProgressPercent%"></div>
                                </div>
                            </td>
                            <td><span class="badge @gBadge">@g.GoalStatus</span></td>
                            <td class="text-end text-nowrap">
                                @if (canManage || currentEmployeeId == g.EmployeeId)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success" title="Update Progress"
                                            onclick='HrmsPerfTrn.openGoalProgressModal(@Html.Raw(JsonSerializer.Serialize(g, camelOpts)))'>
                                        <i class="bi bi-sliders2"></i>
                                    </button>
                                }
                                @if (canManage)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary" title="Edit Goal"
                                            onclick='HrmsPerfTrn.openGoalModal(@Html.Raw(JsonSerializer.Serialize(g, camelOpts)))'>
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Delete Goal"
                                            onclick='HrmsPerfTrn.deleteGoal(@g.GoalId, @Html.Raw(JsonSerializer.Serialize(g.GoalTitle)))'>
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Update Progress Modal -->
<div class="modal fade" id="goalProgressModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-sliders2 me-2 text-success"></i>Update Goal Progress</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="goalProgressForm" onsubmit="event.preventDefault(); HrmsPerfTrn.submitAjaxForm('#goalProgressForm', '@Url.Action("UpdateGoalProgress")', '#goalProgressModal');">
                @Html.AntiForgeryToken()
                <input type="hidden" id="gpGoalId" name="GoalId" value="0" />
                <div class="modal-body">
                    <div class="mb-3 fw-semibold" id="gpLabel"></div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Achieved Value / Milestone</label>
                        <input type="text" id="gpAchieved" name="AchievedValue" class="form-control" maxlength="100" />
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Progress (%) <span class="text-danger">*</span></label>
                            <input type="number" id="gpProgress" name="ProgressPercent" class="form-control" min="0" max="100" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Status</label>
                            <select id="gpStatus" name="GoalStatus" class="form-select" required>
                                <option value="NotStarted">Not Started</option>
                                <option value="InProgress">In Progress</option>
                                <option value="Completed">Completed</option>
                                <option value="Deferred">Deferred</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save Progress</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (canManage)
{
    <!-- Assign / Edit Goal Modal -->
    <div class="modal fade" id="goalModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="goalModalTitle">Assign Performance Goal</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="goalForm" onsubmit="event.preventDefault(); HrmsPerfTrn.submitAjaxForm('#goalForm', '@Url.Action("SaveGoal")', '#goalModal');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="goalId" name="GoalId" value="0" />
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Appraisal Cycle <span class="text-danger">*</span></label>
                                <select id="goalCycle" name="CycleId" class="form-select" required>
                                    <option value="">Select Cycle</option>
                                    @foreach (var c in Model.Cycles)
                                    {
                                        <option value="@c.CycleId">@c.CycleCode — @c.CycleName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Employee <span class="text-danger">*</span></label>
                                <select id="goalEmp" name="EmployeeId" class="form-select" required>
                                    <option value="">Select Employee</option>
                                    @foreach (var emp in Model.Employees)
                                    {
                                        <option value="@emp.EmployeeId">@emp.FullName (@emp.EmployeeCode)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small fw-semibold">Goal Title <span class="text-danger">*</span></label>
                                <input type="text" id="goalTitle" name="GoalTitle" class="form-control" maxlength="150" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Weight (%) <span class="text-danger">*</span></label>
                                <input type="number" step="1" min="1" max="100" id="goalWeight" name="WeightPercent" class="form-control" value="25" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">KPI Metric / Measurement Criteria</label>
                                <input type="text" id="goalMetric" name="KpiMetric" class="form-control" maxlength="200" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Target Value</label>
                                <input type="text" id="goalTarget" name="TargetValue" class="form-control" maxlength="100" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Achieved Value</label>
                                <input type="text" id="goalAchieved" name="AchievedValue" class="form-control" maxlength="100" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Progress %</label>
                                <input type="number" min="0" max="100" id="goalProgress" name="ProgressPercent" class="form-control" value="0" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Status</label>
                                <select id="goalStatus" name="GoalStatus" class="form-select" required>
                                    <option value="NotStarted">Not Started</option>
                                    <option value="InProgress">In Progress</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Deferred">Deferred</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Manager Notes</label>
                                <textarea id="goalNotes" name="ManagerNotes" class="form-control" rows="2" maxlength="400"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Goal</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/performance-training.js" asp-append-version="true"></script>
}
