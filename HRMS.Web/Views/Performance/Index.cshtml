@using System.Text.Json
@model PerformanceIndexPageViewModel
@{
    ViewData["Title"] = "Performance Appraisals";
    ViewData["BreadcrumbParent"] = "Performance & Training";
    var canManage = User.HasPermission("PERFORMANCE.MANAGE");
    var currentEmployeeId = User.GetEmployeeId();
    var camelOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var targetCycle = Model.Cycles.FirstOrDefault(c => Model.CycleId.HasValue ? c.CycleId == Model.CycleId.Value : c.CycleStatus == "Active")
                      ?? Model.Cycles.FirstOrDefault();
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ExportAppraisals" asp-route-cycleId="@Model.CycleId" asp-route-employeeId="@Model.EmployeeId" asp-route-status="@Model.Status"
           class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-download me-1"></i>Export CSV
        </a>
        <a asp-action="Goals" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-bullseye me-1"></i>Goals &amp; KPIs
        </a>
        @if (canManage)
        {
            <a asp-action="Cycles" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-calendar-range me-1"></i>Cycles
            </a>
            @if (targetCycle is not null)
            {
                <button type="button" class="btn btn-primary btn-sm"
                        onclick='HrmsPerfTrn.initializeCycle(@targetCycle.CycleId, @Html.Raw(JsonSerializer.Serialize(targetCycle.CycleName)))'>
                    <i class="bi bi-people-fill me-1"></i>Launch / Sync Cycle (@targetCycle.CycleCode)
                </button>
            }
        }
    </div>
}

<!-- KPI Summary Strip -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary fw-semibold">Total Reviews</div>
                <div class="fs-4 fw-bold">@Model.Kpi.TotalAppraisals</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-warning fw-semibold">Pending Self-Review</div>
                <div class="fs-4 fw-bold text-warning">@Model.Kpi.PendingSelfReview</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-info fw-semibold">Pending Manager Review</div>
                <div class="fs-4 fw-bold text-info">@Model.Kpi.PendingManagerReview</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-6 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-success fw-semibold">Completed</div>
                <div class="fs-4 fw-bold text-success">@Model.Kpi.CompletedAppraisals</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-primary fw-semibold">Avg. Final Score</div>
                <div class="fs-4 fw-bold text-primary">@Model.Kpi.AverageFinalRating.ToString("0.00") <span class="fs-6 text-body-secondary">/ 5.0</span></div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Strip -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Appraisal Cycle</label>
                <select name="cycleId" class="form-select form-select-sm hrms-select2">
                    <option value="">All Cycles</option>
                    @foreach (var c in Model.Cycles)
                    {
                        <option value="@c.CycleId" selected="@(Model.CycleId == c.CycleId)">@c.CycleCode — @c.CycleName</option>
                    }
                </select>
            </div>
            @if (canManage)
            {
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Employee</label>
                    <select name="employeeId" class="form-select form-select-sm hrms-select2">
                        <option value="">All Employees</option>
                        @foreach (var emp in Model.Employees)
                        {
                            <option value="@emp.EmployeeId" selected="@(Model.EmployeeId == emp.EmployeeId)">@emp.FullName (@emp.EmployeeCode)</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Review Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var st in new[] { "NotStarted", "SelfSubmitted", "ManagerReviewed", "Completed" })
                    {
                        <option value="@st" selected="@(string.Equals(Model.Status, st, StringComparison.OrdinalIgnoreCase))">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Appraisals Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-pt-datatable w-100">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Cycle</th>
                        <th>Reviewer</th>
                        <th class="text-center">Self</th>
                        <th class="text-center">Manager</th>
                        <th class="text-center">Final / Band</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pa in Model.Appraisals)
                    {
                        var stBadge = pa.AppraisalStatus switch
                        {
                            "Completed" => "bg-success-subtle text-success-emphasis",
                            "ManagerReviewed" => "bg-primary-subtle text-primary-emphasis",
                            "SelfSubmitted" => "bg-info-subtle text-info-emphasis",
                            _ => "bg-warning-subtle text-warning-emphasis"
                        };
                        <tr>
                            <td>
                                <div class="fw-semibold">@pa.EmployeeName</div>
                                <div class="small text-body-secondary">@pa.EmployeeCode &bull; @pa.DepartmentName (@pa.DesignationTitle)</div>
                            </td>
                            <td class="small">
                                <div class="fw-medium">@pa.CycleName</div>
                                <div class="text-body-secondary">@pa.CycleCode</div>
                            </td>
                            <td class="small">@(pa.ReviewerName ?? "Unassigned")</td>
                            <td class="text-center fw-medium">@(pa.SelfRating.HasValue ? pa.SelfRating.Value.ToString("0.00") : "-")</td>
                            <td class="text-center fw-medium">@(pa.ManagerRating.HasValue ? pa.ManagerRating.Value.ToString("0.00") : "-")</td>
                            <td class="text-center">
                                @if (pa.FinalRating.HasValue)
                                {
                                    <div class="fw-bold text-primary">@pa.FinalRating.Value.ToString("0.00")</div>
                                    <span class="badge bg-light text-dark border">@pa.RatingBand</span>
                                }
                                else
                                {
                                    <span class="text-body-secondary small">-</span>
                                }
                            </td>
                            <td>
                                <span class="badge @stBadge">@pa.AppraisalStatus</span>
                                @if (pa.RecommendedIncrementPercent.HasValue)
                                {
                                    <div class="small text-success mt-1">+@pa.RecommendedIncrementPercent.Value.ToString("0.0")% merit</div>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                @if (pa.AppraisalStatus != "Completed" && (canManage || currentEmployeeId == pa.EmployeeId))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-info" title="Submit Self-Appraisal"
                                            onclick='HrmsPerfTrn.openSelfAppraisalModal(@Html.Raw(JsonSerializer.Serialize(pa, camelOpts)))'>
                                        <i class="bi bi-person-check me-1"></i>Self
                                    </button>
                                }
                                @if (canManage)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary" title="Manager Evaluation"
                                            onclick='HrmsPerfTrn.openManagerReviewModal(@Html.Raw(JsonSerializer.Serialize(pa, camelOpts)))'>
                                        <i class="bi bi-clipboard2-check me-1"></i>Evaluate
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Self Appraisal Modal -->
<div class="modal fade" id="selfAppraisalModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-person-check me-2 text-info"></i>Self-Appraisal Submission</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="selfAppraisalForm" onsubmit="event.preventDefault(); HrmsPerfTrn.submitAjaxForm('#selfAppraisalForm', '@Url.Action("SubmitSelfAppraisal")', '#selfAppraisalModal');">
                @Html.AntiForgeryToken()
                <input type="hidden" id="selfAppId" name="AppraisalId" value="0" />
                <div class="modal-body">
                    <div class="mb-3">
                        <div class="small text-body-secondary">Reviewee &amp; Cycle</div>
                        <div class="fw-semibold" id="selfAppLabel"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Self-Rating (1.0 - 5.0) <span class="text-danger">*</span></label>
                        <input type="number" step="0.1" min="1" max="5" id="selfRating" name="SelfRating" class="form-control" required />
                    </div>
                    <div>
                        <label class="form-label small fw-semibold">Key Achievements &amp; Reflections</label>
                        <textarea id="selfComments" name="SelfComments" class="form-control" rows="4" maxlength="1000"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit Self-Review</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (canManage)
{
    <!-- Manager Evaluation Modal -->
    <div class="modal fade" id="managerReviewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-clipboard2-check me-2 text-primary"></i>Manager Evaluation &amp; Calibration</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="managerReviewForm" onsubmit="event.preventDefault(); HrmsPerfTrn.submitAjaxForm('#managerReviewForm', '@Url.Action("SubmitManagerReview")', '#managerReviewModal');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="mgrAppId" name="AppraisalId" value="0" />
                    <div class="modal-body">
                        <div class="mb-3 fw-semibold text-primary" id="mgrAppLabel"></div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Manager Rating (1-5) <span class="text-danger">*</span></label>
                                <input type="number" step="0.1" min="1" max="5" id="mgrRating" name="ManagerRating" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Final Calibrated Rating <span class="text-danger">*</span></label>
                                <input type="number" step="0.1" min="1" max="5" id="mgrFinalRating" name="FinalRating" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Recommended Merit %</label>
                                <input type="number" step="0.5" min="0" max="100" id="mgrIncrement" name="RecommendedIncrementPercent" class="form-control" placeholder="e.g., 6.5" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Key Strengths</label>
                                <textarea id="mgrStrengths" name="Strengths" class="form-control" rows="2" maxlength="600"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Development / Improvement Areas</label>
                                <textarea id="mgrImprovements" name="ImprovementAreas" class="form-control" rows="2" maxlength="600"></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Manager Summary Comments</label>
                                <textarea id="mgrComments" name="ManagerComments" class="form-control" rows="3" maxlength="1000"></textarea>
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="mgrFinalize" name="Finalize" value="true" checked />
                                    <input type="hidden" name="Finalize" value="false" />
                                    <label class="form-check-label small fw-semibold" for="mgrFinalize">Finalize &amp; Complete Appraisal</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Evaluation</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/performance-training.js" asp-append-version="true"></script>
}
