@using System.Text.Json
@model List<HRMS.Models.Entities.AppraisalCycle>
@{
    ViewData["Title"] = "Appraisal Cycles";
    ViewData["BreadcrumbParent"] = "Performance & Training";
    var camelOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Appraisals
        </a>
        <button type="button" class="btn btn-primary btn-sm" onclick="HrmsPerfTrn.openCycleModal()">
            <i class="bi bi-plus-lg me-1"></i>New Appraisal Cycle
        </button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-pt-datatable w-100">
                <thead>
                    <tr>
                        <th>Code &amp; Cycle Name</th>
                        <th class="text-center">Year</th>
                        <th>Review Period</th>
                        <th>Deadlines</th>
                        <th class="text-center">Reviews</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        var badge = c.CycleStatus switch
                        {
                            "Active" => "bg-success-subtle text-success-emphasis",
                            "Closed" => "bg-secondary-subtle text-secondary-emphasis",
                            _ => "bg-warning-subtle text-warning-emphasis"
                        };
                        <tr>
                            <td>
                                <div class="fw-semibold">@c.CycleName</div>
                                <div class="small text-body-secondary">
                                    <span class="badge bg-light text-dark border me-1">@c.CycleCode</span>@c.Description
                                </div>
                            </td>
                            <td class="text-center fw-semibold">@c.ReviewYear</td>
                            <td class="small">@c.StartDate.ToString("dd MMM yyyy") &ndash; @c.EndDate.ToString("dd MMM yyyy")</td>
                            <td class="small">
                                <div>Self: @(c.SelfReviewDeadline?.ToString("dd MMM yyyy") ?? "-")</div>
                                <div class="text-body-secondary">Mgr: @(c.ManagerReviewDeadline?.ToString("dd MMM yyyy") ?? "-")</div>
                            </td>
                            <td class="text-center"><span class="badge bg-info-subtle text-info-emphasis">@c.AppraisalsCount</span></td>
                            <td><span class="badge @badge">@c.CycleStatus</span></td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-success" title="Initialize Employee Reviews"
                                        onclick='HrmsPerfTrn.initializeCycle(@c.CycleId, @Html.Raw(JsonSerializer.Serialize(c.CycleName)))'>
                                    <i class="bi bi-people-fill"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary" title="Edit Cycle"
                                        onclick='HrmsPerfTrn.openCycleModal(@Html.Raw(JsonSerializer.Serialize(c, camelOpts)))'>
                                    <i class="bi bi-pencil"></i>
                                </button>
                                @if (c.AppraisalsCount == 0)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Delete Cycle"
                                            onclick='HrmsPerfTrn.deleteCycle(@c.CycleId, @Html.Raw(JsonSerializer.Serialize(c.CycleName)))'>
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="cycleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cycModalTitle">Create Appraisal Cycle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="cycleForm" onsubmit="event.preventDefault(); HrmsPerfTrn.submitAjaxForm('#cycleForm', '@Url.Action("SaveCycle")', '#cycleModal');">
                @Html.AntiForgeryToken()
                <input type="hidden" id="cycId" name="CycleId" value="0" />
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Cycle Code <span class="text-danger">*</span></label>
                            <input type="text" id="cycCode" name="CycleCode" class="form-control" maxlength="20" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Cycle Name <span class="text-danger">*</span></label>
                            <input type="text" id="cycName" name="CycleName" class="form-control" maxlength="120" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-semibold">Year</label>
                            <input type="number" id="cycYear" name="ReviewYear" class="form-control" min="2020" max="2050" value="@DateTime.Today.Year" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Start Date <span class="text-danger">*</span></label>
                            <input type="date" id="cycStart" name="StartDate" class="form-control" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">End Date <span class="text-danger">*</span></label>
                            <input type="date" id="cycEnd" name="EndDate" class="form-control" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Self-Review Deadline</label>
                            <input type="date" id="cycSelfDue" name="SelfReviewDeadline" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Manager Deadline</label>
                            <input type="date" id="cycMgrDue" name="ManagerReviewDeadline" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Status</label>
                            <select id="cycStatus" name="CycleStatus" class="form-select" required>
                                <option value="Draft">Draft</option>
                                <option value="Active">Active</option>
                                <option value="Closed">Closed</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold">Description</label>
                            <input type="text" id="cycDesc" name="Description" class="form-control" maxlength="400" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Cycle</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/performance-training.js" asp-append-version="true"></script>
}
