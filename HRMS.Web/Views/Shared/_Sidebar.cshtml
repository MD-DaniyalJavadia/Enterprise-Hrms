                    </a>
                    <a asp-controller="Training" asp-action="Enrollments" class="hrms-nav-link hrms-nav-sub @(currentController == "Training" && ptAction == "Enrollments" ? "active" : "")">
                        <i class="bi bi-patch-check"></i><span>Enrollments &amp; Certs</span>
                    </a>
