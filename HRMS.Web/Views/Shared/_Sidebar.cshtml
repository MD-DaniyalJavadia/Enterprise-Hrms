                        <i class="bi bi-folder2-open"></i><span>Policy Repository</span>
                    </a>
                    <a asp-controller="Document" asp-action="EmployeeVault" class="hrms-nav-link hrms-nav-sub @(currentController == "Document" && adAction == "EmployeeVault" ? "active" : "")">
