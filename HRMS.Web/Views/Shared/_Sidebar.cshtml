                    @if (User.HasPermission("DOCUMENT.MANAGE"))
                    {
                        <a asp-controller="Document" asp-action="Categories" class="hrms-nav-link hrms-nav-sub @(currentController == "Document" && adAction == "Categories" ? "active" : "")">
                            <i class="bi bi-bookmarks"></i><span>Doc Categories</span>
