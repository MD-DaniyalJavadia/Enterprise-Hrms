        @if (User.HasPermission("ASSET.VIEW") || User.HasPermission("DOCUMENT.VIEW"))
        {
            var isAssetDocActive = new[] { "Asset", "Document" }.Contains(currentController, StringComparer.OrdinalIgnoreCase);
            var adAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
            <a class="hrms-nav-link @(isAssetDocActive ? "active" : "")" data-bs-toggle="collapse" href="#assetDocMenuCollapse" role="button" aria-expanded="@(isAssetDocActive ? "true" : "false")">
                <i class="bi bi-laptop"></i><span>Assets &amp; Documents</span>
                <i class="bi bi-chevron-down ms-auto small"></i>
            </a>
            <div class="collapse @(isAssetDocActive ? "show" : "")" id="assetDocMenuCollapse">
