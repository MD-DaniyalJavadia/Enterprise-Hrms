        @if (User.HasPermission("EXIT.VIEW"))
        {
            var isExitActive = string.Equals(currentController, "Exit", StringComparison.OrdinalIgnoreCase);
            var exitAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
            <a class="hrms-nav-link @(isExitActive ? "active" : "")" data-bs-toggle="collapse" href="#exitMenuCollapse" role="button" aria-expanded="@(isExitActive ? "true" : "false")">
                <i class="bi bi-box-arrow-right"></i><span>Separation &amp; Exit</span>
                <i class="bi bi-chevron-down ms-auto small"></i>
            </a>
            <div class="collapse @(isExitActive ? "show" : "")" id="exitMenuCollapse">
                <a asp-controller="Exit" asp-action="Index" class="hrms-nav-link hrms-nav-sub @(isExitActive && (exitAction == "Index" || exitAction == "Details") ? "active" : "")">
                    <i class="bi bi-person-dash"></i><span>Separation Requests</span>
                </a>
                @if (User.HasPermission("EXIT.MANAGE"))
                {
                    <a asp-controller="Exit" asp-action="Interviews" class="hrms-nav-link hrms-nav-sub @(isExitActive && exitAction == "Interviews" ? "active" : "")">
                        <i class="bi bi-chat-square-quote"></i><span>Exit Interviews</span>
                    </a>
                    <a asp-controller="Exit" asp-action="Templates" class="hrms-nav-link hrms-nav-sub @(isExitActive && exitAction == "Templates" ? "active" : "")">
                        <i class="bi bi-list-check"></i><span>Clearance Templates</span>
                    </a>
                }
            </div>
        }
        @if (User.HasPermission("REPORTS.VIEW"))
        {
            var isRepActive = string.Equals(currentController, "Reports", StringComparison.OrdinalIgnoreCase);
            var repAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
            <a class="hrms-nav-link @(isRepActive ? "active" : "")" data-bs-toggle="collapse" href="#reportsMenuCollapse" role="button" aria-expanded="@(isRepActive ? "true" : "false")">
                <i class="bi bi-bar-chart-line"></i><span>Reports &amp; Analytics</span>
                <i class="bi bi-chevron-down ms-auto small"></i>
            </a>
            <div class="collapse @(isRepActive ? "show" : "")" id="reportsMenuCollapse">
                <a asp-controller="Reports" asp-action="Index" class="hrms-nav-link hrms-nav-sub @(isRepActive && repAction == "Index" ? "active" : "")">
                    <i class="bi bi-pie-chart"></i><span>Analytics Hub</span>
                </a>
                <a asp-controller="Reports" asp-action="Workforce" class="hrms-nav-link hrms-nav-sub @(isRepActive && repAction == "Workforce" ? "active" : "")">
                    <i class="bi bi-people"></i><span>Workforce Report</span>
                </a>
                <a asp-controller="Reports" asp-action="AttendanceLeave" class="hrms-nav-link hrms-nav-sub @(isRepActive && repAction == "AttendanceLeave" ? "active" : "")">
                    <i class="bi bi-clock-history"></i><span>Attendance &amp; Leave</span>
                </a>
                <a asp-controller="Reports" asp-action="PayrollCost" class="hrms-nav-link hrms-nav-sub @(isRepActive && repAction == "PayrollCost" ? "active" : "")">
                    <i class="bi bi-cash-stack"></i><span>Payroll Cost Report</span>
                </a>
                <a asp-controller="Reports" asp-action="TalentRecruitment" class="hrms-nav-link hrms-nav-sub @(isRepActive && repAction == "TalentRecruitment" ? "active" : "")">
                    <i class="bi bi-award"></i><span>Talent &amp; Recruitment</span>
                </a>
                <a asp-controller="Reports" asp-action="FinancialCompliance" class="hrms-nav-link hrms-nav-sub @(isRepActive && repAction == "FinancialCompliance" ? "active" : "")">
                    <i class="bi bi-shield-check"></i><span>Financial &amp; Compliance</span>
                </a>
            </div>
        }
        <a asp-controller="Notifications" asp-action="Index" class="hrms-nav-link @IsActive("Notifications")">
            <i class="bi bi-bell"></i><span>Notification Center</span>
        </a>
        @if (User.HasPermission("WORKFLOW.VIEW") || User.HasPermission("ADMIN.VIEW"))
        {
            var isAdminActive = new[] { "Workflow", "SystemAdmin" }.Contains(currentController, StringComparer.OrdinalIgnoreCase);
            var sysAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
            <a class="hrms-nav-link @(isAdminActive ? "active" : "")" data-bs-toggle="collapse" href="#adminMenuCollapse" role="button" aria-expanded="@(isAdminActive ? "true" : "false")">
                <i class="bi bi-shield-lock"></i><span>Workflows &amp; Admin</span>
                <i class="bi bi-chevron-down ms-auto small"></i>
            </a>
            <div class="collapse @(isAdminActive ? "show" : "")" id="adminMenuCollapse">
                @if (User.HasPermission("WORKFLOW.VIEW"))
                {
                    <a asp-controller="Workflow" asp-action="Index" class="hrms-nav-link hrms-nav-sub @(currentController == "Workflow" ? "active" : "")">
                        <i class="bi bi-diagram-3"></i><span>Workflow Engine</span>
                    </a>
                }
                @if (User.HasPermission("ADMIN.VIEW"))
                {
                    <a asp-controller="SystemAdmin" asp-action="AuditLogs" class="hrms-nav-link hrms-nav-sub @(currentController == "SystemAdmin" && sysAction == "AuditLogs" ? "active" : "")">
                        <i class="bi bi-journal-check"></i><span>Audit &amp; Security Logs</span>
                    </a>
                    <a asp-controller="SystemAdmin" asp-action="Settings" class="hrms-nav-link hrms-nav-sub @(currentController == "SystemAdmin" && sysAction == "Settings" ? "active" : "")">
                        <i class="bi bi-sliders"></i><span>System Settings</span>
                    </a>
                    <a asp-controller="SystemAdmin" asp-action="AccessControl" class="hrms-nav-link hrms-nav-sub @(currentController == "SystemAdmin" && sysAction == "AccessControl" ? "active" : "")">
                        <i class="bi bi-person-gear"></i><span>Users &amp; Roles</span>
                    </a>
                    <a asp-controller="SystemAdmin" asp-action="SystemHealth" class="hrms-nav-link hrms-nav-sub @(currentController == "SystemAdmin" && sysAction == "SystemHealth" ? "active" : "")">
                        <i class="bi bi-heart-pulse"></i><span>System Health &amp; Ops</span>
                    </a>
                }
            </div>
        }
    </nav>
</aside>
