@using System.Text.Json
@model CandidatesPageViewModel
@{
    ViewData["Title"] = "Candidate Pool";
    ViewData["BreadcrumbParent"] = "Recruitment";
    var canManage = User.HasPermission("RECRUITMENT.MANAGE");
    var camelOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ExportCandidates" asp-route-source="@Model.Source" asp-route-search="@Model.SearchTerm"
           class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-download me-1"></i>Export CSV
        </a>
        <a asp-action="Pipeline" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-kanban me-1"></i>Applicant Pipeline
        </a>
        @if (canManage)
        {
            <button type="button" class="btn btn-primary btn-sm" onclick="HrmsRec.openCandidateModal()">
                <i class="bi bi-person-plus me-1"></i>Add Candidate
            </button>
        }
    </div>
}

<!-- Filter Strip -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Sourcing Channel</label>
                <select name="source" class="form-select form-select-sm">
                    <option value="">All Sources</option>
                    @foreach (var src in new[] { "CareerPortal", "LinkedIn", "Referral", "Agency", "JobBoard", "WalkIn" })
                    {
                        <option value="@src" selected="@(string.Equals(Model.Source, src, StringComparison.OrdinalIgnoreCase))">@src</option>
                    }
                </select>
            </div>
            <div class="col-md-7">
                <label class="form-label small fw-semibold">Search Talent Pool</label>
                <input type="text" name="search" class="form-control form-control-sm" value="@Model.SearchTerm" placeholder="Name, email, skills, current company..." />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Candidates" class="btn btn-outline-secondary btn-sm" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Candidates Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-rec-datatable w-100">
                <thead>
                    <tr>
                        <th>Candidate</th>
                        <th>Current Role</th>
                        <th>Experience &amp; Expected</th>
                        <th>Skills</th>
                        <th>Source</th>
                        <th class="text-center">Applications</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Candidates)
                    {
                        var hasSafeLinkedIn = Uri.TryCreate(c.LinkedInUrl, UriKind.Absolute, out var liUri)
                            && (liUri.Scheme == Uri.UriSchemeHttp || liUri.Scheme == Uri.UriSchemeHttps);
                        <tr>
                            <td>
                                <div class="fw-semibold">
                                    @c.FullName
                                    @if (hasSafeLinkedIn && liUri is not null)
                                    {
                                        <a href="@liUri.AbsoluteUri" target="_blank" rel="noopener noreferrer" class="ms-1 text-primary" title="LinkedIn Profile">
                                            <i class="bi bi-linkedin"></i>
                                        </a>
                                    }
                                </div>
                                <div class="small text-body-secondary">@c.Email @(!string.IsNullOrWhiteSpace(c.Phone) ? $"• {c.Phone}" : "")</div>
                            </td>
                            <td class="small">
                                <div class="fw-medium">@(c.CurrentJobTitle ?? "-")</div>
                                <div class="text-body-secondary">@(c.CurrentCompany ?? "-")</div>
                            </td>
                            <td class="small">
                                <div>@c.TotalExperienceYears.ToString("0.0") yrs</div>
                                <div class="text-body-secondary">@(c.ExpectedSalary.HasValue ? c.ExpectedSalary.Value.ToString("C0") : "-")</div>
                            </td>
                            <td class="small">
                                <div class="text-truncate" style="max-width: 220px;" title="@c.Skills">@(c.Skills ?? "-")</div>
                            </td>
                            <td><span class="badge bg-secondary-subtle text-secondary-emphasis">@c.Source</span></td>
                            <td class="text-center">
                                <span class="badge bg-info-subtle text-info-emphasis">@c.ApplicationsCount</span>
                            </td>
                            <td class="text-end text-nowrap">
                                @if (!string.IsNullOrWhiteSpace(c.ResumeStoredName))
                                {
                                    <a asp-action="DownloadResume" asp-route-id="@c.CandidateId" class="btn btn-sm btn-outline-secondary" title="Download Resume">
                                        <i class="bi bi-file-earmark-arrow-down"></i>
                                    </a>
                                }
                                @if (canManage)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary" title="Edit Candidate"
                                            onclick='HrmsRec.openCandidateModal(@Html.Raw(JsonSerializer.Serialize(c, camelOpts)))'>
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    @if (c.ApplicationsCount == 0)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Delete Candidate"
                                                onclick='HrmsRec.deleteCandidate(@c.CandidateId, @Html.Raw(JsonSerializer.Serialize(c.FullName)))'>
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (canManage)
{
    <div class="modal fade" id="candidateModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="candModalTitle">Add Candidate</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="candidateForm" enctype="multipart/form-data"
                      onsubmit="event.preventDefault(); HrmsRec.submitMultipartForm('#candidateForm', '@Url.Action("SaveCandidate")', '#candidateModal');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="candId" name="CandidateId" value="0" />
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">First Name <span class="text-danger">*</span></label>
                                <input type="text" id="candFirst" name="FirstName" class="form-control" maxlength="80" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Last Name <span class="text-danger">*</span></label>
                                <input type="text" id="candLast" name="LastName" class="form-control" maxlength="80" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Email <span class="text-danger">*</span></label>
                                <input type="email" id="candEmail" name="Email" class="form-control" maxlength="120" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Phone</label>
                                <input type="text" id="candPhone" name="Phone" class="form-control" maxlength="30" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Current Job Title</label>
                                <input type="text" id="candTitle" name="CurrentJobTitle" class="form-control" maxlength="120" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Current Company</label>
                                <input type="text" id="candCompany" name="CurrentCompany" class="form-control" maxlength="150" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Experience (Years)</label>
                                <input type="number" step="0.5" min="0" max="60" id="candExp" name="TotalExperienceYears" class="form-control" value="0" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Expected Annual Salary</label>
                                <input type="number" step="0.01" min="0" id="candSalary" name="ExpectedSalary" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Source</label>
                                <select id="candSource" name="Source" class="form-select" required>
                                    <option value="CareerPortal">Career Portal</option>
                                    <option value="LinkedIn">LinkedIn</option>
                                    <option value="Referral">Referral</option>
                                    <option value="Agency">Agency</option>
                                    <option value="JobBoard">Job Board</option>
                                    <option value="WalkIn">Walk-In</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">LinkedIn URL</label>
                                <input type="url" id="candLinkedIn" name="LinkedInUrl" class="form-control" maxlength="250" placeholder="https://linkedin.com/in/..." />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Resume (PDF / DOC / DOCX, max 5 MB)</label>
                                <input type="file" id="candResume" name="resumeFile" class="form-control" accept=".pdf,.doc,.docx" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Skills</label>
                                <input type="text" id="candSkills" name="Skills" class="form-control" maxlength="500" placeholder="e.g., C#, SQL Server, React, Project Management" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Recruiter Notes</label>
                                <textarea id="candNotes" name="Notes" class="form-control" rows="2" maxlength="500"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Candidate</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/recruitment.js" asp-append-version="true"></script>
}
