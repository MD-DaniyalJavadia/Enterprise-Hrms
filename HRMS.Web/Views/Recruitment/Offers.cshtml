@using System.Text.Json
@model OffersPageViewModel
@{
    ViewData["Title"] = "Job Offers & Onboarding";
    ViewData["BreadcrumbParent"] = "Recruitment";
    var canManage = User.HasPermission("RECRUITMENT.MANAGE");
    var camelOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Pipeline" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-kanban me-1"></i>Applicant Pipeline
        </a>
        @if (canManage)
        {
            <button type="button" class="btn btn-primary btn-sm" onclick="HrmsRec.openOfferModal()">
                <i class="bi bi-file-earmark-plus me-1"></i>Create Job Offer
            </button>
        }
    </div>
}

<!-- Filter Strip -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Offer Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var st in new[] { "Draft", "Sent", "Accepted", "Declined", "Expired", "Converted" })
                    {
                        <option value="@st" selected="@(string.Equals(Model.OfferStatus, st, StringComparison.OrdinalIgnoreCase))">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Offers" class="btn btn-outline-secondary btn-sm" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Offers Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-rec-datatable w-100">
                <thead>
                    <tr>
                        <th>Offer &amp; Candidate</th>
                        <th>Role &amp; Department</th>
                        <th class="text-end">Annual Salary</th>
                        <th>Joining / Expiry</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Offers)
                    {
                        var oBadge = o.OfferStatus switch
                        {
                            "Converted" => "bg-primary-subtle text-primary-emphasis",
                            "Accepted" => "bg-success-subtle text-success-emphasis",
                            "Sent" => "bg-info-subtle text-info-emphasis",
                            "Declined" or "Expired" => "bg-danger-subtle text-danger-emphasis",
                            _ => "bg-warning-subtle text-warning-emphasis"
                        };
                        <tr>
                            <td>
                                <div class="fw-semibold">@o.CandidateName</div>
                                <div class="small text-body-secondary">
                                    <span class="badge bg-light text-dark border me-1">@o.OfferCode</span>@o.CandidateEmail
                                </div>
                            </td>
                            <td>
                                <div class="fw-medium">@o.JobTitle</div>
                                <div class="small text-body-secondary">@o.RequisitionCode &bull; @o.DepartmentName (@o.BranchName)</div>
                            </td>
                            <td class="text-end">
                                <div class="fw-bold">@o.OfferedSalaryAnnual.ToString("C0")</div>
                                <div class="small text-body-secondary">@o.EmploymentType</div>
                            </td>
                            <td class="small">
                                <div>Join: <span class="fw-medium">@o.JoiningDate.ToString("dd MMM yyyy")</span></div>
                                <div class="text-body-secondary">Expires: @o.OfferExpiryDate.ToString("dd MMM yyyy")</div>
                            </td>
                            <td>
                                <span class="badge @oBadge">@o.OfferStatus</span>
                                @if (!string.IsNullOrWhiteSpace(o.ResponseNotes))
                                {
                                    <div class="small text-body-secondary text-truncate" style="max-width: 180px;" title="@o.ResponseNotes">@o.ResponseNotes</div>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                @if (o.HiredEmployeeId.HasValue)
                                {
                                    <a asp-controller="Employee" asp-action="Details" asp-route-id="@o.HiredEmployeeId.Value" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-person-badge me-1"></i>Employee Profile
                                    </a>
                                }
                                @if (canManage)
                                {
                                    @if (o.OfferStatus is "Draft" or "Sent")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary" title="Edit Offer"
                                                onclick='HrmsRec.openOfferModal(@Html.Raw(JsonSerializer.Serialize(o, camelOpts)))'>
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    }
                                    @if (o.OfferStatus == "Draft")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-info" title="Mark as Sent"
                                                onclick='HrmsRec.updateOfferStatus(@o.OfferId, "Sent", @Html.Raw(JsonSerializer.Serialize(o.CandidateName)))'>
                                            <i class="bi bi-send me-1"></i>Send
                                        </button>
                                    }
                                    @if (o.OfferStatus == "Sent")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success" title="Mark Accepted"
                                                onclick='HrmsRec.updateOfferStatus(@o.OfferId, "Accepted", @Html.Raw(JsonSerializer.Serialize(o.CandidateName)))'>
                                            <i class="bi bi-check-lg me-1"></i>Accept
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Mark Declined"
                                                onclick='HrmsRec.updateOfferStatus(@o.OfferId, "Declined", @Html.Raw(JsonSerializer.Serialize(o.CandidateName)))'>
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                    @if (o.OfferStatus == "Accepted" && !o.HiredEmployeeId.HasValue)
                                    {
                                        <button type="button" class="btn btn-sm btn-success" title="Convert to Employee Master"
                                                onclick='HrmsRec.convertToEmployee(@o.OfferId, @Html.Raw(JsonSerializer.Serialize(o.CandidateName)))'>
                                            <i class="bi bi-person-check me-1"></i>Onboard to Employee
                                        </button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (canManage)
{
    <div class="modal fade" id="offerModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ofrModalTitle">Create Job Offer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="offerForm" onsubmit="event.preventDefault(); HrmsRec.submitAjaxForm('#offerForm', '@Url.Action("SaveOffer")', '#offerModal');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="ofrId" name="OfferId" value="0" />
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Eligible Applicant <span class="text-danger">*</span></label>
                                <select id="ofrAppId" name="ApplicationId" class="form-select" required>
                                    <option value="">Select Applicant (Interview / Assessment / Offer Stage)</option>
                                    @foreach (var app in Model.EligibleApplications)
                                    {
                                        <option value="@app.ApplicationId">@app.CandidateName — @app.RequisitionCode (@app.JobTitle) [@app.PipelineStage]</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Offered Annual Salary <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" min="1" id="ofrSalary" name="OfferedSalaryAnnual" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Employment Type <span class="text-danger">*</span></label>
                                <select id="ofrEmpType" name="EmploymentType" class="form-select" required>
                                    <option value="Full-Time">Full-Time</option>
                                    <option value="Part-Time">Part-Time</option>
                                    <option value="Contract">Contract</option>
                                    <option value="Intern">Intern</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Proposed Joining Date <span class="text-danger">*</span></label>
                                <input type="date" id="ofrJoinDate" name="JoiningDate" class="form-control" value="@DateTime.Today.AddDays(21).ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Offer Expiry Date <span class="text-danger">*</span></label>
                                <input type="date" id="ofrExpiryDate" name="OfferExpiryDate" class="form-control" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Benefits &amp; Perks Summary</label>
                                <textarea id="ofrBenefits" name="BenefitsSummary" class="form-control" rows="3" maxlength="500" placeholder="e.g., Health insurance, annual performance bonus, remote work stipend..."></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Offer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/recruitment.js" asp-append-version="true"></script>
}
