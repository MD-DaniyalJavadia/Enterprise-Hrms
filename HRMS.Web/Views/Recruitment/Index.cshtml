@using System.Text.Json
@model RequisitionsPageViewModel
@{
    ViewData["Title"] = "Job Requisitions";
    ViewData["BreadcrumbParent"] = "Recruitment";
    var canManage = User.HasPermission("RECRUITMENT.MANAGE");
    var camelOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ExportRequisitions" asp-route-departmentId="@Model.DepartmentId" asp-route-status="@Model.Status" asp-route-search="@Model.SearchTerm"
           class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-download me-1"></i>Export CSV
        </a>
        <a asp-action="Pipeline" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-kanban me-1"></i>Applicant Pipeline
        </a>
        @if (canManage)
        {
            <button type="button" class="btn btn-primary btn-sm" onclick="HrmsRec.openRequisitionModal()">
                <i class="bi bi-plus-lg me-1"></i>New Requisition
            </button>
        }
    </div>
}

<!-- KPI Summary Strip -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-primary fw-semibold">Open Requisitions</div>
                <div class="fs-4 fw-bold text-primary">@Model.Kpi.OpenRequisitions</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-info fw-semibold">Open Positions</div>
                <div class="fs-4 fw-bold text-info">@Model.Kpi.TotalOpenPositions</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary fw-semibold">Active Applicants</div>
                <div class="fs-4 fw-bold">@Model.Kpi.ActiveApplicants</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-6 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-warning fw-semibold">Scheduled Interviews</div>
                <div class="fs-4 fw-bold text-warning">@Model.Kpi.ScheduledInterviews</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-success fw-semibold">Active Offers</div>
                <div class="fs-4 fw-bold text-success">@Model.Kpi.ActiveOffers</div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Strip -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Department</label>
                <select name="departmentId" class="form-select form-select-sm hrms-select2">
                    <option value="">All Departments</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept.DepartmentId" selected="@(Model.DepartmentId == dept.DepartmentId)">@dept.DepartmentName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var st in new[] { "Draft", "PendingApproval", "Open", "OnHold", "Filled", "Closed" })
                    {
                        <option value="@st" selected="@(string.Equals(Model.Status, st, StringComparison.OrdinalIgnoreCase))">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Search</label>
                <input type="text" name="search" class="form-control form-control-sm" value="@Model.SearchTerm" placeholder="Code, job title, skills..." />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Requisitions Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-rec-datatable w-100">
                <thead>
                    <tr>
                        <th>Code &amp; Job Title</th>
                        <th>Department / Branch</th>
                        <th>Type &amp; Mode</th>
                        <th class="text-center">Openings</th>
                        <th class="text-center">Pipeline</th>
                        <th>Target Hire</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var req in Model.Requisitions)
                    {
                        var badge = req.RequisitionStatus switch
                        {
                            "Open" => "bg-success-subtle text-success-emphasis",
                            "PendingApproval" => "bg-warning-subtle text-warning-emphasis",
                            "OnHold" => "bg-secondary-subtle text-secondary-emphasis",
                            "Filled" => "bg-primary-subtle text-primary-emphasis",
                            "Closed" => "bg-danger-subtle text-danger-emphasis",
                            _ => "bg-light text-dark border"
                        };
                        <tr>
                            <td>
                                <div class="fw-semibold">
                                    <a asp-action="Pipeline" asp-route-requisitionId="@req.RequisitionId" class="text-decoration-none">@req.JobTitle</a>
                                </div>
                                <div class="small text-body-secondary">
                                    <span class="badge bg-light text-dark border me-1">@req.RequisitionCode</span>
                                    @req.DesignationTitle
                                    @if (req.MinSalary.HasValue || req.MaxSalary.HasValue)
                                    {
                                        <span class="ms-1">&bull; @(req.MinSalary?.ToString("N0") ?? "0") - @(req.MaxSalary?.ToString("N0") ?? "Negotiable")</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="fw-medium">@req.DepartmentName</div>
                                <div class="small text-body-secondary">@req.BranchName</div>
                            </td>
                            <td class="small">
                                <div>@req.EmploymentType</div>
                                <div class="text-body-secondary">@req.WorkMode &bull; @req.ExperienceMinYears+ yrs</div>
                            </td>
                            <td class="text-center">
                                <span class="fw-semibold">@req.HiredCount / @req.OpeningsCount</span>
                            </td>
                            <td class="text-center">
                                <a asp-action="Pipeline" asp-route-requisitionId="@req.RequisitionId" class="badge bg-info-subtle text-info-emphasis text-decoration-none">
                                    @req.ApplicantsCount Applicants
                                </a>
                            </td>
                            <td class="small">@(req.TargetHireDate?.ToString("dd MMM yyyy") ?? "-")</td>
                            <td><span class="badge @badge">@req.RequisitionStatus</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Pipeline" asp-route-requisitionId="@req.RequisitionId" class="btn btn-sm btn-outline-info" title="View Pipeline">
                                    <i class="bi bi-kanban"></i>
                                </a>
                                @if (canManage)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary" title="Edit Requisition"
                                            onclick='HrmsRec.openRequisitionModal(@Html.Raw(JsonSerializer.Serialize(req, camelOpts)))'>
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    @if (req.RequisitionStatus != "Open")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success" title="Publish / Open"
                                                onclick='HrmsRec.updateRequisitionStatus(@req.RequisitionId, "Open", @Html.Raw(JsonSerializer.Serialize(req.JobTitle)))'>
                                            <i class="bi bi-check2-circle"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-warning" title="Put On Hold"
                                                onclick='HrmsRec.updateRequisitionStatus(@req.RequisitionId, "OnHold", @Html.Raw(JsonSerializer.Serialize(req.JobTitle)))'>
                                            <i class="bi bi-pause-circle"></i>
                                        </button>
                                    }
                                    @if (req.ApplicantsCount == 0)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Delete Requisition"
                                                onclick='HrmsRec.deleteRequisition(@req.RequisitionId, @Html.Raw(JsonSerializer.Serialize(req.JobTitle)))'>
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (canManage)
{
    <div class="modal fade" id="requisitionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="reqModalTitle">Create Job Requisition</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="requisitionForm" onsubmit="event.preventDefault(); HrmsRec.submitAjaxForm('#requisitionForm', '@Url.Action("SaveRequisition")', '#requisitionModal');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="reqId" name="RequisitionId" value="0" />
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Requisition Code</label>
                                <input type="text" id="reqCode" name="RequisitionCode" class="form-control" maxlength="30" placeholder="Auto-generated if blank" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small fw-semibold">Job Title <span class="text-danger">*</span></label>
                                <input type="text" id="reqTitle" name="JobTitle" class="form-control" maxlength="150" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Branch <span class="text-danger">*</span></label>
                                <select id="reqBranch" name="BranchId" class="form-select" required>
                                    <option value="">Select Branch</option>
                                    @foreach (var b in Model.Branches)
                                    {
                                        <option value="@b.BranchId">@b.BranchName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Department <span class="text-danger">*</span></label>
                                <select id="reqDept" name="DepartmentId" class="form-select" required>
                                    <option value="">Select Department</option>
                                    @foreach (var d in Model.Departments)
                                    {
                                        <option value="@d.DepartmentId">@d.DepartmentName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Designation <span class="text-danger">*</span></label>
                                <select id="reqDesig" name="DesignationId" class="form-select" required>
                                    <option value="">Select Designation</option>
                                    @foreach (var des in Model.Designations)
                                    {
                                        <option value="@des.DesignationId">@des.DesignationTitle</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Budgeted Position (Optional)</label>
                                <select id="reqPos" name="JobPositionId" class="form-select">
                                    <option value="">-- None --</option>
                                    @foreach (var pos in Model.Positions)
                                    {
                                        <option value="@pos.JobPositionId">@pos.PositionTitle (@pos.PositionCode)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Hiring Manager</label>
                                <select id="reqMgr" name="HiringManagerId" class="form-select">
                                    <option value="">-- Unassigned --</option>
                                    @foreach (var emp in Model.Employees)
                                    {
                                        <option value="@emp.EmployeeId">@emp.FullName (@emp.EmployeeCode)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Employment Type</label>
                                <select id="reqEmpType" name="EmploymentType" class="form-select" required>
                                    <option value="Full-Time">Full-Time</option>
                                    <option value="Part-Time">Part-Time</option>
                                    <option value="Contract">Contract</option>
                                    <option value="Intern">Intern</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Work Mode</label>
                                <select id="reqWorkMode" name="WorkMode" class="form-select" required>
                                    <option value="On-Site">On-Site</option>
                                    <option value="Hybrid">Hybrid</option>
                                    <option value="Remote">Remote</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Openings</label>
                                <input type="number" id="reqOpenings" name="OpeningsCount" class="form-control" min="1" max="500" value="1" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Status</label>
                                <select id="reqStatus" name="RequisitionStatus" class="form-select" required>
                                    <option value="Draft">Draft</option>
                                    <option value="PendingApproval">Pending Approval</option>
                                    <option value="Open">Open</option>
                                    <option value="OnHold">On Hold</option>
                                    <option value="Filled">Filled</option>
                                    <option value="Closed">Closed</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Min Annual Salary</label>
                                <input type="number" step="0.01" min="0" id="reqMinSal" name="MinSalary" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Max Annual Salary</label>
                                <input type="number" step="0.01" min="0" id="reqMaxSal" name="MaxSalary" class="form-control" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Min Exp (Yrs)</label>
                                <input type="number" min="0" max="60" id="reqExpMin" name="ExperienceMinYears" class="form-control" value="0" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Max Exp (Yrs)</label>
                                <input type="number" min="0" max="60" id="reqExpMax" name="ExperienceMaxYears" class="form-control" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Target Hire Date</label>
                                <input type="date" id="reqTargetDate" name="TargetHireDate" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Required Skills</label>
                                <input type="text" id="reqSkills" name="RequiredSkills" class="form-control" maxlength="500" placeholder="e.g., C#, ASP.NET Core, SQL Server, Azure" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Job Summary</label>
                                <textarea id="reqSummary" name="JobSummary" class="form-control" rows="3" maxlength="1000"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Requisition</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/recruitment.js" asp-append-version="true"></script>
}
