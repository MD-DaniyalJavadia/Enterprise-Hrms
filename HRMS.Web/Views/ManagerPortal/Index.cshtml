@model ManagerDashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Team Command Center";
    ViewData["BreadcrumbParent"] = "Manager Portal";
    var jsonOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var k = Model.Kpis;
    var deptChartJson = JsonSerializer.Serialize(Model.DepartmentStats, jsonOpts);
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Team" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-people me-1"></i>Team Roster (@k.TeamHeadcount)
        </a>
        <a asp-action="Approvals" class="btn btn-primary btn-sm">
            <i class="bi bi-check2-all me-1"></i>Pending Approvals (@k.TotalPendingApprovals)
        </a>
    </div>
}

<!-- Scope Banner -->
@if (Model.IsCompanyWideView)
{
    <div class="alert alert-info py-2 small mb-4">
        <i class="bi bi-shield-check me-1"></i>Showing <strong>Company-Wide Management View</strong> (Administrator access). Line managers see only their direct and indirect reporting hierarchy.
    </div>
}

<!-- KPI Strip -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="small text-body-secondary">Team Headcount</div>
                <div class="fs-3 fw-bold">@k.TeamHeadcount</div>
                <div class="small text-success mt-1">Present Today: @k.PresentTodayCount &bull; Late: @k.LateTodayCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="small text-body-secondary">On Leave / Absent Today</div>
                <div class="fs-3 fw-bold text-info">@k.OnLeaveTodayCount <span class="fs-6 text-danger fw-normal">/ @k.AbsentTodayCount absent</span></div>
                <div class="small text-body-secondary mt-1">Upcoming 14d Leaves: @Model.UpcomingLeaves.Count</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="small text-body-secondary">Pending Approvals Queue</div>
                <div class="fs-3 fw-bold text-warning">@k.TotalPendingApprovals</div>
                <div class="small text-body-secondary mt-1">Leave: @k.PendingLeaveCount &bull; Att/OT: @(k.PendingRegularizationCount + k.PendingOvertimeCount) &bull; Fin: @(k.PendingLoanCount + k.PendingExpenseCount)</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="small text-body-secondary">Pending Appraisal Reviews</div>
                <div class="fs-3 fw-bold text-primary">@k.PendingAppraisalReviewCount</div>
                <div class="small text-body-secondary mt-1">Profile Requests: @k.PendingProfileRequestCount</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Pending Approvals Table -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">Priority Pending Approvals</h6>
                <a asp-action="Approvals" class="small text-decoration-none">Open Full Queue</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Employee</th>
                                <th>Category</th>
                                <th>Summary</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.PendingApprovals.Any())
                            {
                                <tr><td colspan="4" class="text-center text-body-secondary py-4">All team requests are up to date.</td></tr>
                            }
                            @foreach (var item in Model.PendingApprovals.Take(8))
                            {
                                var jsonItem = JsonSerializer.Serialize(item, jsonOpts);
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@item.EmployeeName</div>
                                        <div class="text-body-secondary">@item.EmployeeCode &bull; @item.DepartmentName</div>
                                    </td>
                                    <td><span class="badge bg-primary-subtle text-primary-emphasis">@item.Category</span></td>
                                    <td>
                                        <div class="fw-medium">@item.Title</div>
                                        <div class="text-body-secondary">@item.Summary</div>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <button type="button" class="btn btn-sm btn-success py-0" onclick='HrmsPortal.openManagerDecisionModal(@Html.Raw(jsonItem), "Approved")'>Approve</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger py-0" onclick='HrmsPortal.openManagerDecisionModal(@Html.Raw(jsonItem), "Rejected")'>Reject</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Team Department Breakdown Chart -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent">
                <h6 class="fw-bold mb-0">Team Attendance by Department</h6>
            </div>
            <div class="card-body d-flex flex-column justify-content-center">
                @if (!Model.DepartmentStats.Any())
                {
                    <div class="text-center text-body-secondary small py-4">No direct or indirect team members assigned yet.</div>
                }
                else
                {
                    <canvas id="mgrDeptChart" style="max-height:260px;"></canvas>
                }
            </div>
        </div>
    </div>

    <!-- Today's Team Attendance Snapshot -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">Team Today Attendance</h6>
                <a asp-action="Team" class="small text-decoration-none">View Roster</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Employee</th>
                                <th>Shift</th>
                                <th>Check In</th>
                                <th>Check Out</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.TeamToday.Any())
                            {
                                <tr><td colspan="5" class="text-center text-body-secondary py-3">No team members found.</td></tr>
                            }
                            @foreach (var m in Model.TeamToday.Take(10))
                            {
                                var badge = m.TodayStatus switch { "Present" => "bg-success", "Late" => "bg-warning text-dark", "OnLeave" => "bg-info text-dark", "Absent" => "bg-danger", _ => "bg-secondary" };
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@m.FullName</div>
                                        <div class="text-body-secondary">@m.DesignationTitle</div>
                                    </td>
                                    <td>@m.ShiftName</td>
                                    <td>@(m.CheckInTime?.ToString("HH:mm") ?? "-")</td>
                                    <td>@(m.CheckOutTime?.ToString("HH:mm") ?? "-")</td>
                                    <td><span class="badge @badge">@m.TodayStatus</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Team Appraisals & Upcoming Leaves -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent"><h6 class="fw-bold mb-0">Pending Team Appraisal Reviews</h6></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0 small">
                        <thead class="table-light">
                            <tr><th>Employee</th><th>Status</th><th>Self</th><th class="text-end">Action</th></tr>
                        </thead>
                        <tbody>
                            @if (!Model.PendingAppraisals.Any())
                            {
                                <tr><td colspan="4" class="text-center text-body-secondary py-3">No pending team appraisals.</td></tr>
                            }
                            @foreach (var pa in Model.PendingAppraisals.Take(5))
                            {
                                var jsonPa = JsonSerializer.Serialize(pa, jsonOpts);
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@pa.EmployeeName</div>
                                        <div class="text-body-secondary">@pa.CycleCode</div>
                                    </td>
                                    <td><span class="badge bg-info-subtle text-info-emphasis">@pa.AppraisalStatus</span></td>
                                    <td>@(pa.SelfRating?.ToString("0.00") ?? "-")</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-primary py-0" onclick='HrmsPortal.openTeamAppraisalReviewModal(@Html.Raw(jsonPa))'>Review</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent"><h6 class="fw-bold mb-0">Upcoming Team Leaves (Next 14 Days)</h6></div>
            <div class="card-body py-2 small">
                @if (!Model.UpcomingLeaves.Any())
                {
                    <div class="text-body-secondary py-2">No upcoming approved leaves for your team.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var lv in Model.UpcomingLeaves.Take(5))
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@lv.FullName</div>
                                    <div class="text-body-secondary">@lv.LeaveName (@lv.TotalDays.ToString("0.#")d)</div>
                                </div>
                                <span class="badge bg-body-secondary text-body-emphasis">@lv.StartDate.ToString("dd MMM") - @lv.EndDate.ToString("dd MMM")</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

<!-- Shared Manager Decision Modal -->
<div class="modal fade" id="mgrDecisionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="mgrDecisionForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Category" id="mgrDecCategory" />
                <input type="hidden" name="RequestId" id="mgrDecRequestId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="mgrDecTitle">Process Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body row g-3">
                    <div class="col-12 small fw-semibold text-primary" id="mgrDecSubtitle"></div>
                    <div class="col-12">
                        <label class="form-label">Decision *</label>
                        <select name="Decision" id="mgrDecDecision" class="form-select" required>
                            <option value="Approved">Approved</option>
                            <option value="Rejected">Rejected</option>
                        </select>
                    </div>
                    <div class="col-12 d-none" id="mgrDecNumericWrap">
                        <label class="form-label" id="mgrDecNumericLabel">Approved Value</label>
                        <input type="number" step="0.01" min="0" name="NumericOverride" id="mgrDecNumeric" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Reviewer Comments</label>
                        <textarea name="ReviewerComments" id="mgrDecComments" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="HrmsPortal.submitAjaxForm('#mgrDecisionForm', '/ManagerPortal/ProcessApproval', '#mgrDecisionModal')">Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Team Appraisal Review Modal -->
<div class="modal fade" id="mgrTeamAppraisalModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="mgrTeamAppraisalForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="AppraisalId" id="mgrRevAppId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Manager Performance Evaluation</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body row g-3">
                    <div class="col-12 small fw-semibold text-primary" id="mgrRevLabel"></div>
                    <div class="col-md-4">
                        <label class="form-label">Manager Rating (1-5) *</label>
                        <input type="number" step="0.1" min="1" max="5" name="ManagerRating" id="mgrRevRating" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Final Rating (1-5) *</label>
                        <input type="number" step="0.1" min="1" max="5" name="FinalRating" id="mgrRevFinal" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Merit Increment %</label>
                        <input type="number" step="0.1" min="0" max="100" name="RecommendedIncrementPercent" id="mgrRevIncrement" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Strengths</label>
                        <textarea name="Strengths" id="mgrRevStrengths" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Areas for Improvement</label>
                        <textarea name="ImprovementAreas" id="mgrRevImprovements" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Manager Comments</label>
                        <textarea name="ManagerComments" id="mgrRevComments" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="mgrRevFinalize" name="Finalize" value="true" checked />
                            <input type="hidden" name="Finalize" value="false" />
                            <label class="form-check-label" for="mgrRevFinalize">Finalize and complete evaluation</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="HrmsPortal.submitAjaxForm('#mgrTeamAppraisalForm', '/ManagerPortal/SubmitTeamAppraisalReview', '#mgrTeamAppraisalModal')">Save Evaluation</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/portal.js" asp-append-version="true"></script>
    <script>
        (function () {
            const data = @Html.Raw(deptChartJson);
            const canvas = document.getElementById('mgrDeptChart');
            if (!canvas || !data || !data.length || typeof Chart === 'undefined') return;
            new Chart(canvas, {
                type: 'bar',
                data: {
                    labels: data.map(d => d.departmentName),
                    datasets: [
                        { label: 'Headcount', data: data.map(d => d.headcount), backgroundColor: 'rgba(37, 99, 235, 0.75)' },
                        { label: 'Present Today', data: data.map(d => d.presentCount), backgroundColor: 'rgba(16, 185, 129, 0.75)' },
                        { label: 'On Leave', data: data.map(d => d.onLeaveCount), backgroundColor: 'rgba(14, 165, 233, 0.75)' }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } },
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });
        })();
    </script>
}
