@using System.Text.Json
@model AssetMaintenancePageViewModel
@{
    ViewData["Title"] = "Asset Maintenance & Repairs";
    ViewData["BreadcrumbParent"] = "Assets & Documents";
    var camelOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

@section PageActions {
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-laptop me-1"></i>Asset Inventory
        </a>
        <button type="button" class="btn btn-primary btn-sm" onclick="HrmsAssetDoc.openMaintenanceModal()">
            <i class="bi bi-plus-lg me-1"></i>Schedule / Log Maintenance
        </button>
    </div>
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-semibold">Asset</label>
                <select name="assetId" class="form-select form-select-sm hrms-select2">
                    <option value="">All Assets</option>
                    @foreach (var a in Model.Assets)
                    {
                        <option value="@a.AssetId" selected="@(Model.AssetId == a.AssetId)">@a.AssetTag — @a.AssetName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var st in new[] { "Scheduled", "InProgress", "Completed", "Cancelled" })
                    {
                        <option value="@st" selected="@(string.Equals(Model.Status, st, StringComparison.OrdinalIgnoreCase))">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Maintenance" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-ad-datatable w-100">
                <thead>
                    <tr>
                        <th>Asset</th>
                        <th>Type</th>
                        <th>Service / Completed</th>
                        <th>Vendor / Tech</th>
                        <th>Description</th>
                        <th class="text-end">Cost</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Logs)
                    {
                        var stBadge = m.MaintenanceStatus switch
                        {
                            "Completed" => "bg-success-subtle text-success-emphasis",
                            "InProgress" => "bg-warning-subtle text-warning-emphasis",
                            "Cancelled" => "bg-secondary-subtle text-secondary-emphasis",
                            _ => "bg-info-subtle text-info-emphasis"
                        };
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@m.AssetId" class="fw-semibold text-decoration-none">@m.AssetName</a>
                                <div class="small text-body-secondary font-monospace">@m.AssetTag</div>
                            </td>
                            <td class="small fw-medium">@m.MaintenanceType</td>
                            <td class="small">
                                <div>@m.ServiceDate.ToString("dd MMM yyyy")</div>
                                @if (m.CompletionDate.HasValue)
                                {
                                    <div class="text-success">Done: @m.CompletionDate.Value.ToString("dd MMM yyyy")</div>
                                }
                            </td>
                            <td class="small">@(m.VendorOrTechnician ?? "-")</td>
                            <td class="small">@m.Description</td>
                            <td class="text-end fw-semibold">@m.Cost.ToString("C2")</td>
                            <td><span class="badge @stBadge">@m.MaintenanceStatus</span></td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        onclick='HrmsAssetDoc.openMaintenanceModal(@Html.Raw(JsonSerializer.Serialize(m, camelOpts)))'>
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        onclick="HrmsAssetDoc.deleteMaintenance(@m.MaintenanceId)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Maintenance Modal -->
<div class="modal fade" id="maintenanceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="mntModalTitle">Schedule / Log Maintenance</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="maintenanceForm" onsubmit="event.preventDefault(); HrmsAssetDoc.submitAjaxForm('#maintenanceForm', '@Url.Action("SaveMaintenance")', '#maintenanceModal');">
                @Html.AntiForgeryToken()
                <input type="hidden" id="mntId" name="MaintenanceId" value="0" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Asset <span class="text-danger">*</span></label>
                        <select id="mntAssetId" name="AssetId" class="form-select" required>
                            <option value="">Select asset...</option>
                            @foreach (var a in Model.Assets)
                            {
                                <option value="@a.AssetId">@a.AssetTag — @a.AssetName</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Type</label>
                            <select id="mntType" name="MaintenanceType" class="form-select">
                                <option value="Repair">Repair</option>
                                <option value="Preventive">Preventive</option>
                                <option value="Upgrade">Upgrade</option>
                                <option value="Calibration">Calibration</option>
                                <option value="Inspection">Inspection</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Status</label>
                            <select id="mntStatus" name="MaintenanceStatus" class="form-select">
                                <option value="Scheduled">Scheduled</option>
                                <option value="InProgress">InProgress</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Service Date <span class="text-danger">*</span></label>
                            <input type="date" id="mntServiceDate" name="ServiceDate" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Completion Date</label>
                            <input type="date" id="mntCompletionDate" name="CompletionDate" class="form-control" />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-7">
                            <label class="form-label small fw-semibold">Vendor / Technician</label>
                            <input type="text" id="mntVendor" name="VendorOrTechnician" class="form-control" maxlength="120" />
                        </div>
                        <div class="col-5">
                            <label class="form-label small fw-semibold">Cost</label>
                            <input type="number" step="0.01" min="0" id="mntCost" name="Cost" class="form-control" value="0" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label small fw-semibold">Description <span class="text-danger">*</span></label>
                        <textarea id="mntDesc" name="Description" class="form-control" rows="3" maxlength="500" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Log</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/asset-document.js" asp-append-version="true"></script>
}
