@using System.Text.Json
@model List<HRMS.Models.Entities.AssetCategory>
@{
    ViewData["Title"] = "Asset Categories";
    ViewData["BreadcrumbParent"] = "Assets & Documents";
    var camelOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

@section PageActions {
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-laptop me-1"></i>Asset Inventory
        </a>
        <button type="button" class="btn btn-primary btn-sm" onclick="HrmsAssetDoc.openAssetCategoryModal()">
            <i class="bi bi-plus-lg me-1"></i>Add Category
        </button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-ad-datatable w-100">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Category Name</th>
                        <th>Asset Class</th>
                        <th>Serial Required</th>
                        <th class="text-center">Depreciation (Mo)</th>
                        <th class="text-center">Assets</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="font-monospace fw-semibold">@c.CategoryCode</td>
                            <td>
                                <div class="fw-semibold">@c.CategoryName</div>
                                @if (!string.IsNullOrWhiteSpace(c.Description))
                                {
                                    <div class="small text-body-secondary">@c.Description</div>
                                }
                            </td>
                            <td><span class="badge bg-info-subtle text-info-emphasis">@c.AssetClass</span></td>
                            <td>@(c.RequiresSerialNumber ? "Yes" : "Optional")</td>
                            <td class="text-center">@(c.DefaultDepreciationMonths?.ToString() ?? "-")</td>
                            <td class="text-center fw-semibold">@c.AssetCount</td>
                            <td>
                                <span class="badge @(c.IsActive ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                                    @(c.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        onclick='HrmsAssetDoc.openAssetCategoryModal(@Html.Raw(JsonSerializer.Serialize(c, camelOpts)))'>
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        onclick='HrmsAssetDoc.deleteAssetCategory(@c.CategoryId, @Html.Raw(JsonSerializer.Serialize(c.CategoryName)))'>
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Asset Category Modal -->
<div class="modal fade" id="assetCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="acatModalTitle">Add Asset Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="assetCategoryForm" onsubmit="event.preventDefault(); HrmsAssetDoc.submitAjaxForm('#assetCategoryForm', '@Url.Action("SaveCategory")', '#assetCategoryModal');">
                @Html.AntiForgeryToken()
                <input type="hidden" id="acatId" name="CategoryId" value="0" />
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label class="form-label small fw-semibold">Code <span class="text-danger">*</span></label>
                            <input type="text" id="acatCode" name="CategoryCode" class="form-control" maxlength="20" required />
                        </div>
                        <div class="col-8">
                            <label class="form-label small fw-semibold">Category Name <span class="text-danger">*</span></label>
                            <input type="text" id="acatName" name="CategoryName" class="form-control" maxlength="100" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Asset Class</label>
                            <select id="acatClass" name="AssetClass" class="form-select">
                                <option value="IT">IT</option>
                                <option value="Mobile">Mobile</option>
                                <option value="AccessCard">AccessCard</option>
                                <option value="Furniture">Furniture</option>
                                <option value="Vehicle">Vehicle</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Depreciation (Months)</label>
                            <input type="number" id="acatDepr" name="DefaultDepreciationMonths" class="form-control" min="1" max="360" />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="acatSerial" name="RequiresSerialNumber" value="true" checked />
                                <input type="hidden" name="RequiresSerialNumber" value="false" />
                                <label class="form-check-label small" for="acatSerial">Requires Serial #</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="acatActive" name="IsActive" value="true" checked />
                                <input type="hidden" name="IsActive" value="false" />
                                <label class="form-check-label small" for="acatActive">Active</label>
                            </div>
                        </div>
                    </div>
                    <div>
                        <label class="form-label small fw-semibold">Description</label>
                        <textarea id="acatDesc" name="Description" class="form-control" rows="2" maxlength="300"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/asset-document.js" asp-append-version="true"></script>
}
