@using System.Text.Json
@model NotificationInboxPageViewModel
@{
    ViewData["Title"] = "Notification Center";
    ViewData["BreadcrumbParent"] = "Administration";
    var camelOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var unreadCount = Model.Notifications.Count(x => !x.IsRead);
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        @if (unreadCount > 0)
        {
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="HrmsAdmin.markAllRead()">
                <i class="bi bi-check2-all me-1"></i>Mark All Read
            </button>
        }
        @if (Model.CanManageNotifications)
        {
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#broadcastNotifModal">
                <i class="bi bi-megaphone me-1"></i>Send Broadcast
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="HrmsAdmin.openTemplateModal()">
                <i class="bi bi-file-earmark-plus me-1"></i>New Template
            </button>
        }
    </div>
}

<!-- KPI Summary -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary fw-semibold">Total Notifications</div>
                <div class="fs-4 fw-bold">@Model.Notifications.Count</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-primary fw-semibold">Unread Alerts</div>
                <div class="fs-4 fw-bold text-primary">@unreadCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-danger fw-semibold">High / Urgent</div>
                <div class="fs-4 fw-bold text-danger">@Model.Notifications.Count(x => x.Priority is "High" or "Urgent")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-success fw-semibold">Active Templates</div>
                <div class="fs-4 fw-bold text-success">@Model.Templates.Count(x => x.IsActive)</div>
            </div>
        </div>
    </div>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabInbox" type="button" role="tab">
            <i class="bi bi-inbox me-1"></i>My Inbox
            @if (unreadCount > 0)
            {
                <span class="badge bg-danger ms-1">@unreadCount</span>
            }
        </button>
    </li>
    @if (Model.CanManageNotifications)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabTemplates" type="button" role="tab">
                <i class="bi bi-ui-checks-grid me-1"></i>Notification Templates (@Model.Templates.Count)
            </button>
        </li>
    }
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tabInbox" role="tabpanel">
        <!-- Filters -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body py-3">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold">Read Status</label>
                        <select name="filterRead" class="form-select form-select-sm">
                            <option value="">All</option>
                            <option value="false" selected="@(Model.FilterRead == false)">Unread Only</option>
                            <option value="true" selected="@(Model.FilterRead == true)">Read Only</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold">Severity</label>
                        <select name="notificationType" class="form-select form-select-sm">
                            <option value="">All Types</option>
                            @foreach (var t in new[] { "Info", "Success", "Warning", "Danger" })
                            {
                                <option value="@t" selected="@(Model.NotificationType == t)">@t</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Module</label>
                        <select name="moduleName" class="form-select form-select-sm">
                            <option value="">All Modules</option>
                            @foreach (var m in new[] { "General", "System", "Workflow", "Leave", "Payroll", "Loan", "Exit", "Security" })
                            {
                                <option value="@m" selected="@(Model.ModuleName == m)">@m</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Search</label>
                        <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Title or message..." />
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-funnel me-1"></i>Filter</button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                @if (!Model.Notifications.Any())
                {
                    <div class="p-5 text-center text-body-secondary">
                        <i class="bi bi-bell-slash fs-2 d-block mb-2"></i>
                        No notifications match your current filter.
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var n in Model.Notifications)
                        {
                            var badgeClass = n.NotificationType switch
                            {
                                "Success" => "bg-success-subtle text-success-emphasis",
                                "Warning" => "bg-warning-subtle text-warning-emphasis",
                                "Danger" => "bg-danger-subtle text-danger-emphasis",
                                _ => "bg-info-subtle text-info-emphasis"
                            };
                            <div class="list-group-item py-3 px-4 @(n.IsRead ? "" : "bg-primary-subtle bg-opacity-10")">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            @if (!n.IsRead)
                                            {
                                                <span class="badge bg-primary rounded-pill">New</span>
                                            }
                                            <span class="badge @badgeClass">@n.NotificationType</span>
                                            <span class="badge bg-secondary-subtle text-secondary-emphasis">@n.ModuleName</span>
                                            @if (n.Priority is "High" or "Urgent")
                                            {
                                                <span class="badge bg-danger">@n.Priority</span>
                                            }
                                            <h6 class="mb-0 fw-semibold">@n.Title</h6>
                                        </div>
                                        <p class="mb-1 small text-body-secondary">@n.Message</p>
                                        <div class="small text-body-secondary">
                                            <i class="bi bi-clock me-1"></i>@n.CreatedDate.ToString("dd MMM yyyy HH:mm") UTC
                                            @if (n.ReadDate.HasValue)
                                            {
                                                <span class="ms-3"><i class="bi bi-check2 me-1"></i>Read @n.ReadDate.Value.ToString("dd MMM HH:mm")</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex gap-1">
                                        @if (!string.IsNullOrWhiteSpace(n.ActionUrl))
                                        {
                                            <a href="@n.ActionUrl" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-box-arrow-up-right"></i> Open
                                            </a>
                                        }
                                        @if (!n.IsRead)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success" onclick="HrmsAdmin.markRead(@n.NotificationId)" title="Mark Read">
                                                <i class="bi bi-check2"></i>
                                            </button>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="HrmsAdmin.deleteEntity('/Notifications/DeleteNotification/@n.NotificationId', 'Delete this notification?')" title="Remove">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @if (Model.CanManageNotifications)
    {
        <div class="tab-pane fade" id="tabTemplates" role="tabpanel">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle hrms-admin-datatable w-100">
                            <thead>
                                <tr>
                                    <th>Code / Name</th>
                                    <th>Module &amp; Trigger</th>
                                    <th>Subject &amp; Body Pattern</th>
                                    <th>Channels</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model.Templates)
                                {
                                    <tr>
                                        <td class="small">
                                            <div class="fw-semibold">@t.TemplateName</div>
                                            <div class="font-monospace text-body-secondary">@t.TemplateCode</div>
                                        </td>
                                        <td class="small">
                                            <span class="badge bg-primary-subtle text-primary-emphasis">@t.ModuleName</span>
                                            <div class="text-body-secondary mt-1">@t.EventTrigger</div>
                                        </td>
                                        <td class="small">
                                            <div class="fw-semibold">@t.SubjectTemplate</div>
                                            <div class="text-body-secondary">@t.BodyTemplate</div>
                                        </td>
                                        <td class="small">
                                            @if (t.SendInApp) { <span class="badge bg-info-subtle text-info-emphasis">In-App</span> }
                                            @if (t.SendEmailDigest) { <span class="badge bg-secondary-subtle text-secondary-emphasis">Digest</span> }
                                        </td>
                                        <td>
                                            <span class="badge @(t.IsActive ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                                                @(t.IsActive ? "Active" : "Disabled")
                                            </span>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    onclick='HrmsAdmin.openTemplateModal(@Html.Raw(JsonSerializer.Serialize(t, camelOpts)))'>
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    onclick="HrmsAdmin.deleteEntity('/Notifications/DeleteTemplate/@t.TemplateId', 'Delete template @t.TemplateCode?')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.CanManageNotifications)
{
    <!-- Broadcast Notification Modal -->
    <div class="modal fade" id="broadcastNotifModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-megaphone me-2 text-primary"></i>Broadcast Enterprise Notification</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="broadcastNotifForm" onsubmit="event.preventDefault(); HrmsAdmin.submitAjaxForm('#broadcastNotifForm', '@Url.Action("SendBroadcast")', '#broadcastNotifModal');">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label small fw-semibold">Title <span class="text-danger">*</span></label>
                                <input type="text" name="Title" class="form-control" maxlength="150" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Module</label>
                                <select name="ModuleName" class="form-select">
                                    <option value="System">System</option>
                                    <option value="Payroll">Payroll</option>
                                    <option value="Leave">Leave</option>
                                    <option value="Attendance">Attendance</option>
                                    <option value="Workflow">Workflow</option>
                                    <option value="Security">Security</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Message <span class="text-danger">*</span></label>
                                <textarea name="Message" class="form-control" rows="3" maxlength="500" required></textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Alert Type</label>
                                <select name="NotificationType" class="form-select">
                                    <option value="Info">Info</option>
                                    <option value="Success">Success</option>
                                    <option value="Warning">Warning</option>
                                    <option value="Danger">Danger</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Priority</label>
                                <select name="Priority" class="form-select">
                                    <option value="Low">Low</option>
                                    <option value="Normal" selected>Normal</option>
                                    <option value="High">High</option>
                                    <option value="Urgent">Urgent</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Target Audience</label>
                                <select id="bcTargetScope" name="TargetScope" class="form-select" onchange="HrmsAdmin.toggleBroadcastAudience()">
                                    <option value="AllUsers">All Active Users</option>
                                    <option value="Role">Specific Role</option>
                                    <option value="Department">Specific Department</option>
                                    <option value="SpecificUser">Specific User</option>
                                </select>
                            </div>
                            <div class="col-md-6 d-none" id="bcRoleGroup">
                                <label class="form-label small fw-semibold">Select Role</label>
                                <select name="TargetRoleId" class="form-select">
                                    <option value="">-- Choose Role --</option>
                                    @foreach (var r in Model.Roles)
                                    {
                                        <option value="@r.RoleId">@r.RoleName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 d-none" id="bcDeptGroup">
                                <label class="form-label small fw-semibold">Select Department</label>
                                <select name="TargetDepartmentId" class="form-select">
                                    <option value="">-- Choose Department --</option>
                                    @foreach (var d in Model.Departments)
                                    {
                                        <option value="@d.DepartmentId">@d.DepartmentName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 d-none" id="bcUserGroup">
                                <label class="form-label small fw-semibold">Select User</label>
                                <select name="TargetUserId" class="form-select">
                                    <option value="">-- Choose User --</option>
                                    @foreach (var u in Model.Users)
                                    {
                                        <option value="@u.UserId">@u.FullName (@u.Username)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Optional In-App Action Route</label>
                                <input type="text" name="ActionUrl" class="form-control" maxlength="260" placeholder="e.g., /Payroll or /SelfService" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Send Notification</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Notification Template Modal -->
    <div class="modal fade" id="notifTemplateModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ntModalTitle">Notification Template</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="notifTemplateForm" onsubmit="event.preventDefault(); HrmsAdmin.submitAjaxForm('#notifTemplateForm', '@Url.Action("SaveTemplate")', '#notifTemplateModal');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="ntId" name="TemplateId" value="0" />
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Code <span class="text-danger">*</span></label>
                                <input type="text" id="ntCode" name="TemplateCode" class="form-control text-uppercase" maxlength="60" required />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small fw-semibold">Template Name <span class="text-danger">*</span></label>
                                <input type="text" id="ntName" name="TemplateName" class="form-control" maxlength="120" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Module</label>
                                <select id="ntModule" name="ModuleName" class="form-select">
                                    <option value="Leave">Leave</option>
                                    <option value="Payroll">Payroll</option>
                                    <option value="Loan">Loan</option>
                                    <option value="Exit">Exit</option>
                                    <option value="Workflow">Workflow</option>
                                    <option value="Security">Security</option>
                                    <option value="System">System</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Trigger</label>
                                <select id="ntTrigger" name="EventTrigger" class="form-select">
                                    <option value="OnSubmitted">OnSubmitted</option>
                                    <option value="OnApproved">OnApproved</option>
                                    <option value="OnRejected">OnRejected</option>
                                    <option value="OnEscalated">OnEscalated</option>
                                    <option value="OnReminder">OnReminder</option>
                                    <option value="ManualBroadcast">ManualBroadcast</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Default Type</label>
                                <select id="ntType" name="DefaultType" class="form-select">
                                    <option value="Info">Info</option>
                                    <option value="Success">Success</option>
                                    <option value="Warning">Warning</option>
                                    <option value="Danger">Danger</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Priority</label>
                                <select id="ntPriority" name="DefaultPriority" class="form-select">
                                    <option value="Low">Low</option>
                                    <option value="Normal">Normal</option>
                                    <option value="High">High</option>
                                    <option value="Urgent">Urgent</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Subject Template <span class="text-danger">*</span></label>
                                <input type="text" id="ntSubject" name="SubjectTemplate" class="form-control" maxlength="180" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Body Template <span class="text-danger">*</span></label>
                                <textarea id="ntBody" name="BodyTemplate" class="form-control" rows="3" maxlength="600" required></textarea>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch">
                                    <input type="hidden" name="SendInApp" value="false" />
                                    <input class="form-check-input" type="checkbox" id="ntInApp" name="SendInApp" value="true" checked />
                                    <label class="form-check-label small" for="ntInApp">In-App Delivery</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch">
                                    <input type="hidden" name="SendEmailDigest" value="false" />
                                    <input class="form-check-input" type="checkbox" id="ntEmail" name="SendEmailDigest" value="true" />
                                    <label class="form-check-label small" for="ntEmail">Include in Digest</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch">
                                    <input type="hidden" name="IsActive" value="false" />
                                    <input class="form-check-input" type="checkbox" id="ntActive" name="IsActive" value="true" checked />
                                    <label class="form-check-label small" for="ntActive">Active Template</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Template</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/system-admin.js" asp-append-version="true"></script>
}
