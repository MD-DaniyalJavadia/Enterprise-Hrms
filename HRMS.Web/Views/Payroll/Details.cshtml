@model PayrollRunDetailsViewModel
@{
    ViewData["Title"] = $"Payroll Batch - {Model.Run.PeriodLabel}";
    ViewData["BreadcrumbParent"] = "Payroll";
    var canManage = User.HasPermission("PAYROLL.MANAGE");
    var isDraft = Model.Run.PayrollStatus == "Draft";
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>All Runs
        </a>
        @if (canManage)
        {
            <a asp-action="ExportRunCsv" asp-route-id="@Model.Run.PayrollRunId" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export Register CSV
            </a>
            <a asp-action="ExportBankAdvice" asp-route-id="@Model.Run.PayrollRunId" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-bank me-1"></i>Bank Transfer CSV
            </a>
            @if (isDraft)
            {
                <button type="button" class="btn btn-success btn-sm"
                        onclick='HrmsPayroll.updateRunStatus(@Model.Run.PayrollRunId, "Approved", @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Run.PeriodLabel)))'>
                    <i class="bi bi-check-circle me-1"></i>Approve Batch
                </button>
            }
            @if (Model.Run.PayrollStatus is "Draft" or "Approved")
            {
                <button type="button" class="btn btn-primary btn-sm"
                        onclick='HrmsPayroll.updateRunStatus(@Model.Run.PayrollRunId, "Locked", @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Run.PeriodLabel)))'>
                    <i class="bi bi-lock me-1"></i>Lock Batch
                </button>
            }
            @if (Model.Run.PayrollStatus is "Approved" or "Locked")
            {
                <button type="button" class="btn btn-dark btn-sm"
                        onclick='HrmsPayroll.updateRunStatus(@Model.Run.PayrollRunId, "Paid", @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Run.PeriodLabel)))'>
                    <i class="bi bi-cash-coin me-1"></i>Mark Paid
                </button>
            }
        }
    </div>
}

<!-- Summary Cards -->
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary">Batch Status</div>
                <div class="fs-5 fw-bold">@Model.Run.PayrollStatus</div>
                <div class="small text-body-secondary">@Model.Run.ProcessedEmployees employee(s)</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary">Total Gross</div>
                <div class="fs-5 fw-bold">@Model.Run.TotalGrossPay.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-danger fw-semibold">Income Tax</div>
                <div class="fs-5 fw-bold text-danger">@Model.Run.TotalTaxDeducted.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-warning-emphasis fw-semibold">Total Deductions</div>
                <div class="fs-5 fw-bold text-warning-emphasis">@Model.Run.TotalDeductions.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-success fw-semibold">Total Net Pay</div>
                <div class="fs-5 fw-bold text-success">@Model.Run.TotalNetPay.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-info fw-semibold">Employer Contrib.</div>
                <div class="fs-5 fw-bold text-info">@Model.Run.TotalEmployerContributions.ToString("N2")</div>
            </div>
        </div>
    </div>
</div>

@if (canManage && Model.DepartmentSummary.Any())
{
    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent py-3">
                    <h6 class="fw-bold mb-0">Department Payroll Cost Breakdown</h6>
                </div>
                <div class="card-body">
                    <canvas id="deptPayrollChart" height="170"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent py-3">
                    <h6 class="fw-bold mb-0">Department Cost Summary</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Department</th>
                                    <th class="text-end">Staff</th>
                                    <th class="text-end">Gross</th>
                                    <th class="text-end">Deductions</th>
                                    <th class="text-end pe-3">Net Pay</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ds in Model.DepartmentSummary)
                                {
                                    <tr>
                                        <td class="ps-3 fw-medium">@ds.DepartmentName</td>
                                        <td class="text-end">@ds.Headcount</td>
                                        <td class="text-end">@ds.TotalGross.ToString("N2")</td>
                                        <td class="text-end text-danger">@ds.TotalDeductions.ToString("N2")</td>
                                        <td class="text-end pe-3 fw-bold text-success">@ds.TotalNet.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Employee Payslips Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent py-3">
        <h6 class="fw-bold mb-0">Employee Payslip Register</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-payroll-datatable w-100">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Department</th>
                        <th class="text-end">Paid Days</th>
                        <th class="text-end">Basic</th>
                        <th class="text-end">Allowances</th>
                        <th class="text-end">OT / Encash / Bonus</th>
                        <th class="text-end">Gross</th>
                        <th class="text-end">Tax</th>
                        <th class="text-end">Deductions</th>
                        <th class="text-end">Net Pay</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Payslips)
                    {
                        var extraEarn = p.OvertimePay + p.LeaveEncashmentPay + p.BonusAmount;
                        var pBadge = p.PaymentStatus switch
                        {
                            "Paid" => "bg-success-subtle text-success-emphasis",
                            "Hold" => "bg-danger-subtle text-danger-emphasis",
                            _ => "bg-warning-subtle text-warning-emphasis"
                        };
                        <tr>
                            <td>
                                <div class="fw-semibold">@p.FullName</div>
                                <div class="small text-body-secondary">@p.EmployeeCode &bull; @p.DesignationTitle</div>
                            </td>
                            <td class="small">@p.DepartmentName</td>
                            <td class="text-end small">@p.PaidDays.ToString("0.##") / @p.WorkingDaysInMonth.ToString("0.##")</td>
                            <td class="text-end">@p.BasicPay.ToString("N2")</td>
                            <td class="text-end">@p.TotalAllowances.ToString("N2")</td>
                            <td class="text-end">@extraEarn.ToString("N2")</td>
                            <td class="text-end fw-semibold">@p.GrossPay.ToString("N2")</td>
                            <td class="text-end text-danger">@p.IncomeTax.ToString("N2")</td>
                            <td class="text-end text-warning-emphasis">@p.TotalDeductions.ToString("N2")</td>
                            <td class="text-end fw-bold text-success">@p.NetPay.ToString("N2")</td>
                            <td><span class="badge @pBadge">@p.PaymentStatus</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Payslip" asp-route-id="@p.PayslipId" class="btn btn-sm btn-outline-info" title="View / Print Payslip">
                                    <i class="bi bi-file-earmark-text"></i>
                                </a>
                                @if (canManage && isDraft)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary" title="Adjust Bonus / Deductions"
                                            onclick='HrmsPayroll.openAdjustPayslipModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                                                payslipId = p.PayslipId,
                                                employeeCode = p.EmployeeCode,
                                                fullName = p.FullName,
                                                bonusAmount = p.BonusAmount,
                                                otherDeductions = p.OtherDeductions,
                                                paymentStatus = p.PaymentStatus,
                                                notes = p.Notes ?? ""
                                            })))'>
                                        <i class="bi bi-sliders"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (canManage && isDraft)
{
    <div class="modal fade" id="adjustPayslipModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Adjust Payslip</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="adjustPayslipForm" onsubmit="event.preventDefault(); HrmsPayroll.submitAjaxForm('#adjustPayslipForm', '@Url.Action("AdjustPayslip")', '#adjustPayslipModal', false);">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="adjPayslipId" name="PayslipId" value="0" />
                    <div class="modal-body">
                        <div class="alert alert-light border small mb-3">
                            <strong id="adjPayslipEmpLabel">-</strong>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Bonus / Incentive</label>
                                <input id="adjBonus" type="number" step="0.01" min="0" name="BonusAmount" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Other Deductions</label>
                                <input id="adjOtherDed" type="number" step="0.01" min="0" name="OtherDeductions" class="form-control" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Payment Status</label>
                                <select id="adjPayStatus" name="PaymentStatus" class="form-select" required>
                                    <option value="Pending">Pending</option>
                                    <option value="Hold">Hold Payment</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Adjustment Notes</label>
                                <textarea id="adjNotes" name="Notes" class="form-control" rows="2" maxlength="300"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Adjustment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/payroll.js" asp-append-version="true"></script>
    @if (canManage && Model.DepartmentSummary.Any())
    {
        <script>
            (function () {
                const ctx = document.getElementById('deptPayrollChart');
                if (!ctx || typeof Chart === 'undefined') return;
                const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartmentSummary.Select(x => x.DepartmentName)));
                const gross = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartmentSummary.Select(x => x.TotalGross)));
                const net = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartmentSummary.Select(x => x.TotalNet)));
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            { label: 'Gross Pay', data: gross, backgroundColor: 'rgba(37, 99, 235, 0.75)' },
                            { label: 'Net Pay', data: net, backgroundColor: 'rgba(16, 185, 129, 0.75)' }
                        ]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { position: 'bottom' } },
                        scales: { y: { beginAtZero: true } }
                    }
                });
            })();
        </script>
    }
}
