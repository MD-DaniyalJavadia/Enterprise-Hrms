@model PayrollRunsPageViewModel
@{
    ViewData["Title"] = "Payroll Runs";
    ViewData["BreadcrumbParent"] = "Payroll";
    var canManage = User.HasPermission("PAYROLL.MANAGE");
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        @if (canManage)
        {
            <a asp-action="Structures" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-diagram-2 me-1"></i>Salary Structures
            </a>
            <a asp-action="Components" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-sliders2 me-1"></i>Components &amp; Tax Slabs
            </a>
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#generatePayrollModal">
                <i class="bi bi-calculator me-1"></i>Run Payroll
            </button>
        }
    </div>
}

<!-- KPI Summary Strip -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary">Total Batches</div>
                <div class="fs-4 fw-bold">@Model.Kpi.TotalRuns</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-warning fw-semibold">Draft Batches</div>
                <div class="fs-4 fw-bold text-warning">@Model.Kpi.DraftCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-success fw-semibold">Finalized</div>
                <div class="fs-4 fw-bold text-success">@Model.Kpi.FinalizedCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-primary fw-semibold">Latest Net Pay</div>
                <div class="fs-5 fw-bold text-primary">@Model.Kpi.LatestNetPay.ToString("C0")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-info fw-semibold">YTD Gross</div>
                <div class="fs-5 fw-bold text-info">@Model.Kpi.YearToDateGross.ToString("C0")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-danger fw-semibold">YTD Income Tax</div>
                <div class="fs-5 fw-bold text-danger">@Model.Kpi.YearToDateTax.ToString("C0")</div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Strip -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Payroll Year</label>
                <select name="year" class="form-select form-select-sm">
                    <option value="">All Years</option>
                    @for (int y = DateTime.Today.Year - 3; y <= DateTime.Today.Year + 1; y++)
                    {
                        <option value="@y" selected="@(Model.FilterYear == y)">@y</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Payroll Runs Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-payroll-datatable w-100">
                <thead>
                    <tr>
                        <th>Period</th>
                        <th>Pay Date</th>
                        <th class="text-end">Employees</th>
                        <th class="text-end">Gross Pay</th>
                        <th class="text-end">Income Tax</th>
                        <th class="text-end">Total Deductions</th>
                        <th class="text-end">Net Pay</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var run in Model.Runs)
                    {
                        var badge = run.PayrollStatus switch
                        {
                            "Paid" => "bg-success-subtle text-success-emphasis",
                            "Locked" => "bg-primary-subtle text-primary-emphasis",
                            "Approved" => "bg-info-subtle text-info-emphasis",
                            _ => "bg-warning-subtle text-warning-emphasis"
                        };
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@run.PayrollRunId" class="fw-semibold text-decoration-none">@run.PeriodLabel</a>
                                @if (!string.IsNullOrWhiteSpace(run.Notes))
                                {
                                    <div class="small text-body-secondary text-truncate" style="max-width: 220px;" title="@run.Notes">@run.Notes</div>
                                }
                            </td>
                            <td class="small">@(run.PayDate?.ToString("dd MMM yyyy") ?? "-")</td>
                            <td class="text-end">@run.ProcessedEmployees</td>
                            <td class="text-end fw-medium">@run.TotalGrossPay.ToString("N2")</td>
                            <td class="text-end text-danger">@run.TotalTaxDeducted.ToString("N2")</td>
                            <td class="text-end text-warning-emphasis">@run.TotalDeductions.ToString("N2")</td>
                            <td class="text-end fw-bold text-success">@run.TotalNetPay.ToString("N2")</td>
                            <td><span class="badge @badge">@run.PayrollStatus</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@run.PayrollRunId" class="btn btn-sm btn-outline-primary" title="View Batch">
                                    <i class="bi bi-eye me-1"></i>Open
                                </a>
                                @if (canManage && run.PayrollStatus == "Draft")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success" title="Approve Batch"
                                            onclick='HrmsPayroll.updateRunStatus(@run.PayrollRunId, "Approved", @Html.Raw(System.Text.Json.JsonSerializer.Serialize(run.PeriodLabel)))'>
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Delete Draft"
                                            onclick='HrmsPayroll.deleteRun(@run.PayrollRunId, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(run.PeriodLabel)))'>
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (canManage)
{
    <div class="modal fade" id="generatePayrollModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-calculator me-2 text-primary"></i>Generate / Recalculate Payroll Batch</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="generatePayrollForm" onsubmit="event.preventDefault(); HrmsPayroll.submitAjaxForm('#generatePayrollForm', '@Url.Action("Generate")', '#generatePayrollModal', true);">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="alert alert-info small mb-3">
                            Automatically computes salary structures, prorated mid-month hires, unpaid absences/leaves, approved overtime, approved leave encashments, and progressive tax brackets. Existing <strong>Draft</strong> batches for the selected month are recalculated cleanly.
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Payroll Year</label>
                                <input type="number" name="PayrollYear" class="form-control" value="@DateTime.Today.Year" min="2020" max="2050" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Payroll Month</label>
                                <select name="PayrollMonth" class="form-select" required>
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        <option value="@m" selected="@(DateTime.Today.Month == m)">@(new DateTime(2026, m, 1).ToString("MMMM"))</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Pay Date (Optional — defaults to month-end)</label>
                                <input type="date" name="PayDate" class="form-control" value="@(new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month)).ToString("yyyy-MM-dd"))" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Batch Notes</label>
                                <textarea name="Notes" class="form-control" rows="2" maxlength="500" placeholder="Optional payroll run notes..."></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Generate Payroll</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/payroll.js" asp-append-version="true"></script>
}
