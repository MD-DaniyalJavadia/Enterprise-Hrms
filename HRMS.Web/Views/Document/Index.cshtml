@using System.Text.Json
@model DocumentIndexPageViewModel
@{
    ViewData["Title"] = "HR Policy & Document Repository";
    ViewData["BreadcrumbParent"] = "Assets & Documents";
    var camelOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ExportDocuments" asp-route-categoryId="@Model.CategoryId" asp-route-status="@Model.Status"
           asp-route-visibility="@Model.Visibility" asp-route-search="@Model.Search"
           class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-download me-1"></i>Export CSV
        </a>
        <a asp-action="EmployeeVault" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-safe2 me-1"></i>Employee Doc Vault
        </a>
        <a asp-action="Acknowledgments" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-check2-square me-1"></i>Policy Sign-Offs
        </a>
        @if (Model.CanManage)
        {
            <a asp-action="Categories" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-bookmarks me-1"></i>Categories
            </a>
            <button type="button" class="btn btn-primary btn-sm" onclick="HrmsAssetDoc.openCompanyDocumentModal()">
                <i class="bi bi-cloud-upload me-1"></i>Publish Document
            </button>
        }
    </div>
}

<!-- KPI Strip -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary fw-semibold">Accessible Documents</div>
                <div class="fs-4 fw-bold">@Model.Kpi.TotalDocuments</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-success fw-semibold">Published</div>
                <div class="fs-4 fw-bold text-success">@Model.Kpi.PublishedCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-primary fw-semibold">Mandatory Policies</div>
                <div class="fs-4 fw-bold text-primary">@Model.Kpi.MandatoryCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-6 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-warning fw-semibold">Pending My Sign-Off</div>
                <div class="fs-4 fw-bold text-warning">@Model.Kpi.PendingMyAckCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-6 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-danger fw-semibold">Expiring &le; 30d</div>
                <div class="fs-4 fw-bold text-danger">@Model.Kpi.ExpiringSoonCount</div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Strip -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Category</label>
                <select name="categoryId" class="form-select form-select-sm">
                    <option value="">All Categories</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.CategoryId" selected="@(Model.CategoryId == c.CategoryId)">@c.CategoryName</option>
                    }
                </select>
            </div>
            @if (Model.CanManage)
            {
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Status</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="">All Statuses</option>
                        @foreach (var st in new[] { "Published", "Draft", "Archived" })
                        {
                            <option value="@st" selected="@(string.Equals(Model.Status, st, StringComparison.OrdinalIgnoreCase))">@st</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Visibility</label>
                    <select name="visibility" class="form-select form-select-sm">
                        <option value="">All Scopes</option>
                        @foreach (var v in new[] { "AllEmployees", "ManagersOnly", "HrOnly", "DepartmentSpecific" })
                        {
                            <option value="@v" selected="@(string.Equals(Model.Visibility, v, StringComparison.OrdinalIgnoreCase))">@v</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Keyword</label>
                <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Code, title, description..." />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Documents Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-ad-datatable w-100">
                <thead>
                    <tr>
                        <th>Document</th>
                        <th>Category &amp; Scope</th>
                        <th>Effective / Expiry</th>
                        <th>Sign-Off Compliance</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Documents)
                    {
                        var stBadge = d.DocumentStatus switch
                        {
                            "Published" => "bg-success-subtle text-success-emphasis",
                            "Draft" => "bg-warning-subtle text-warning-emphasis",
                            _ => "bg-secondary-subtle text-secondary-emphasis"
                        };
                        <tr>
                            <td>
                                <div class="fw-semibold">@d.Title <span class="badge bg-light text-dark border ms-1">v@(d.VersionNumber)</span></div>
                                <div class="small text-body-secondary">
                                    <span class="font-monospace">@d.DocumentCode</span> &bull; @d.OriginalFileName
                                </div>
                                @if (!string.IsNullOrWhiteSpace(d.Description))
                                {
                                    <div class="small text-body-secondary text-truncate" style="max-width: 360px;">@d.Description</div>
                                }
                            </td>
                            <td class="small">
                                <div class="fw-medium">@d.CategoryName</div>
                                <div class="text-body-secondary">
                                    @d.Visibility @(d.DepartmentName != null ? $"({d.DepartmentName})" : "")
                                </div>
                            </td>
                            <td class="small">
                                <div>Eff: @d.EffectiveDate.ToString("dd MMM yyyy")</div>
                                @if (d.ExpiryDate.HasValue)
                                {
                                    var isNear = d.ExpiryDate.Value.Date <= DateTime.Today.AddDays(30);
                                    <div class="@(isNear ? "text-danger fw-semibold" : "text-body-secondary")">
                                        Exp: @d.ExpiryDate.Value.ToString("dd MMM yyyy")
                                    </div>
                                }
                            </td>
                            <td class="small">
                                @if (d.RequiresAcknowledgment)
                                {
                                    <div class="fw-semibold">@d.AcknowledgedCount / @d.TargetAudienceCount signed</div>
                                    @if (Model.HasLinkedEmployee)
                                    {
                                        @if (d.IsAcknowledgedByMe)
                                        {
                                            <span class="badge bg-success-subtle text-success-emphasis">Signed on @d.MyAcknowledgedDate?.ToString("dd MMM yy")</span>
                                        }
                                        else if (d.DocumentStatus == "Published")
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis">Action Required</span>
                                        }
                                    }
                                }
                                else
                                {
                                    <span class="text-body-secondary">Reference Only</span>
                                }
                            </td>
                            <td><span class="badge @stBadge">@d.DocumentStatus</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="DownloadCompanyDocument" asp-route-id="@d.DocumentId" class="btn btn-sm btn-outline-primary" title="Download File">
                                    <i class="bi bi-file-earmark-arrow-down"></i>
                                </a>
                                @if (d.RequiresAcknowledgment && d.DocumentStatus == "Published" && Model.HasLinkedEmployee && !d.IsAcknowledgedByMe)
                                {
                                    <button type="button" class="btn btn-sm btn-success" title="Sign & Acknowledge"
                                            onclick='HrmsAssetDoc.openAcknowledgeModal(@d.DocumentId, @Html.Raw(JsonSerializer.Serialize(d.Title)), @Html.Raw(JsonSerializer.Serialize(d.VersionNumber)))'>
                                        <i class="bi bi-pen me-1"></i>Sign Off
                                    </button>
                                }
                                @if (Model.CanManage)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" title="Edit / Upload New Version"
                                            onclick='HrmsAssetDoc.openCompanyDocumentModal(@Html.Raw(JsonSerializer.Serialize(d, camelOpts)))'>
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Delete"
                                            onclick='HrmsAssetDoc.deleteCompanyDocument(@d.DocumentId, @Html.Raw(JsonSerializer.Serialize(d.Title)))'>
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Acknowledge Document Modal -->
<div class="modal fade" id="acknowledgeDocModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pen me-2 text-success"></i>Policy Acknowledgment &amp; Sign-Off</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="acknowledgeDocForm" onsubmit="event.preventDefault(); HrmsAssetDoc.submitAjaxForm('#acknowledgeDocForm', '@Url.Action("AcknowledgeDocument")', '#acknowledgeDocModal');">
                @Html.AntiForgeryToken()
                <input type="hidden" id="ackDocId" name="DocumentId" value="0" />
                <div class="modal-body">
                    <div class="alert alert-light border small mb-3">
                        By confirming below, you attest that you have read and understood <strong id="ackDocLabel"></strong>.
                    </div>
                    <div>
                        <label class="form-label small fw-semibold">Optional Remarks</label>
                        <textarea id="ackRemarks" name="Remarks" class="form-control" rows="2" maxlength="250" placeholder="Reviewed and accepted."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Confirm Sign-Off</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.CanManage)
{
    <!-- Publish / Edit Document Modal -->
    <div class="modal fade" id="companyDocModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="docModalTitle">Publish Company Document</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="companyDocForm" enctype="multipart/form-data"
                      onsubmit="event.preventDefault(); HrmsAssetDoc.submitMultipartForm('#companyDocForm', '@Url.Action("SaveDocument")', '#companyDocModal');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="docId" name="DocumentId" value="0" />
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Category <span class="text-danger">*</span></label>
                                <select id="docCategoryId" name="CategoryId" class="form-select" required>
                                    <option value="">Select category...</option>
                                    @foreach (var c in Model.Categories)
                                    {
                                        <option value="@c.CategoryId">@c.CategoryName (@c.ScopeType)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Document Code</label>
                                <input type="text" id="docCode" name="DocumentCode" class="form-control" maxlength="30" placeholder="Auto if blank" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Version <span class="text-danger">*</span></label>
                                <input type="text" id="docVersion" name="VersionNumber" class="form-control" maxlength="20" value="1.0" required />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small fw-semibold">Title <span class="text-danger">*</span></label>
                                <input type="text" id="docTitle" name="Title" class="form-control" maxlength="180" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Status</label>
                                <select id="docStatus" name="DocumentStatus" class="form-select">
                                    <option value="Published">Published</option>
                                    <option value="Draft">Draft</option>
                                    <option value="Archived">Archived</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Visibility Scope</label>
                                <select id="docVisibility" name="Visibility" class="form-select">
                                    <option value="AllEmployees">AllEmployees</option>
                                    <option value="ManagersOnly">ManagersOnly</option>
                                    <option value="HrOnly">HrOnly</option>
                                    <option value="DepartmentSpecific">DepartmentSpecific</option>
                                </select>
                            </div>
                            <div class="col-md-4 d-none" id="docDepartmentGroup">
                                <label class="form-label small fw-semibold">Target Department</label>
                                <select id="docDepartmentId" name="DepartmentId" class="form-select">
                                    <option value="">Select department...</option>
                                    @foreach (var dep in Model.Departments)
                                    {
                                        <option value="@dep.DepartmentId">@dep.DepartmentName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Effective Date <span class="text-danger">*</span></label>
                                <input type="date" id="docEffective" name="EffectiveDate" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Expiry / Review Date</label>
                                <input type="date" id="docExpiry" name="ExpiryDate" class="form-control" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small fw-semibold">Document File</label>
                                <input type="file" id="docFile" name="documentFile" class="form-control" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.jpg,.jpeg,.png" />
                                <div class="form-text" id="docFileHelp"></div>
                            </div>
                            <div class="col-md-4 d-flex align-items-center pt-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="docAck" name="RequiresAcknowledgment" value="true" />
                                    <input type="hidden" name="RequiresAcknowledgment" value="false" />
                                    <label class="form-check-label small fw-semibold" for="docAck">Mandatory Sign-Off</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Summary / Description</label>
                                <textarea id="docDesc" name="Description" class="form-control" rows="2" maxlength="500"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Document</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/asset-document.js" asp-append-version="true"></script>
}
