@using System.Text.Json
@model List<HRMS.Models.Entities.DocumentCategory>
@{
    ViewData["Title"] = "Document Categories & Retention Rules";
    ViewData["BreadcrumbParent"] = "Assets & Documents";
    var camelOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

@section PageActions {
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-folder2-open me-1"></i>Policy Repository
        </a>
        <button type="button" class="btn btn-primary btn-sm" onclick="HrmsAssetDoc.openDocCategoryModal()">
            <i class="bi bi-plus-lg me-1"></i>Add Category
        </button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-ad-datatable w-100">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Category Name</th>
                        <th>Scope</th>
                        <th>Default Visibility</th>
                        <th>Sign-Off Default</th>
                        <th class="text-center">Retention (Mo)</th>
                        <th class="text-center">Docs</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="font-monospace fw-semibold">@c.CategoryCode</td>
                            <td>
                                <div class="fw-semibold">@c.CategoryName</div>
                                @if (!string.IsNullOrWhiteSpace(c.Description))
                                {
                                    <div class="small text-body-secondary">@c.Description</div>
                                }
                            </td>
                            <td><span class="badge bg-info-subtle text-info-emphasis">@c.ScopeType</span></td>
                            <td class="small">@c.DefaultVisibility</td>
                            <td>@(c.RequiresAcknowledgment ? "Mandatory" : "Optional")</td>
                            <td class="text-center">@(c.RetentionMonths?.ToString() ?? "-")</td>
                            <td class="text-center fw-semibold">@c.DocumentCount</td>
                            <td>
                                <span class="badge @(c.IsActive ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                                    @(c.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        onclick='HrmsAssetDoc.openDocCategoryModal(@Html.Raw(JsonSerializer.Serialize(c, camelOpts)))'>
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        onclick='HrmsAssetDoc.deleteDocCategory(@c.CategoryId, @Html.Raw(JsonSerializer.Serialize(c.CategoryName)))'>
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Document Category Modal -->
<div class="modal fade" id="docCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="dcatModalTitle">Add Document Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="docCategoryForm" onsubmit="event.preventDefault(); HrmsAssetDoc.submitAjaxForm('#docCategoryForm', '@Url.Action("SaveCategory")', '#docCategoryModal');">
                @Html.AntiForgeryToken()
                <input type="hidden" id="dcatId" name="CategoryId" value="0" />
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label class="form-label small fw-semibold">Code <span class="text-danger">*</span></label>
                            <input type="text" id="dcatCode" name="CategoryCode" class="form-control" maxlength="20" required />
                        </div>
                        <div class="col-8">
                            <label class="form-label small fw-semibold">Category Name <span class="text-danger">*</span></label>
                            <input type="text" id="dcatName" name="CategoryName" class="form-control" maxlength="100" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label class="form-label small fw-semibold">Scope Type</label>
                            <select id="dcatScope" name="ScopeType" class="form-select">
                                <option value="CompanyPolicy">CompanyPolicy</option>
                                <option value="Compliance">Compliance</option>
                                <option value="Template">Template</option>
                                <option value="Guide">Guide</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold">Default Visibility</label>
                            <select id="dcatVis" name="DefaultVisibility" class="form-select">
                                <option value="AllEmployees">AllEmployees</option>
                                <option value="ManagersOnly">ManagersOnly</option>
                                <option value="HrOnly">HrOnly</option>
                                <option value="DepartmentSpecific">DepartmentSpecific</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold">Retention (Mo)</label>
                            <input type="number" id="dcatRet" name="RetentionMonths" class="form-control" min="1" max="600" />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="dcatAck" name="RequiresAcknowledgment" value="true" />
                                <input type="hidden" name="RequiresAcknowledgment" value="false" />
                                <label class="form-check-label small" for="dcatAck">Requires Sign-Off</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="dcatActive" name="IsActive" value="true" checked />
                                <input type="hidden" name="IsActive" value="false" />
                                <label class="form-check-label small" for="dcatActive">Active</label>
                            </div>
                        </div>
                    </div>
                    <div>
                        <label class="form-label small fw-semibold">Description</label>
                        <textarea id="dcatDesc" name="Description" class="form-control" rows="2" maxlength="300"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/asset-document.js" asp-append-version="true"></script>
}
