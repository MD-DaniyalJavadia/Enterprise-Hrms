@model IEnumerable<CompanyListItemViewModel>
@{
    ViewData["Title"] = "Companies";
    ViewData["BreadcrumbParent"] = "Organization";
    var searchTerm = ViewData["SearchTerm"]?.ToString();
    bool? isActive = ViewData["IsActiveFilter"] as bool?;
}

@section PageActions {
    <div class="d-flex gap-2">
        <a asp-action="Export" asp-route-search="@searchTerm" asp-route-isActive="@isActive" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export CSV
        </a>
        @if (User.HasPermission("ORG.MANAGE"))
        {
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>New Company
            </a>
        }
    </div>
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-semibold">Search</label>
                <input type="text" name="search" value="@searchTerm" class="form-control form-control-sm" placeholder="Company code or name..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Status</label>
                <select name="isActive" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="true" selected="@(isActive == true)">Active</option>
                    <option value="false" selected="@(isActive == false)">Inactive</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-datatable w-100">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Company Name</th>
                        <th>Location</th>
                        <th>Currency / TZ</th>
                        <th>Branches</th>
                        <th>Employees</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="fw-semibold">@item.CompanyCode</span></td>
                            <td>
                                <div class="fw-semibold">@item.CompanyName</div>
                                <div class="small text-body-secondary">@item.Email</div>
                            </td>
                            <td>@item.City@(string.IsNullOrEmpty(item.Country) ? "" : $", {item.Country}")</td>
                            <td><span class="badge bg-secondary-subtle text-secondary-emphasis">@item.CurrencyCode</span> <small class="text-body-secondary">@item.TimeZoneId</small></td>
                            <td>@item.BranchCount</td>
                            <td>@item.EmployeeCount</td>
                            <td>
                                <span class="badge @(item.IsActive ? "bg-success-subtle text-success-emphasis" : "bg-danger-subtle text-danger-emphasis")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.CompanyId" class="btn btn-sm btn-outline-info" title="Details"><i class="bi bi-eye"></i></a>
                                @if (User.HasPermission("ORG.MANAGE"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.CompanyId" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="HrmsOrg.confirmDelete('@Url.Action("Delete", new { id = item.CompanyId })', 'Company')" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/organization.js" asp-append-version="true"></script>
}
