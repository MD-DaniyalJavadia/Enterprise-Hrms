@using System.Text.Json
@model ExpensesIndexPageViewModel
@{
    ViewData["Title"] = "Expense Claims";
    ViewData["BreadcrumbParent"] = "Loans & Expenses";
    var canManage = User.HasPermission("EXPENSE.MANAGE");
    var currentEmployeeId = User.GetEmployeeId();
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ExportClaims" asp-route-employeeId="@Model.EmployeeId" asp-route-categoryId="@Model.CategoryId" asp-route-status="@Model.Status" asp-route-search="@Model.SearchTerm"
           class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-download me-1"></i>Export CSV
        </a>
        @if (canManage)
        {
            <a asp-action="Categories" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-tags me-1"></i>Expense Categories
            </a>
        }
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#submitExpenseModal">
            <i class="bi bi-plus-lg me-1"></i>Submit Expense Claim
        </button>
    </div>
}

<!-- KPI Summary Strip -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary fw-semibold">Total Claims</div>
                <div class="fs-4 fw-bold">@Model.Kpi.TotalClaimsCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-warning fw-semibold">Submitted / Pending</div>
                <div class="fs-4 fw-bold text-warning">@Model.Kpi.SubmittedCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-info fw-semibold">Approved (Unpaid)</div>
                <div class="fs-4 fw-bold text-info">@Model.Kpi.ApprovedAwaitingPayoutCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-6 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-primary fw-semibold">Pending Amount</div>
                <div class="fs-5 fw-bold text-primary">@Model.Kpi.TotalPendingAmount.ToString("C2")</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-success fw-semibold">Reimbursed YTD</div>
                <div class="fs-5 fw-bold text-success">@Model.Kpi.TotalReimbursedYtd.ToString("C2")</div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Strip -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            @if (canManage)
            {
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Employee</label>
                    <select name="employeeId" class="form-select form-select-sm hrms-select2">
                        <option value="">All Employees</option>
                        @foreach (var emp in Model.Employees)
                        {
                            <option value="@emp.EmployeeId" selected="@(Model.EmployeeId == emp.EmployeeId)">@emp.FullName (@emp.EmployeeCode)</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Category</label>
                <select name="categoryId" class="form-select form-select-sm">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.CategoryId" selected="@(Model.CategoryId == cat.CategoryId)">@cat.CategoryName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var st in new[] { "Submitted", "Approved", "Reimbursed", "Rejected", "Cancelled" })
                    {
                        <option value="@st" selected="@(string.Equals(Model.Status, st, StringComparison.OrdinalIgnoreCase))">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Search</label>
                <input type="text" name="search" class="form-control form-control-sm" value="@Model.SearchTerm" placeholder="Claim #, vendor..." />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Claims Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-le-datatable w-100">
                <thead>
                    <tr>
                        <th>Claim # &amp; Merchant</th>
                        <th>Employee</th>
                        <th>Category</th>
                        <th>Expense Date</th>
                        <th class="text-end">Claimed</th>
                        <th class="text-end">Approved</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Claims)
                    {
                        var badge = c.ClaimStatus switch
                        {
                            "Reimbursed" => "bg-success-subtle text-success-emphasis",
                            "Approved" => "bg-info-subtle text-info-emphasis",
                            "Rejected" or "Cancelled" => "bg-danger-subtle text-danger-emphasis",
                            _ => "bg-warning-subtle text-warning-emphasis"
                        };
                        <tr>
                            <td>
                                <div class="fw-semibold">@c.MerchantOrVendor</div>
                                <div class="small text-body-secondary">
                                    <span class="badge bg-light text-dark border me-1">@c.ClaimNumber</span>@c.Description
                                </div>
                            </td>
                            <td>
                                <div class="fw-medium">@c.EmployeeName</div>
                                <div class="small text-body-secondary">@c.EmployeeCode &bull; @c.DepartmentName</div>
                            </td>
                            <td class="small">@c.CategoryName</td>
                            <td class="small">@c.ExpenseDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end fw-medium">@c.ClaimAmount.ToString("N2")</td>
                            <td class="text-end fw-semibold text-success">@(c.ApprovedAmount.HasValue ? c.ApprovedAmount.Value.ToString("N2") : "-")</td>
                            <td>
                                <span class="badge @badge">@c.ClaimStatus</span>
                                @if (!string.IsNullOrWhiteSpace(c.PaymentReference))
                                {
                                    <div class="small text-body-secondary">Ref: @c.PaymentReference</div>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                @if (!string.IsNullOrWhiteSpace(c.ReceiptStoredName))
                                {
                                    <a asp-action="DownloadReceipt" asp-route-id="@c.ClaimId" class="btn btn-sm btn-outline-secondary" title="Download Receipt">
                                        <i class="bi bi-receipt"></i>
                                    </a>
                                }
                                @if (canManage && c.ClaimStatus is "Submitted" or "Approved")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success" title="Review / Reimburse"
                                            onclick='HrmsLoanExp.openExpenseReviewModal(@c.ClaimId, @Html.Raw(JsonSerializer.Serialize($"{c.ClaimNumber} - {c.EmployeeName} ({c.MerchantOrVendor})")), @Html.Raw(JsonSerializer.Serialize(c.ClaimStatus)), @(c.ApprovedAmount ?? c.ClaimAmount))'>
                                        <i class="bi bi-check2-square me-1"></i>@(c.ClaimStatus == "Approved" ? "Reimburse" : "Review")
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Submit Expense Claim Modal -->
<div class="modal fade" id="submitExpenseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-credit-card-2-back me-2 text-primary"></i>Submit Expense Claim</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="submitExpenseForm" enctype="multipart/form-data"
                  onsubmit="event.preventDefault(); HrmsLoanExp.submitMultipartForm('#submitExpenseForm', '@Url.Action("SubmitClaim")', '#submitExpenseModal');">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Employee <span class="text-danger">*</span></label>
                            <select name="EmployeeId" class="form-select" required>
                                @if (canManage)
                                {
                                    <option value="">Select Employee</option>
                                }
                                @foreach (var emp in Model.Employees)
                                {
                                    <option value="@emp.EmployeeId" selected="@(currentEmployeeId == emp.EmployeeId)">@emp.FullName (@emp.EmployeeCode)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Expense Category <span class="text-danger">*</span></label>
                            <select name="CategoryId" class="form-select" required>
                                <option value="">Select Category</option>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.CategoryId">
                                        @cat.CategoryName @(cat.MaxLimitPerClaim.HasValue ? $"(Max {cat.MaxLimitPerClaim.Value:N0})" : "") @(cat.RequiresReceipt ? "[Receipt Required]" : "")
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Expense Date <span class="text-danger">*</span></label>
                            <input type="date" name="ExpenseDate" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Merchant / Vendor <span class="text-danger">*</span></label>
                            <input type="text" name="MerchantOrVendor" class="form-control" maxlength="150" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Claim Amount <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" min="0.01" name="ClaimAmount" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Receipt File (.pdf, .jpg, .png, .doc, .docx — max 5 MB)</label>
                            <input type="file" name="receiptFile" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Business Purpose / Notes</label>
                            <textarea name="Description" class="form-control" rows="2" maxlength="500"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit Claim</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (canManage)
{
    <!-- Review / Reimburse Expense Modal -->
    <div class="modal fade" id="reviewExpenseModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-check2-square me-2 text-success"></i>Review / Reimburse Claim</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="reviewExpenseForm" onsubmit="event.preventDefault(); HrmsLoanExp.submitAjaxForm('#reviewExpenseForm', '@Url.Action("ReviewClaim")', '#reviewExpenseModal');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="expRevClaimId" name="ClaimId" value="0" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <div class="small text-body-secondary">Claim</div>
                            <div class="fw-semibold" id="expRevLabel"></div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Action <span class="text-danger">*</span></label>
                            <select id="expRevStatus" name="ActionStatus" class="form-select" required>
                                <option value="Approved">Approve Claim</option>
                                <option value="Reimbursed">Mark as Reimbursed (Paid)</option>
                                <option value="Rejected">Reject Claim</option>
                            </select>
                        </div>
                        <div id="expRevApproveAmtWrap" class="mb-3">
                            <label class="form-label small fw-semibold">Approved Amount</label>
                            <input type="number" step="0.01" min="0.01" id="expRevApprovedAmt" name="ApprovedAmount" class="form-control" />
                        </div>
                        <div id="expRevReimburseFields" class="row g-2 mb-3 d-none">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Reimbursement Date</label>
                                <input type="date" name="ReimbursedDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Payment Reference</label>
                                <input type="text" id="expRevPayRef" name="PaymentReference" class="form-control" maxlength="80" placeholder="e.g., ACH-90124" />
                            </div>
                        </div>
                        <div>
                            <label class="form-label small fw-semibold">Reviewer Remarks</label>
                            <textarea id="expRevComments" name="ReviewerComments" class="form-control" rows="2" maxlength="400"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Save Decision</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/loan-expense.js" asp-append-version="true"></script>
}
