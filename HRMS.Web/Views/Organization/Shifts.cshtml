@model IEnumerable<ShiftViewModel>
@{
    ViewData["Title"] = "Shift Management";
    ViewData["BreadcrumbParent"] = "Organization";
}

@section PageActions {
    @if (User.HasPermission("ORG.MANAGE"))
    {
        <button type="button" class="btn btn-primary btn-sm" onclick="openShiftModal()">
            <i class="bi bi-plus-lg me-1"></i>New Shift
        </button>
    }
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-datatable w-100">
                <thead>
                    <tr><th>Code</th><th>Shift Name</th><th>Timings</th><th>Grace / Break</th><th>Work Hours</th><th>Weekly Off</th><th>Status</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@s.ShiftCode</td>
                            <td>
                                <span class="fw-semibold">@s.ShiftName</span>
                                @if (s.IsNightShift)
                                {
                                    <span class="badge bg-dark-subtle text-body ms-1"><i class="bi bi-moon-stars me-1"></i>Night</span>
                                }
                            </td>
                            <td>@s.StartTimeText - @s.EndTimeText</td>
                            <td class="small">@s.GracePeriodMinutes min / @s.BreakMinutes min</td>
                            <td>@s.WorkingHours hrs</td>
                            <td class="small">@s.WeeklyOffDays</td>
                            <td><span class="badge @(s.IsActive ? "bg-success-subtle text-success-emphasis" : "bg-danger-subtle text-danger-emphasis")">@(s.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-end text-nowrap">
                                @if (User.HasPermission("ORG.MANAGE"))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick='editShift(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(s)))'><i class="bi bi-pencil"></i></button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="HrmsOrg.confirmDelete('@Url.Action("DeleteShift", new { id = s.ShiftId })', 'Shift')"><i class="bi bi-trash"></i></button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="shiftModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="shiftForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ShiftId" id="shiftId" value="0" />
                <div class="modal-header"><h5 class="modal-title" id="shiftModalTitle">Shift</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body row g-3">
                    <div class="col-md-4"><label class="form-label small fw-semibold">Shift Code *</label><input type="text" name="ShiftCode" id="shiftCode" class="form-control" required /></div>
                    <div class="col-md-8"><label class="form-label small fw-semibold">Shift Name *</label><input type="text" name="ShiftName" id="shiftName" class="form-control" required /></div>
                    <div class="col-md-3"><label class="form-label small fw-semibold">Start Time *</label><input type="time" name="StartTimeText" id="shiftStart" class="form-control" value="09:00" required /></div>
                    <div class="col-md-3"><label class="form-label small fw-semibold">End Time *</label><input type="time" name="EndTimeText" id="shiftEnd" class="form-control" value="18:00" required /></div>
                    <div class="col-md-2"><label class="form-label small fw-semibold">Grace (m)</label><input type="number" name="GracePeriodMinutes" id="shiftGrace" class="form-control" value="15" min="0" /></div>
                    <div class="col-md-2"><label class="form-label small fw-semibold">Break (m)</label><input type="number" name="BreakMinutes" id="shiftBreak" class="form-control" value="60" min="0" /></div>
                    <div class="col-md-2"><label class="form-label small fw-semibold">Hours</label><input type="number" step="0.25" name="WorkingHours" id="shiftHours" class="form-control" value="8.00" /></div>
                    <div class="col-md-8"><label class="form-label small fw-semibold">Weekly Off Days *</label><input type="text" name="WeeklyOffDays" id="shiftOff" class="form-control" value="Saturday,Sunday" required /></div>
                    <div class="col-md-4 d-flex align-items-end gap-3">
                        <div class="form-check form-switch mb-2"><input type="checkbox" name="IsNightShift" id="shiftNight" value="true" class="form-check-input" /><label class="form-check-label small" for="shiftNight">Night Shift</label></div>
                        <div class="form-check form-switch mb-2"><input type="checkbox" name="IsActive" id="shiftActive" value="true" class="form-check-input" checked /><label class="form-check-label small" for="shiftActive">Active</label></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="HrmsOrg.submitAjaxForm('#shiftForm', '@Url.Action("SaveShift")', '#shiftModal')">Save Shift</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/organization.js" asp-append-version="true"></script>
    <script>
        function openShiftModal() {
            $('#shiftForm')[0].reset();
            $('#shiftId').val(0);
            $('#shiftStart').val('09:00');
            $('#shiftEnd').val('18:00');
            $('#shiftOff').val('Saturday,Sunday');
            $('#shiftActive').prop('checked', true);
            $('#shiftModalTitle').text('New Shift');
            new bootstrap.Modal(document.getElementById('shiftModal')).show();
        }
        function editShift(s) {
            $('#shiftId').val(s.ShiftId);
            $('#shiftCode').val(s.ShiftCode);
            $('#shiftName').val(s.ShiftName);
            $('#shiftStart').val(s.StartTimeText);
            $('#shiftEnd').val(s.EndTimeText);
            $('#shiftGrace').val(s.GracePeriodMinutes);
            $('#shiftBreak').val(s.BreakMinutes);
            $('#shiftHours').val(s.WorkingHours);
            $('#shiftOff').val(s.WeeklyOffDays);
            $('#shiftNight').prop('checked', s.IsNightShift);
            $('#shiftActive').prop('checked', s.IsActive);
            $('#shiftModalTitle').text('Edit Shift');
            new bootstrap.Modal(document.getElementById('shiftModal')).show();
        }
    </script>
}
