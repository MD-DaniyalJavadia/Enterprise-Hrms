@model OrgChartViewModel
@{
    ViewData["Title"] = "Organization Chart & Hierarchy";
    ViewData["BreadcrumbParent"] = "Organization";
}

<ul class="nav nav-tabs mb-4" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabReportingTree" type="button">
            <i class="bi bi-people-fill me-1"></i>Reporting Hierarchy
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabDepartmentTree" type="button">
            <i class="bi bi-diagram-3-fill me-1"></i>Department Structure
        </button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tabReportingTree">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-bottom py-3">
                <h2 class="h6 fw-bold mb-0">Corporate Reporting Hierarchy</h2>
            </div>
            <div class="card-body hrms-org-tree overflow-auto">
                @if (!Model.ReportingTree.Any())
                {
                    <div class="text-center text-body-secondary py-4 small">No active employee reporting hierarchy found.</div>
                }
                else
                {
                    <partial name="_EmployeeTreeNodes" model="Model.ReportingTree" />
                }
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="tabDepartmentTree">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-bottom py-3">
                <h2 class="h6 fw-bold mb-0">Department Hierarchy</h2>
            </div>
            <div class="card-body hrms-org-tree overflow-auto">
                @if (!Model.DepartmentTree.Any())
                {
                    <div class="text-center text-body-secondary py-4 small">No departments configured.</div>
                }
                else
                {
                    <partial name="_DepartmentTreeNodes" model="Model.DepartmentTree" />
                }
            </div>
        </div>
    </div>
</div>
