@model EmployeeDirectoryFilterViewModel
@{
    ViewData["Title"] = "Employee Directory";
    ViewData["BreadcrumbParent"] = "Employees";
}

@section PageActions {
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-table me-1"></i>Table View</a>
        @if (User.HasPermission("EMPLOYEE.MANAGE"))
        {
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-person-plus me-1"></i>Register Employee</a>
        }
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Search</label>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="Name, code, department..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Branch</label>
                <select name="branchId" class="form-select form-select-sm hrms-select2">
                    <option value="">All Branches</option>
                    @foreach (var b in Model.Branches) { <option value="@b.BranchId" selected="@(Model.BranchId == b.BranchId)">@b.BranchName</option> }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Department</label>
                <select name="departmentId" class="form-select form-select-sm hrms-select2">
                    <option value="">All Departments</option>
                    @foreach (var d in Model.Departments) { <option value="@d.DepartmentId" selected="@(Model.DepartmentId == d.DepartmentId)">@d.DepartmentName</option> }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Employees.Any())
{
    <div class="card border-0 shadow-sm p-5 text-center text-body-secondary">No employees matched your filter criteria.</div>
}
else
{
    <div class="row g-3">
        @foreach (var e in Model.Employees)
        {
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center p-4">
                        <div class="mb-3">
                            @if (!string.IsNullOrEmpty(e.PhotoPath))
                            {
                                <img src="@e.PhotoPath" alt="@e.FullName" class="rounded-circle object-fit-cover shadow-sm" style="width:72px;height:72px;" />
                            }
                            else
                            {
                                <span class="hrms-avatar mx-auto" style="width:72px;height:72px;font-size:1.35rem;">
                                    @string.Join("", e.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])))
                                </span>
                            }
                        </div>
                        <span class="badge bg-primary-subtle text-primary-emphasis mb-1">@e.EmployeeCode</span>
                        <h3 class="h6 fw-bold mb-1">@e.FullName</h3>
                        <div class="small fw-medium text-body-secondary mb-2">@e.DesignationTitle</div>
                        <div class="small text-body-secondary mb-3"><i class="bi bi-diagram-2 me-1"></i>@e.DepartmentName &bull; @e.BranchName</div>
                        <div class="small text-truncate mb-3"><i class="bi bi-envelope me-1"></i>@e.WorkEmail</div>
                        <div class="d-flex justify-content-center gap-2">
                            <a asp-action="Details" asp-route-id="@e.EmployeeId" class="btn btn-sm btn-outline-primary">View Profile</a>
                            <a asp-action="IdCard" asp-route-id="@e.EmployeeId" class="btn btn-sm btn-outline-secondary" title="ID Card"><i class="bi bi-person-badge"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
@section Scripts { <script src="~/js/employee.js" asp-append-version="true"></script> }
