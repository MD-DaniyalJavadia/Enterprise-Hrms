                                    @foreach (var b in Model.Branches)
                                    {
                                        <option value="@b.BranchId" selected="@(b.BranchId == e.BranchId)">@b.BranchName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Department</label>
                                <select name="NewDepartmentId" class="form-select" required>
