                                    <option value="3" selected="@(e.EmploymentStatus == 3)">On Leave</option>
                                    <option value="4" selected="@(e.EmploymentStatus == 4)">Resigned</option>
                                    <option value="5" selected="@(e.EmploymentStatus == 5)">Terminated</option>
                                    <option value="6" selected="@(e.EmploymentStatus == 6)">Inactive</option>
