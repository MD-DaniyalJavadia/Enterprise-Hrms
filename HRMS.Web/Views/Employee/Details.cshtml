@model EmployeeProfileViewModel
@{
    var e = Model.Employee;
    ViewData["Title"] = e.FullName;
    ViewData["BreadcrumbParent"] = "Employees";
    var canManage = User.HasPermission("EMPLOYEE.MANAGE");

    var statusBadgeClass = e.EmploymentStatus switch
    {
        1 => "bg-success-subtle text-success-emphasis",
        2 => "bg-info-subtle text-info-emphasis",
        3 => "bg-warning-subtle text-warning-emphasis",
        4 or 5 => "bg-danger-subtle text-danger-emphasis",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };

    string MaskAccount(string? account)
    {
        if (string.IsNullOrWhiteSpace(account)) return "-";
        var trimmed = account.Trim();
        return trimmed.Length <= 4 ? "****" : $"****{trimmed[^4..]}";
    }
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
        <a asp-action="IdCard" asp-route-id="@e.EmployeeId" class="btn btn-outline-secondary btn-sm"><i class="bi bi-person-badge me-1"></i>ID Card</a>
        @if (canManage)
        {
            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#careerActionModal">
                <i class="bi bi-briefcase me-1"></i>Career Action
            </button>
            <a asp-action="Edit" asp-route-id="@e.EmployeeId" class="btn btn-primary btn-sm"><i class="bi bi-pencil me-1"></i>Edit Profile</a>
        }
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                @if (!string.IsNullOrEmpty(e.PhotoPath))
                {
                    <img src="@e.PhotoPath" alt="@e.FullName" class="rounded-circle object-fit-cover border shadow-sm" style="width:76px;height:76px;" />
                }
                else
                {
                    <div class="hrms-avatar shadow-sm" style="width:76px;height:76px;font-size:1.5rem;">
                        @string.Join("", e.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])))
                    </div>
                }
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <h2 class="h4 fw-bold mb-0">@e.FullName</h2>
                        <span class="badge bg-primary-subtle text-primary-emphasis">@e.EmployeeCode</span>
                        <span class="badge @statusBadgeClass">@e.StatusLabel</span>
                    </div>
                    <div class="text-body-secondary small mb-2">
                        <span class="fw-semibold text-body">@e.DesignationTitle</span>
                        <span class="mx-1">&bull;</span> @e.DepartmentName
                        <span class="mx-1">&bull;</span> @e.BranchName
                    </div>
                    <div class="d-flex flex-wrap gap-3 small text-body-secondary">
                        <span><i class="bi bi-envelope me-1"></i>@e.WorkEmail</span>
                        <span><i class="bi bi-telephone me-1"></i>@(e.MobilePhone ?? e.Phone ?? "-")</span>
                        <span><i class="bi bi-person-check me-1"></i>Manager: @(e.ReportingManagerName ?? "Executive / None")</span>
                        <span><i class="bi bi-calendar-event me-1"></i>Hired @e.HireDate.ToString("MMM dd, yyyy")</span>
                    </div>
                </div>
            </div>
            <div class="text-md-end border-top border-md-top-0 pt-3 pt-md-0">
                <div class="small text-body-secondary">Base Compensation</div>
                <div class="fs-5 fw-bold text-primary">@e.BaseSalary.ToString("C")</div>
                <div class="small text-body-secondary">@(e.ShiftName ?? "Standard Shift")</div>
            </div>
        </div>
    </div>
</div>

<ul class="nav nav-tabs mb-3" id="empProfileTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#tab-overview" type="button" role="tab">
            <i class="bi bi-person-lines-fill me-1"></i>Overview &amp; Work
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="family-tab" data-bs-toggle="tab" data-bs-target="#tab-family" type="button" role="tab">
            <i class="bi bi-people me-1"></i>Emergency &amp; Family
            <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">@(Model.EmergencyContacts.Count + Model.FamilyMembers.Count)</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="qualifications-tab" data-bs-toggle="tab" data-bs-target="#tab-qualifications" type="button" role="tab">
            <i class="bi bi-mortarboard me-1"></i>Education &amp; Experience
            <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">@(Model.EducationHistory.Count + Model.ExperienceHistory.Count)</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="skills-tab" data-bs-toggle="tab" data-bs-target="#tab-skills" type="button" role="tab">
            <i class="bi bi-award me-1"></i>Skills &amp; Certifications
            <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">@Model.Skills.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="documents-tab" data-bs-toggle="tab" data-bs-target="#tab-documents" type="button" role="tab">
            <i class="bi bi-folder2-open me-1"></i>Documents
            <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">@Model.Documents.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="timeline-tab" data-bs-toggle="tab" data-bs-target="#tab-timeline" type="button" role="tab">
            <i class="bi bi-clock-history me-1"></i>Timeline &amp; Salary History
        </button>
    </li>
</ul>

<div class="tab-content" id="empProfileTabContent">
    <!-- Tab 1: Overview & Work -->
    <div class="tab-pane fade show active" id="tab-overview" role="tabpanel">
        <div class="row g-3">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent fw-semibold py-3">Personal &amp; Contact Information</div>
                    <div class="card-body">
                        <dl class="row small mb-0">
                            <dt class="col-sm-4 text-body-secondary">Full Legal Name</dt>
                            <dd class="col-sm-8">@string.Join(" ", new[] { e.FirstName, e.MiddleName, e.LastName }.Where(x => !string.IsNullOrWhiteSpace(x)))</dd>

                            <dt class="col-sm-4 text-body-secondary">Gender / DOB</dt>
                            <dd class="col-sm-8">@e.Gender &bull; @e.DateOfBirth.ToString("MMM dd, yyyy")</dd>

                            <dt class="col-sm-4 text-body-secondary">Marital Status</dt>
                            <dd class="col-sm-8">@(e.MaritalStatus ?? "-")</dd>

                            <dt class="col-sm-4 text-body-secondary">Blood Group</dt>
                            <dd class="col-sm-8">@(e.BloodGroup ?? "-")</dd>

                            <dt class="col-sm-4 text-body-secondary">Nationality</dt>
                            <dd class="col-sm-8">@(e.Nationality ?? "-")</dd>

                            <dt class="col-sm-4 text-body-secondary">National ID / Passport</dt>
                            <dd class="col-sm-8">@(e.NationalIdNumber ?? "-")</dd>

                            <dt class="col-sm-4 text-body-secondary">Personal Email</dt>
                            <dd class="col-sm-8">@(e.PersonalEmail ?? "-")</dd>

                            <dt class="col-sm-4 text-body-secondary">Work / Mobile Phone</dt>
                            <dd class="col-sm-8">@(e.Phone ?? "-") / @(e.MobilePhone ?? "-")</dd>

                            <dt class="col-sm-4 text-body-secondary">Current Address</dt>
                            <dd class="col-sm-8">@(e.CurrentAddress ?? "-")</dd>

                            <dt class="col-sm-4 text-body-secondary">Permanent Address</dt>
                            <dd class="col-sm-8">@(e.PermanentAddress ?? "-")</dd>

                            <dt class="col-sm-4 text-body-secondary">City / Country</dt>
                            <dd class="col-sm-8 mb-0">@(e.City ?? "-") / @(e.Country ?? "-")</dd>
                        </dl>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-transparent fw-semibold py-3">Work &amp; Organizational Placement</div>
                    <div class="card-body">
                        <dl class="row small mb-0">
                            <dt class="col-sm-4 text-body-secondary">Company</dt>
                            <dd class="col-sm-8">@e.CompanyName</dd>

                            <dt class="col-sm-4 text-body-secondary">Branch</dt>
                            <dd class="col-sm-8">@e.BranchName</dd>

                            <dt class="col-sm-4 text-body-secondary">Department</dt>
                            <dd class="col-sm-8">@e.DepartmentName</dd>

                            <dt class="col-sm-4 text-body-secondary">Designation</dt>
                            <dd class="col-sm-8">@e.DesignationTitle</dd>

                            <dt class="col-sm-4 text-body-secondary">Job Position</dt>
                            <dd class="col-sm-8">@(e.JobPositionTitle ?? "-")</dd>

                            <dt class="col-sm-4 text-body-secondary">Work Location</dt>
                            <dd class="col-sm-8">@(e.WorkLocationName ?? "-")</dd>

                            <dt class="col-sm-4 text-body-secondary">Assigned Shift</dt>
                            <dd class="col-sm-8">@(e.ShiftName ?? "Default Shift")</dd>

                            <dt class="col-sm-4 text-body-secondary">Confirmation Date</dt>
                            <dd class="col-sm-8">@(e.ConfirmationDate?.ToString("MMM dd, yyyy") ?? "Pending / N/A")</dd>

                            @if (e.ExitDate.HasValue)
                            {
                                <dt class="col-sm-4 text-body-secondary">Exit Date</dt>
                                <dd class="col-sm-8 mb-0 text-danger fw-semibold">@e.ExitDate.Value.ToString("MMM dd, yyyy")</dd>
                            }
                        </dl>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent fw-semibold py-3">Bank &amp; Tax Information</div>
                    <div class="card-body">
                        <dl class="row small mb-0">
                            <dt class="col-sm-4 text-body-secondary">Bank Name</dt>
                            <dd class="col-sm-8">@(e.BankName ?? "-")</dd>

                            <dt class="col-sm-4 text-body-secondary">Account Title</dt>
                            <dd class="col-sm-8">@(e.BankAccountTitle ?? "-")</dd>

                            <dt class="col-sm-4 text-body-secondary">Account / IBAN</dt>
                            <dd class="col-sm-8">@MaskAccount(e.BankAccountNumber)</dd>

                            <dt class="col-sm-4 text-body-secondary">Routing / SWIFT</dt>
                            <dd class="col-sm-8">@(e.BankRoutingCode ?? "-")</dd>

                            <dt class="col-sm-4 text-body-secondary">Tax ID / Filing</dt>
                            <dd class="col-sm-8 mb-0">@(e.TaxIdentificationNumber ?? "-") &bull; @(e.TaxFilingStatus ?? "-")</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab 2: Emergency Contacts & Family -->
    <div class="tab-pane fade" id="tab-family" role="tabpanel">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
                <span class="fw-semibold">Emergency Contacts</span>
                @if (canManage)
                {
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#emergencyModal">
                        <i class="bi bi-plus-lg me-1"></i>Add Emergency Contact
                    </button>
                }
            </div>
            <div class="card-body">
                @if (!Model.EmergencyContacts.Any())
                {
                    <p class="text-body-secondary small mb-0">No emergency contacts recorded yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle small mb-0">
                            <thead>
                                <tr>
                                    <th>Contact Name</th>
                                    <th>Relationship</th>
                                    <th>Primary Phone</th>
                                    <th>Alternate Phone</th>
                                    <th>Address</th>
                                    <th>Priority</th>
                                    @if (canManage) { <th class="text-end">Action</th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.EmergencyContacts)
                                {
                                    <tr>
                                        <td class="fw-semibold">@c.ContactName</td>
                                        <td>@c.Relationship</td>
                                        <td>@c.PrimaryPhone</td>
                                        <td>@(c.AlternatePhone ?? "-")</td>
                                        <td>@(c.Address ?? "-")</td>
                                        <td>
                                            @if (c.IsPrimary)
                                            {
                                                <span class="badge bg-primary-subtle text-primary-emphasis">Primary</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary-emphasis">Secondary</span>
                                            }
                                        </td>
                                        @if (canManage)
                                        {
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="HrmsEmp.deleteSubItem('@Url.Action("DeleteEmergencyContact", new { id = c.EmergencyContactId })', 'Emergency Contact')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
                <span class="fw-semibold">Family &amp; Dependents</span>
                @if (canManage)
                {
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#familyModal">
                        <i class="bi bi-plus-lg me-1"></i>Add Family Member
                    </button>
                }
            </div>
            <div class="card-body">
                @if (!Model.FamilyMembers.Any())
                {
                    <p class="text-body-secondary small mb-0">No family members recorded yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle small mb-0">
                            <thead>
                                <tr>
                                    <th>Full Name</th>
                                    <th>Relationship</th>
                                    <th>Date of Birth</th>
                                    <th>Contact Phone</th>
                                    <th>Dependent</th>
                                    @if (canManage) { <th class="text-end">Action</th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in Model.FamilyMembers)
                                {
                                    <tr>
                                        <td class="fw-semibold">@f.FullName</td>
                                        <td>@f.Relationship</td>
                                        <td>@(f.DateOfBirth?.ToString("MMM dd, yyyy") ?? "-")</td>
                                        <td>@(f.ContactPhone ?? "-")</td>
                                        <td>
                                            @if (f.IsDependent)
                                            {
                                                <span class="badge bg-info-subtle text-info-emphasis">Dependent</span>
                                            }
                                            else
                                            {
                                                <span class="text-body-secondary">No</span>
                                            }
                                        </td>
                                        @if (canManage)
                                        {
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="HrmsEmp.deleteSubItem('@Url.Action("DeleteFamilyMember", new { id = f.FamilyMemberId })', 'Family Member')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Tab 3: Education & Experience -->
    <div class="tab-pane fade" id="tab-qualifications" role="tabpanel">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
                <span class="fw-semibold">Education History</span>
                @if (canManage)
                {
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#educationModal">
                        <i class="bi bi-plus-lg me-1"></i>Add Education
                    </button>
                }
            </div>
            <div class="card-body">
                @if (!Model.EducationHistory.Any())
                {
                    <p class="text-body-secondary small mb-0">No education records added.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle small mb-0">
                            <thead>
                                <tr>
                                    <th>Degree / Qualification</th>
                                    <th>Institution</th>
                                    <th>Field of Study</th>
                                    <th>Years</th>
                                    <th>Grade / GPA</th>
                                    @if (canManage) { <th class="text-end">Action</th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var edu in Model.EducationHistory)
                                {
                                    <tr>
                                        <td class="fw-semibold">@edu.DegreeTitle</td>
                                        <td>@edu.InstitutionName</td>
                                        <td>@(edu.FieldOfStudy ?? "-")</td>
                                        <td>@(edu.StartYear?.ToString() ?? "?") - @(edu.CompletionYear?.ToString() ?? "Present")</td>
                                        <td>@(edu.GradeOrGpa ?? "-")</td>
                                        @if (canManage)
                                        {
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="HrmsEmp.deleteSubItem('@Url.Action("DeleteEducation", new { id = edu.EducationId })', 'Education Record')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
                <span class="fw-semibold">Previous Work Experience</span>
                @if (canManage)
                {
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#experienceModal">
                        <i class="bi bi-plus-lg me-1"></i>Add Experience
                    </button>
                }
            </div>
            <div class="card-body">
                @if (!Model.ExperienceHistory.Any())
                {
                    <p class="text-body-secondary small mb-0">No prior work experience recorded.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle small mb-0">
                            <thead>
                                <tr>
                                    <th>Employer</th>
                                    <th>Job Title</th>
                                    <th>Duration</th>
                                    <th>Responsibilities</th>
                                    @if (canManage) { <th class="text-end">Action</th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var exp in Model.ExperienceHistory)
                                {
                                    <tr>
                                        <td class="fw-semibold">@exp.EmployerName</td>
                                        <td>@exp.JobTitle</td>
                                        <td>@exp.StartDate.ToString("MMM yyyy") - @(exp.EndDate?.ToString("MMM yyyy") ?? "Present")</td>
                                        <td>@(exp.Responsibilities ?? "-")</td>
                                        @if (canManage)
                                        {
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="HrmsEmp.deleteSubItem('@Url.Action("DeleteExperience", new { id = exp.ExperienceId })', 'Experience Record')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Tab 4: Skills & Certifications -->
    <div class="tab-pane fade" id="tab-skills" role="tabpanel">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
                <span class="fw-semibold">Skills &amp; Professional Certifications</span>
                @if (canManage)
                {
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#skillModal">
                        <i class="bi bi-plus-lg me-1"></i>Add Skill / Certification
                    </button>
                }
            </div>
            <div class="card-body">
                @if (!Model.Skills.Any())
                {
                    <p class="text-body-secondary small mb-0">No skills or certifications recorded yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle small mb-0">
                            <thead>
                                <tr>
                                    <th>Skill</th>
                                    <th>Proficiency</th>
                                    <th>Certification</th>
                                    <th>Issuing Authority</th>
                                    <th>Expiry</th>
                                    @if (canManage) { <th class="text-end">Action</th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sk in Model.Skills)
                                {
                                    <tr>
                                        <td class="fw-semibold">@sk.SkillName</td>
                                        <td><span class="badge bg-primary-subtle text-primary-emphasis">@sk.ProficiencyLevel</span></td>
                                        <td>@(sk.CertificationName ?? "-")</td>
                                        <td>@(sk.IssuingAuthority ?? "-")</td>
                                        <td>@(sk.ExpiryDate?.ToString("MMM dd, yyyy") ?? "No Expiry")</td>
                                        @if (canManage)
                                        {
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="HrmsEmp.deleteSubItem('@Url.Action("DeleteSkill", new { id = sk.SkillId })', 'Skill')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Tab 5: Documents & Attachments -->
    <div class="tab-pane fade" id="tab-documents" role="tabpanel">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
                <span class="fw-semibold">Employee Documents Vault</span>
                @if (canManage)
                {
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#documentModal">
                        <i class="bi bi-cloud-upload me-1"></i>Upload Document
                    </button>
                }
            </div>
            <div class="card-body">
                @if (!Model.Documents.Any())
                {
                    <p class="text-body-secondary small mb-0">No documents uploaded yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle small mb-0">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Type</th>
                                    <th>Original File</th>
                                    <th>Size</th>
                                    <th>Expiry</th>
                                    <th>Uploaded</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in Model.Documents)
                                {
                                    <tr>
                                        <td class="fw-semibold">@doc.DocumentTitle</td>
                                        <td><span class="badge bg-secondary-subtle text-secondary-emphasis">@doc.DocumentType</span></td>
                                        <td>@doc.OriginalFileName</td>
                                        <td>@($"{Math.Max(1, doc.FileSizeBytes / 1024)} KB")</td>
                                        <td>@(doc.ExpiryDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                                        <td>@doc.CreatedDate.ToString("MMM dd, yyyy")</td>
                                        <td class="text-end text-nowrap">
                                            <a asp-action="DownloadDocument" asp-route-id="@doc.DocumentId" class="btn btn-sm btn-outline-primary" title="Download">
                                                <i class="bi bi-download"></i>
                                            </a>
                                            @if (canManage)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="HrmsEmp.deleteSubItem('@Url.Action("DeleteDocument", new { id = doc.DocumentId })', 'Document')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Tab 6: Employment & Salary Timeline -->
    <div class="tab-pane fade" id="tab-timeline" role="tabpanel">
        <div class="row g-3">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
                        <span class="fw-semibold">Employment History Timeline</span>
                        @if (canManage)
                        {
                            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#careerActionModal">
                                <i class="bi bi-plus-lg me-1"></i>Record Action
                            </button>
                        }
                    </div>
                    <div class="card-body">
                        @if (!Model.EmploymentTimeline.Any())
                        {
                            <p class="text-body-secondary small mb-0">No employment timeline events recorded.</p>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var item in Model.EmploymentTimeline)
                                {
                                    <div class="list-group-item px-0 py-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="badge bg-primary-subtle text-primary-emphasis">@item.EventType</span>
                                            <span class="small text-body-secondary">@item.EffectiveDate.ToString("MMM dd, yyyy")</span>
                                        </div>
                                        <div class="small fw-semibold">
                                            @if (!string.IsNullOrEmpty(item.FromDesignation) && item.FromDesignation != item.ToDesignation)
                                            {
                                                <span>@item.FromDesignation &rarr; @item.ToDesignation</span>
                                            }
                                            else
                                            {
                                                <span>@(item.ToDesignation ?? "-")</span>
                                            }
                                            <span class="text-body-secondary fw-normal">
                                                (@(item.ToDepartmentName ?? "-") / @(item.ToBranchName ?? "-"))
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.Remarks))
                                        {
                                            <div class="small text-body-secondary mt-1">@item.Remarks</div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent fw-semibold py-3">Salary Revision History</div>
                    <div class="card-body">
                        @if (!Model.SalaryHistory.Any())
                        {
                            <p class="text-body-secondary small mb-0">No salary revisions recorded.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle small mb-0">
                                    <thead>
                                        <tr>
                                            <th>Effective</th>
                                            <th>Previous</th>
                                            <th>New</th>
                                            <th>Reason</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var sal in Model.SalaryHistory)
                                        {
                                            <tr>
                                                <td>@sal.EffectiveDate.ToString("MMM dd, yyyy")</td>
                                                <td class="text-body-secondary">@sal.PreviousSalary.ToString("C")</td>
                                                <td class="fw-semibold text-success">@sal.NewSalary.ToString("C")</td>
                                                <td>@sal.ChangeReason</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (canManage)
