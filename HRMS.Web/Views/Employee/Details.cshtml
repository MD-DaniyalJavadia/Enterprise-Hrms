                                <select name="ActionType" class="form-select" required>
                                    <option value="Promotion">Promotion</option>
                                    <option value="Transfer">Branch / Department Transfer</option>
                                    <option value="SalaryRevision">Salary Revision</option>
                                    <option value="Confirmation">Confirmation</option>
                                    <option value="StatusChange">Employment Status Change</option>
                                </select>
                            </div>
                            <div class="col-md-6">
