@model EmployeeImportResultViewModel
@{
    ViewData["Title"] = "Bulk Employee Import";
    ViewData["BreadcrumbParent"] = "Employees";
}

@section PageActions {
    <a asp-action="DownloadImportTemplate" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-download me-1"></i>Download CSV Template
    </a>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-transparent border-bottom py-3">
        <h2 class="h6 fw-bold mb-0"><i class="bi bi-file-earmark-arrow-up me-2 text-primary"></i>Import Employees from CSV / Excel Export</h2>
    </div>
    <div class="card-body p-4">
        <p class="small text-body-secondary mb-3">
            Upload a UTF-8 CSV file with columns:
            <code>EmployeeCode,FirstName,LastName,Gender,DateOfBirth,WorkEmail,HireDate,BranchCode,DepartmentCode,DesignationCode,BaseSalary</code>
        </p>

        <form asp-action="Import" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Select CSV File</label>
                    <input type="file" name="csvFile" class="form-control" accept=".csv" required />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-upload me-1"></i>Run Import</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.TotalRowsProcessed > 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <h3 class="h6 fw-bold mb-3">Import Summary</h3>
            <div class="d-flex gap-4 mb-3">
                <div>Processed: <strong>@Model.TotalRowsProcessed</strong></div>
                <div class="text-success">Imported: <strong>@Model.ImportedCount</strong></div>
                <div class="text-danger">Errors: <strong>@Model.RowErrors.Count</strong></div>
            </div>
            @if (Model.RowErrors.Any())
            {
                <ul class="list-group list-group-flush small">
                    @foreach (var err in Model.RowErrors)
                    {
                        <li class="list-group-item text-danger"><i class="bi bi-exclamation-circle me-1"></i>@err</li>
                    }
                </ul>
            }
        </div>
    </div>
}
