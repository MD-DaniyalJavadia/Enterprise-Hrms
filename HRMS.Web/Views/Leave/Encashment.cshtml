@model LeaveEncashmentPageViewModel
@{
    ViewData["Title"] = "Leave Encashment";
    ViewData["BreadcrumbParent"] = "Leave Management";
    var canManage = User.HasPermission("LEAVE.MANAGE");
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Balances" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-wallet2 me-1"></i>Balances
        </a>
        @if ((canManage || Model.CurrentUserEmployeeId.HasValue) && Model.EncashableTypes.Any())
        {
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#encashmentModal">
                <i class="bi bi-coin me-1"></i>Request Encashment
            </button>
        }
    </div>
}

<!-- Filter Strip -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Approval Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="Pending" selected="@(Model.FilterStatus == "Pending")">Pending</option>
                    <option value="Approved" selected="@(Model.FilterStatus == "Approved")">Approved</option>
                    <option value="Rejected" selected="@(Model.FilterStatus == "Rejected")">Rejected</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Encashment" class="btn btn-outline-secondary btn-sm" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Encashment Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-leave-datatable w-100">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Department</th>
                        <th>Leave Type</th>
                        <th>Year</th>
                        <th class="text-end">Days</th>
                        <th class="text-end">Estimated Payout</th>
                        <th>Remarks</th>
                        <th>Status</th>
                        @if (canManage)
                        {
                            <th class="text-end">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Encashments)
                    {
                        var badge = item.ApprovalStatus switch
                        {
                            "Approved" => "bg-success-subtle text-success-emphasis",
                            "Rejected" => "bg-danger-subtle text-danger-emphasis",
                            _ => "bg-warning-subtle text-warning-emphasis"
                        };
                        <tr>
                            <td>
                                <div class="fw-semibold">@item.FullName</div>
                                <div class="small text-body-secondary">@item.EmployeeCode</div>
                            </td>
                            <td>@item.DepartmentName</td>
                            <td>@item.LeaveName</td>
                            <td>@item.LeaveYear</td>
                            <td class="text-end fw-semibold">@item.DaysEncashed.ToString("0.##")</td>
                            <td class="text-end fw-semibold">@item.EncashmentAmount.ToString("N2")</td>
                            <td class="small">
                                <div>@(item.Remarks ?? "-")</div>
                                @if (!string.IsNullOrWhiteSpace(item.ReviewerComments))
                                {
                                    <div class="text-body-secondary">Review: @item.ReviewerComments</div>
                                }
                            </td>
                            <td>
                                <span class="badge @badge">@item.ApprovalStatus</span>
                                @if (!string.IsNullOrWhiteSpace(item.ReviewedByName))
                                {
                                    <div class="text-body-secondary" style="font-size: 0.72rem;">by @item.ReviewedByName</div>
                                }
                            </td>
                            @if (canManage)
                            {
                                <td class="text-end text-nowrap">
                                    @if (item.ApprovalStatus == "Pending")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success" title="Approve"
                                                onclick='HrmsLeave.reviewEncashment(@item.EncashmentId, "Approved", @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.FullName)))'>
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Reject"
                                                onclick='HrmsLeave.reviewEncashment(@item.EncashmentId, "Rejected", @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.FullName)))'>
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="small text-body-secondary">-</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if ((canManage || Model.CurrentUserEmployeeId.HasValue) && Model.EncashableTypes.Any())
{
    <div class="modal fade" id="encashmentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-coin me-2 text-primary"></i>Submit Leave Encashment Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="encashmentForm" onsubmit="event.preventDefault(); HrmsLeave.submitAjaxForm('#encashmentForm', '@Url.Action("SubmitEncashment")', '#encashmentModal');">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Employee</label>
                                @if (canManage)
                                {
                                    <select name="EmployeeId" class="form-select" required>
                                        <option value="">Select Employee...</option>
                                        @foreach (var emp in Model.Employees)
                                        {
                                            <option value="@emp.EmployeeId" selected="@(Model.CurrentUserEmployeeId == emp.EmployeeId)">@emp.EmployeeCode - @emp.FullName</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input type="hidden" name="EmployeeId" value="@Model.CurrentUserEmployeeId" />
                                    <input type="text" class="form-control" value="@User.GetFullName()" readonly />
                                }
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Encashable Leave Type</label>
                                <select name="LeaveTypeId" class="form-select" required>
                                    @foreach (var lt in Model.EncashableTypes)
                                    {
                                        <option value="@lt.LeaveTypeId">@lt.LeaveName (@lt.LeaveCode)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Year</label>
                                <input type="number" name="LeaveYear" class="form-control" value="@DateTime.Today.Year" min="2020" max="2040" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Days</label>
                                <input type="number" step="0.5" min="0.5" max="90" name="DaysEncashed" class="form-control" value="1" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Remarks</label>
                                <textarea name="Remarks" class="form-control" rows="2" maxlength="300" placeholder="Optional reason or notes..."></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Submit Request</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/leave.js" asp-append-version="true"></script>
}
