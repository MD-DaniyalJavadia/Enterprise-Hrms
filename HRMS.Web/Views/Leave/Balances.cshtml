@model LeaveBalancesPageViewModel
@{
    ViewData["Title"] = "Leave Balances";
    ViewData["BreadcrumbParent"] = "Leave Management";
    var canManage = User.HasPermission("LEAVE.MANAGE");
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-card-checklist me-1"></i>Applications
        </a>
        <a asp-action="ExportBalances"
           asp-route-year="@Model.LeaveYear"
           asp-route-employeeId="@Model.EmployeeId"
           asp-route-departmentId="@Model.DepartmentId"
           class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export CSV
        </a>
        @if (canManage)
        {
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#allocateModal">
                <i class="bi bi-calendar-plus me-1"></i>Allocate Annual Quota
            </button>
        }
    </div>
}

<!-- Filter Strip -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Leave Year</label>
                <select name="year" class="form-select form-select-sm">
                    @for (int y = DateTime.Today.Year - 2; y <= DateTime.Today.Year + 1; y++)
                    {
                        <option value="@y" selected="@(Model.LeaveYear == y)">@y</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Employee</label>
                <select name="employeeId" class="form-select form-select-sm hrms-select2">
                    <option value="">All Employees</option>
                    @foreach (var emp in Model.Employees)
                    {
                        <option value="@emp.EmployeeId" selected="@(Model.EmployeeId == emp.EmployeeId)">@emp.EmployeeCode - @emp.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Department</label>
                <select name="departmentId" class="form-select form-select-sm">
                    <option value="">All Departments</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.DepartmentId" selected="@(Model.DepartmentId == d.DepartmentId)">@d.DepartmentName</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Balances" class="btn btn-outline-secondary btn-sm" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Balances Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-leave-datatable w-100">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Department</th>
                        <th>Leave Type</th>
                        <th class="text-end">Opening</th>
                        <th class="text-end">Accrued</th>
                        <th class="text-end">Carry Fwd</th>
                        <th class="text-end">Used</th>
                        <th class="text-end">Pending</th>
                        <th class="text-end">Encashed</th>
                        <th class="text-end">Available</th>
                        @if (canManage)
                        {
                            <th class="text-end">Action</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Balances)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@b.FullName</div>
                                <div class="small text-body-secondary">@b.EmployeeCode</div>
                            </td>
                            <td>@b.DepartmentName</td>
                            <td>
                                <span class="badge text-white" style="background-color: @b.ColorHex">@b.LeaveCode</span>
                                <span class="small ms-1">@b.LeaveName</span>
                            </td>
                            <td class="text-end">@b.OpeningBalance.ToString("0.##")</td>
                            <td class="text-end">@b.AccruedDays.ToString("0.##")</td>
                            <td class="text-end">@b.CarryForwardDays.ToString("0.##")</td>
                            <td class="text-end text-danger fw-medium">@b.UsedDays.ToString("0.##")</td>
                            <td class="text-end text-warning fw-medium">@b.PendingDays.ToString("0.##")</td>
                            <td class="text-end text-info fw-medium">@b.EncashedDays.ToString("0.##")</td>
                            <td class="text-end fw-bold @(b.AvailableDays > 0 ? "text-success" : "text-body-secondary")">@b.AvailableDays.ToString("0.##")</td>
                            @if (canManage)
                            {
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary" title="Adjust Balance"
                                            onclick='HrmsLeave.openAdjustBalanceModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                                                leaveBalanceId = b.LeaveBalanceId,
                                                employeeCode = b.EmployeeCode,
                                                fullName = b.FullName,
                                                leaveName = b.LeaveName,
                                                openingBalance = b.OpeningBalance,
                                                accruedDays = b.AccruedDays,
                                                carryForwardDays = b.CarryForwardDays
                                            })))'>
                                        <i class="bi bi-sliders"></i>
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (canManage)
{
    <!-- Allocate Annual Quota Modal -->
    <div class="modal fade" id="allocateModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-calendar-plus me-2 text-primary"></i>Allocate Annual Leave Quota</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="allocateForm" onsubmit="event.preventDefault(); HrmsLeave.submitAjaxForm('#allocateForm', '@Url.Action("AllocateAnnual")', '#allocateModal');">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Target Leave Year</label>
                            <input type="number" name="leaveYear" class="form-control" value="@Model.LeaveYear" min="2020" max="2040" required />
                        </div>
                        <div class="form-check form-switch">
                            <input id="chkCarryFwd" class="form-check-input" type="checkbox" name="includeCarryForward" value="true" checked />
                            <input type="hidden" name="includeCarryForward" value="false" />
                            <label class="form-check-label small fw-semibold" for="chkCarryFwd">
                                Carry forward unused days from @(Model.LeaveYear - 1) (up to policy limit)
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Run Allocation</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Adjust Balance Modal -->
    <div class="modal fade" id="adjustBalanceModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Adjust Employee Leave Balance</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="adjustBalanceForm" onsubmit="event.preventDefault(); HrmsLeave.submitAjaxForm('#adjustBalanceForm', '@Url.Action("AdjustBalance")', '#adjustBalanceModal');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="adjBalanceId" name="LeaveBalanceId" value="0" />
                    <div class="modal-body">
                        <div class="alert alert-light border small mb-3">
                            <strong id="adjEmployeeLabel">-</strong>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Opening</label>
                                <input id="adjOpening" type="number" step="0.5" min="0" max="365" name="OpeningBalance" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Accrued</label>
                                <input id="adjAccrued" type="number" step="0.5" min="0" max="365" name="AccruedDays" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Carry Forward</label>
                                <input id="adjCarry" type="number" step="0.5" min="0" max="365" name="CarryForwardDays" class="form-control" required />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Adjustment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/leave.js" asp-append-version="true"></script>
}
