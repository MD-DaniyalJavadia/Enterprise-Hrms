@model EssDashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Employee Self-Service";
    ViewData["BreadcrumbParent"] = "Self-Service Portal";
    var jsonOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var p = Model.Profile;
    var att = Model.TodayAttendance;
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2 align-items-center">
        @if (Model.IsSuperAdminPreview && Model.PreviewEmployees.Any())
        {
            <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
                <select name="previewEmployeeId" class="form-select form-select-sm" onchange="this.form.submit()">
                    @foreach (var emp in Model.PreviewEmployees)
                    {
                        <option value="@emp.EmployeeId" selected="@(p?.EmployeeId == emp.EmployeeId)">@emp.EmployeeCode - @emp.FullName</option>
                    }
                </select>
            </form>
        }
        @if (Model.HasEmployeeProfile && p != null)
        {
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#essApplyLeaveModal">
                <i class="bi bi-calendar-plus me-1"></i>Apply Leave
            </button>
            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#essSubmitExpenseModal">
                <i class="bi bi-receipt me-1"></i>Expense Claim
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#essSubmitLoanModal">
                <i class="bi bi-bank me-1"></i>Loan / Advance
            </button>
        }
    </div>
}

@if (!Model.HasEmployeeProfile || p is null)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-5 text-center">
            <div class="display-5 text-primary mb-3"><i class="bi bi-person-badge"></i></div>
            <h5 class="fw-bold mb-2">No Employee Profile Linked</h5>
            <p class="text-body-secondary mb-3">Your user account does not have an active employee profile linked yet. Contact HR to associate your Employee ID with your login account.</p>
            @if (User.HasPermission("EMPLOYEE.VIEW"))
            {
                <a asp-controller="Employee" asp-action="Index" class="btn btn-primary btn-sm">Open Employee Master</a>
            }
        </div>
    </div>
}
else
{
    <!-- Hero Employee Strip & Quick Attendance Punch -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="row g-4 align-items-center">
                <div class="col-lg-7">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold fs-4 flex-shrink-0" style="width:64px;height:64px;">
                            @if (!string.IsNullOrWhiteSpace(p.PhotoPath))
                            {
                                <img src="@p.PhotoPath" alt="@p.FullName" class="rounded-circle object-fit-cover w-100 h-100" />
                            }
                            else
                            {
                                @(string.Concat(p.FirstName.Take(1), p.LastName.Take(1)).ToUpperInvariant())
                            }
                        </div>
                        <div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <h4 class="fw-bold mb-0">@p.FullName</h4>
                                <span class="badge bg-primary-subtle text-primary-emphasis">@p.EmployeeCode</span>
                                <span class="badge bg-success-subtle text-success-emphasis">@p.ShiftName (@p.ShiftStartTime - @p.ShiftEndTime)</span>
                            </div>
                            <div class="text-body-secondary small mt-1">
                                @p.DesignationTitle &bull; @p.DepartmentName &bull; @p.BranchName
                            </div>
                            <div class="small text-body-secondary mt-1">
                                Reporting Manager: <strong>@(p.ReportingManagerName ?? "Executive Leadership")</strong> &bull; Work Email: @p.WorkEmail
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="p-3 rounded-3 bg-body-tertiary border d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <div class="small text-uppercase fw-bold text-body-secondary">Today's Attendance (@DateTime.Today.ToString("dd MMM yyyy"))</div>
                            @if (att is null)
                            {
                                <div class="fw-semibold text-warning mt-1"><i class="bi bi-clock me-1"></i>Not Checked In Yet</div>
                            }
                            else
                            {
                                <div class="fw-semibold mt-1">
                                    In: @(att.CheckInTime?.ToString("HH:mm") ?? "-") &bull;
                                    Out: @(att.CheckOutTime?.ToString("HH:mm") ?? "-") &bull;
                                    <span class="badge bg-info-subtle text-info-emphasis">@att.Status</span>
                                </div>
                                <div class="small text-body-secondary">Worked: @att.WorkHoursFormatted @(att.LateMinutes > 0 ? $"• Late {att.LateMinutes}m" : "")</div>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            @if (att?.CheckInTime is null)
                            {
                                <button type="button" class="btn btn-success btn-sm" onclick="HrmsPortal.quickPunch('/SelfService/QuickCheckIn', @p.EmployeeId)">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Check In
                                </button>
                            }
                            else if (att.CheckOutTime is null)
                            {
                                <button type="button" class="btn btn-warning btn-sm" onclick="HrmsPortal.quickPunch('/SelfService/QuickCheckOut', @p.EmployeeId)">
                                    <i class="bi bi-box-arrow-right me-1"></i>Check Out
                                </button>
                            }
                            else
                            {
                                <span class="badge bg-success py-2 px-3"><i class="bi bi-check-circle me-1"></i>Completed</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Leave Balance Cards -->
    <div class="row g-3 mb-4">
        @if (Model.LeaveBalances.Any())
        {
            @foreach (var lb in Model.LeaveBalances)
            {
                <div class="col-md-6 col-xl-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="small fw-semibold text-body-secondary">@lb.LeaveName (@lb.LeaveCode)</span>
                                <span class="badge rounded-pill" style="background-color:@lb.ColorHex;">@lb.LeaveYear</span>
                            </div>
                            <div class="fs-3 fw-bold">@lb.AvailableDays.ToString("0.#") <span class="fs-6 fw-normal text-body-secondary">days left</span></div>
                            <div class="small text-body-secondary mt-1">
                                Used: @lb.UsedDays.ToString("0.#") &bull; Pending: @lb.PendingDays.ToString("0.#") &bull; Quota: @((lb.OpeningBalance + lb.AccruedDays + lb.CarryForwardDays).ToString("0.#"))
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info mb-0 small">No leave balances allocated for @DateTime.Today.Year yet.</div>
            </div>
        }
    </div>

    <!-- Navigation Quick Tiles -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <a asp-action="MyProfile" asp-route-previewEmployeeId="@(Model.IsSuperAdminPreview ? p.EmployeeId : null)" class="card border-0 shadow-sm text-decoration-none h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="p-3 rounded-3 bg-primary-subtle text-primary"><i class="bi bi-person-vcard fs-4"></i></div>
                    <div>
                        <div class="fw-bold text-body">My 360° Profile</div>
                        <div class="small text-body-secondary">Bio, bank &amp; change requests</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-action="MyAttendance" asp-route-previewEmployeeId="@(Model.IsSuperAdminPreview ? p.EmployeeId : null)" class="card border-0 shadow-sm text-decoration-none h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="p-3 rounded-3 bg-success-subtle text-success"><i class="bi bi-clock-history fs-4"></i></div>
                    <div>
                        <div class="fw-bold text-body">My Attendance</div>
                        <div class="small text-body-secondary">Logs, regularizations &amp; OT</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-action="MyPayslips" asp-route-previewEmployeeId="@(Model.IsSuperAdminPreview ? p.EmployeeId : null)" class="card border-0 shadow-sm text-decoration-none h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="p-3 rounded-3 bg-info-subtle text-info"><i class="bi bi-cash-coin fs-4"></i></div>
                    <div>
                        <div class="fw-bold text-body">My Payslips</div>
                        <div class="small text-body-secondary">Download &amp; print statements</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <button type="button" class="card border-0 shadow-sm text-start w-100 h-100" data-bs-toggle="modal" data-bs-target="#essProfileReqModal">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="p-3 rounded-3 bg-warning-subtle text-warning"><i class="bi bi-pencil-square fs-4"></i></div>
                    <div>
                        <div class="fw-bold text-body">Update My Info</div>
                        <div class="small text-body-secondary">Request profile/bank update</div>
                    </div>
                </div>
            </button>
        </div>
    </div>

    <div class="row g-4">
        <!-- Recent Leave Applications -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">My Recent Leave Requests</h6>
                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#essApplyLeaveModal">New Request</button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Leave Type</th>
                                    <th>Dates</th>
                                    <th>Days</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.RecentLeaves.Any())
                                {
                                    <tr><td colspan="5" class="text-center text-body-secondary py-3">No leave applications found.</td></tr>
                                }
                                @foreach (var l in Model.RecentLeaves)
                                {
                                    var badge = l.ApprovalStatus switch { "Approved" => "bg-success", "Rejected" => "bg-danger", "Cancelled" => "bg-secondary", _ => "bg-warning text-dark" };
                                    <tr>
                                        <td class="fw-semibold">@l.LeaveName</td>
                                        <td>@l.StartDate.ToString("dd MMM") - @l.EndDate.ToString("dd MMM yyyy")</td>
                                        <td>@l.TotalDays.ToString("0.#")</td>
                                        <td><span class="badge @badge">@l.ApprovalStatus</span></td>
                                        <td class="text-end">
                                            @if (l.ApprovalStatus == "Pending")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger py-0" onclick="HrmsPortal.cancelLeave(@l.LeaveApplicationId)">Cancel</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Payslips & Upcoming Holidays -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">Recent Payslips</h6>
                    <a asp-action="MyPayslips" asp-route-previewEmployeeId="@(Model.IsSuperAdminPreview ? p.EmployeeId : null)" class="small text-decoration-none">View All</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Period</th>
                                    <th class="text-end">Gross</th>
                                    <th class="text-end">Net Pay</th>
                                    <th>Status</th>
                                    <th class="text-end">Statement</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.RecentPayslips.Any())
                                {
                                    <tr><td colspan="5" class="text-center text-body-secondary py-3">No payslips generated yet.</td></tr>
                                }
                                @foreach (var ps in Model.RecentPayslips)
                                {
                                    <tr>
                                        <td class="fw-semibold">@ps.PeriodLabel</td>
                                        <td class="text-end">@ps.GrossPay.ToString("N2")</td>
                                        <td class="text-end fw-bold text-primary">@ps.NetPay.ToString("N2") @ps.CurrencyCode</td>
                                        <td><span class="badge bg-info-subtle text-info-emphasis">@ps.PaymentStatus</span></td>
                                        <td class="text-end">
                                            <a asp-action="ViewPayslip" asp-route-id="@ps.PayslipId" class="btn btn-sm btn-outline-secondary py-0">
                                                <i class="bi bi-printer"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent">
                    <h6 class="fw-bold mb-0">Upcoming Holidays</h6>
                </div>
                <div class="card-body py-2">
                    @if (!Model.UpcomingHolidays.Any())
                    {
                        <div class="small text-body-secondary py-2">No upcoming company holidays scheduled.</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush small">
                            @foreach (var h in Model.UpcomingHolidays)
                            {
                                <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                    <span><strong>@h.HolidayName</strong> <span class="text-body-secondary">(@h.HolidayType)</span></span>
                                    <span class="badge bg-body-secondary text-body-emphasis">@h.HolidayDate.ToString("dd MMM yyyy")</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <!-- Performance Goals & Appraisals -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">My Goals &amp; Performance Appraisals</h6>
                </div>
                <div class="card-body">
                    @if (Model.Appraisals.Any())
                    {
                        <div class="mb-3">
                            @foreach (var app in Model.Appraisals)
                            {
                                var jsonApp = JsonSerializer.Serialize(app, jsonOpts);
                                <div class="p-2 border rounded-3 mb-2 d-flex justify-content-between align-items-center gap-2 small">
                                    <div>
                                        <div class="fw-semibold">@app.CycleName <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">@app.AppraisalStatus</span></div>
                                        <div class="text-body-secondary">
                                            Self: @(app.SelfRating?.ToString("0.00") ?? "-") &bull; Final: @(app.FinalRating?.ToString("0.00") ?? "-") @(app.RatingBand != null ? $"({app.RatingBand})" : "")
                                        </div>
                                    </div>
                                    @if (app.AppraisalStatus is "NotStarted" or "SelfSubmitted")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick='HrmsPortal.openSelfAppraisalModal(@Html.Raw(jsonApp))'>
                                            Self Review
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <h6 class="small text-uppercase fw-bold text-body-secondary mb-2">Active KPIs</h6>
                    @if (!Model.Goals.Any())
                    {
                        <div class="small text-body-secondary">No KPIs assigned for the current cycle.</div>
                    }
                    else
                    {
                        @foreach (var g in Model.Goals)
                        {
                            var jsonGoal = JsonSerializer.Serialize(g, jsonOpts);
                            <div class="mb-3 small">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-semibold">@g.GoalTitle <span class="text-body-secondary">(@g.WeightPercent.ToString("0")%)</span></span>
                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" onclick='HrmsPortal.openGoalProgressModal(@Html.Raw(jsonGoal))'>Update (@g.ProgressPercent%)</button>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-primary" style="width:@g.ProgressPercent%"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Loans, Expenses & Trainings -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent">
                    <h6 class="fw-bold mb-0">My Loans, Expenses &amp; Trainings</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3 small">
                        <div class="col-md-6">
                            <div class="fw-bold text-uppercase text-body-secondary mb-2">Active / Recent Loans</div>
                            @if (!Model.ActiveLoans.Any())
                            {
                                <div class="text-body-secondary">No active loans or advances.</div>
                            }
                            @foreach (var ln in Model.ActiveLoans.Take(3))
                            {
                                <div class="border rounded-2 p-2 mb-2">
                                    <div class="fw-semibold">@ln.LoanNumber &bull; @ln.LoanTypeName</div>
                                    <div>Bal: <strong>@ln.RemainingBalance.ToString("N2")</strong> (@ln.LoanStatus)</div>
                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            <div class="fw-bold text-uppercase text-body-secondary mb-2">Recent Expense Claims</div>
                            @if (!Model.RecentExpenses.Any())
                            {
                                <div class="text-body-secondary">No expense claims submitted.</div>
                            }
                            @foreach (var ex in Model.RecentExpenses.Take(3))
                            {
                                <div class="border rounded-2 p-2 mb-2">
                                    <div class="fw-semibold">@ex.ClaimNumber &bull; @ex.CategoryName</div>
                                    <div>@ex.ClaimAmount.ToString("N2") @ex.CurrencyCode (@ex.ClaimStatus)</div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="border-top pt-3 mt-2 small">
                        <div class="fw-bold text-uppercase text-body-secondary mb-2">Enrolled Training Programs</div>
                        @if (!Model.Enrollments.Any())
                        {
                            <div class="text-body-secondary">No training enrollments assigned.</div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var tr in Model.Enrollments.Take(4))
                                {
                                    <span class="badge bg-body-secondary text-body-emphasis px-3 py-2">
                                        @tr.ProgramTitle &bull; @tr.AttendanceStatus
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modals -->
    <!-- Apply Leave Modal -->
    <div class="modal fade" id="essApplyLeaveModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="essApplyLeaveForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="EmployeeId" value="@p.EmployeeId" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">Apply for Leave</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body row g-3">
                        <div class="col-12">
                            <label class="form-label">Leave Type *</label>
                            <select name="LeaveTypeId" class="form-select" required>
                                @foreach (var lt in Model.LeaveTypes)
                                {
                                    <option value="@lt.LeaveTypeId">@lt.LeaveName (@lt.LeaveCode)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Start Date *</label>
                            <input type="date" name="StartDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">End Date *</label>
                            <input type="date" name="EndDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6 d-flex align-items-center">
                            <div class="form-check mt-2">
                                <input type="checkbox" class="form-check-input" id="essLeaveHalfDay" name="IsHalfDay" value="true" />
                                <input type="hidden" name="IsHalfDay" value="false" />
                                <label class="form-check-label" for="essLeaveHalfDay">Half-Day Leave</label>
                            </div>
                        </div>
                        <div class="col-md-6 d-none" id="essLeaveHalfSessionWrap">
                            <label class="form-label">Session</label>
                            <select name="HalfDaySession" class="form-select">
                                <option value="FirstHalf">First Half</option>
                                <option value="SecondHalf">Second Half</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Reason *</label>
                            <textarea name="Reason" class="form-control" rows="2" required></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Contact During Leave</label>
                            <input type="text" name="ContactDuringLeave" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Supporting Document</label>
                            <input type="file" name="attachmentFile" class="form-control" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-primary" onclick="HrmsPortal.submitMultipartForm('#essApplyLeaveForm', '/SelfService/ApplyLeave', '#essApplyLeaveModal')">Submit Leave</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Submit Expense Modal -->
    <div class="modal fade" id="essSubmitExpenseModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="essSubmitExpenseForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="EmployeeId" value="@p.EmployeeId" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">Submit Expense Claim</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Category *</label>
                            <select name="CategoryId" class="form-select" required>
                                @foreach (var c in Model.ExpenseCategories)
                                {
                                    <option value="@c.CategoryId">@c.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Expense Date *</label>
                            <input type="date" name="ExpenseDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-7">
                            <label class="form-label">Merchant / Vendor *</label>
                            <input type="text" name="MerchantOrVendor" class="form-control" required />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Amount (@p.CurrencyCode) *</label>
                            <input type="number" step="0.01" min="0.01" name="ClaimAmount" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Receipt Upload</label>
                            <input type="file" name="receiptFile" class="form-control" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            <textarea name="Description" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-primary" onclick="HrmsPortal.submitMultipartForm('#essSubmitExpenseForm', '/SelfService/SubmitExpense', '#essSubmitExpenseModal')">Submit Claim</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Submit Loan Modal -->
    <div class="modal fade" id="essSubmitLoanModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="essSubmitLoanForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="EmployeeId" value="@p.EmployeeId" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">Apply for Loan / Advance</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body row g-3">
                        <div class="col-12">
                            <label class="form-label">Policy Type *</label>
                            <select name="LoanTypeId" class="form-select" required>
                                @foreach (var lt in Model.LoanTypes)
                                {
                                    <option value="@lt.LoanTypeId">@lt.TypeName (Max @lt.MaxAmount.ToString("N0"), @lt.MaxTenureMonths mo)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Principal Amount *</label>
                            <input type="number" step="0.01" min="1" name="PrincipalAmount" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tenure (Months) *</label>
                            <input type="number" min="1" max="120" name="TenureMonths" class="form-control" value="6" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Repayment Start Date *</label>
                            <input type="date" name="RepaymentStartDate" class="form-control" value="@(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).ToString("yyyy-MM-dd"))" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Purpose</label>
                            <textarea name="Purpose" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-primary" onclick="HrmsPortal.submitAjaxForm('#essSubmitLoanForm', '/SelfService/SubmitLoan', '#essSubmitLoanModal')">Submit Application</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Profile Update Request Modal -->
    <div class="modal fade" id="essProfileReqModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form id="essProfileReqForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="previewEmployeeId" value="@(Model.IsSuperAdminPreview ? p.EmployeeId : null)" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">Request Profile Information Update</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body row g-3">
                        <div class="col-md-5">
                            <label class="form-label">Change Category *</label>
                            <select name="RequestType" id="essReqType" class="form-select" required>
                                <option value="ContactInfo">Contact Info</option>
                                <option value="Address">Residential Address</option>
                                <option value="BankDetails">Bank Account Details</option>
                                <option value="EmergencyContact">Emergency Contact</option>
                            </select>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label">Change Summary *</label>
                            <input type="text" name="FieldSummary" class="form-control" placeholder="e.g., Update mobile number & email" required />
                        </div>

                        <div id="essProfContact" class="row g-3 ess-prof-group">
                            <div class="col-md-4">
                                <label class="form-label">Work / Desk Phone</label>
                                <input type="text" name="RequestedPhone" class="form-control" value="@p.Phone" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Mobile Phone</label>
                                <input type="text" name="RequestedMobilePhone" class="form-control" value="@p.MobilePhone" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Personal Email</label>
                                <input type="email" name="RequestedPersonalEmail" class="form-control" value="@p.PersonalEmail" />
                            </div>
                        </div>

                        <div id="essProfAddress" class="row g-3 ess-prof-group d-none">
                            <div class="col-12">
                                <label class="form-label">Current Address</label>
                                <input type="text" name="RequestedAddress" class="form-control" value="@p.CurrentAddress" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">City</label>
                                <input type="text" name="RequestedCity" class="form-control" value="@p.City" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Country</label>
                                <input type="text" name="RequestedCountry" class="form-control" value="@p.Country" />
                            </div>
                        </div>

                        <div id="essProfBank" class="row g-3 ess-prof-group d-none">
                            <div class="col-md-6">
                                <label class="form-label">Bank Name</label>
                                <input type="text" name="RequestedBankName" class="form-control" value="@p.BankName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Account Title</label>
                                <input type="text" name="RequestedBankAccountTitle" class="form-control" value="@p.BankAccountTitle" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Account Number</label>
                                <input type="text" name="RequestedBankAccountNumber" class="form-control" value="@p.BankAccountNumber" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Routing / IBAN Code</label>
                                <input type="text" name="RequestedBankRoutingCode" class="form-control" value="@p.BankRoutingCode" />
                            </div>
                        </div>

                        <div id="essProfEmergency" class="row g-3 ess-prof-group d-none">
                            <div class="col-md-4">
                                <label class="form-label">Contact Name</label>
                                <input type="text" name="RequestedEmergencyContactName" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Relationship</label>
                                <input type="text" name="RequestedEmergencyRelationship" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Primary Phone</label>
                                <input type="text" name="RequestedEmergencyPhone" class="form-control" />
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Notes for Manager / HR</label>
                            <textarea name="EmployeeNotes" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-primary" onclick="HrmsPortal.submitAjaxForm('#essProfileReqForm', '/SelfService/SubmitProfileRequest', '#essProfileReqModal')">Submit Request</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Update Goal Progress Modal -->
    <div class="modal fade" id="essGoalProgressModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="essGoalProgressForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="GoalId" id="essGpGoalId" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">Update KPI Progress</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body row g-3">
                        <div class="col-12 small fw-semibold text-primary" id="essGpTitle"></div>
                        <div class="col-md-6">
                            <label class="form-label">Progress % *</label>
                            <input type="number" min="0" max="100" name="ProgressPercent" id="essGpProgress" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Status *</label>
                            <select name="GoalStatus" id="essGpStatus" class="form-select" required>
                                <option value="NotStarted">NotStarted</option>
                                <option value="InProgress">InProgress</option>
                                <option value="Completed">Completed</option>
                                <option value="Deferred">Deferred</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Achieved Value</label>
                            <input type="text" name="AchievedValue" id="essGpAchieved" class="form-control" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-primary" onclick="HrmsPortal.submitAjaxForm('#essGoalProgressForm', '/SelfService/UpdateGoalProgress', '#essGoalProgressModal')">Save Progress</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Self Appraisal Modal -->
    <div class="modal fade" id="essSelfAppraisalModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="essSelfAppraisalForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="AppraisalId" id="essSelfAppId" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">Submit Self-Appraisal</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body row g-3">
                        <div class="col-12 small fw-semibold text-primary" id="essSelfCycleLabel"></div>
                        <div class="col-12">
                            <label class="form-label">Self Rating (1.0 - 5.0) *</label>
                            <input type="number" step="0.1" min="1" max="5" name="SelfRating" id="essSelfRating" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Self Evaluation Summary</label>
                            <textarea name="SelfComments" id="essSelfComments" class="form-control" rows="4"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-primary" onclick="HrmsPortal.submitAjaxForm('#essSelfAppraisalForm', '/SelfService/SubmitSelfAppraisal', '#essSelfAppraisalModal')">Submit Self-Appraisal</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/portal.js" asp-append-version="true"></script>
}
