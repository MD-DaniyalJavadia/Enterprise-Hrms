@model EssAttendancePageViewModel
@{
    ViewData["Title"] = "My Attendance & Overtime";
    ViewData["BreadcrumbParent"] = "Self-Service Portal";
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        @if (Model.HasEmployeeProfile && Model.EmployeeId.HasValue)
        {
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#essRegModal">
                <i class="bi bi-clock-history me-1"></i>Request Regularization
            </button>
            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#essOtModal">
                <i class="bi bi-plus-circle me-1"></i>Claim Overtime
            </button>
        }
    </div>
}

@if (!Model.HasEmployeeProfile || !Model.EmployeeId.HasValue)
{
    <div class="alert alert-info">No employee profile is linked to your account.</div>
}
else
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="MyAttendance" class="row g-3 align-items-end">
                @if (Model.IsSuperAdminPreview)
                {
                    <div class="col-md-4">
                        <label class="form-label small">Employee</label>
                        <select name="previewEmployeeId" class="form-select form-select-sm">
                            @foreach (var emp in Model.PreviewEmployees)
                            {
                                <option value="@emp.EmployeeId" selected="@(Model.EmployeeId == emp.EmployeeId)">@emp.EmployeeCode - @emp.FullName</option>
                            }
                        </select>
                    </div>
                }
                <div class="col-md-3">
                    <label class="form-label small">Year</label>
                    <select name="year" class="form-select form-select-sm">
                        @for (int y = DateTime.Today.Year - 2; y <= DateTime.Today.Year + 1; y++)
                        {
                            <option value="@y" selected="@(Model.Year == y)">@y</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Month</label>
                    <select name="month" class="form-select form-select-sm">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(Model.Month == m)">@(new DateTime(2000, m, 1).ToString("MMMM"))</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-sm w-100">Filter</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent">
            <h6 class="fw-bold mb-0">Attendance Log — @(new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy"))</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle hrms-portal-datatable small">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Shift</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th>Work Hours</th>
                            <th>Late</th>
                            <th>OT</th>
                            <th>Status</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Logs)
                        {
                            var badge = r.Status switch { "Present" => "bg-success", "Late" => "bg-warning text-dark", "Absent" => "bg-danger", "OnLeave" => "bg-info text-dark", _ => "bg-secondary" };
                            <tr>
                                <td class="fw-semibold">@r.AttendanceDate.ToString("ddd, dd MMM yyyy")</td>
                                <td>@(r.ShiftName ?? "-")</td>
                                <td>@(r.CheckInTime?.ToString("HH:mm") ?? "-")</td>
                                <td>@(r.CheckOutTime?.ToString("HH:mm") ?? "-")</td>
                                <td>@r.WorkHoursFormatted</td>
                                <td>@(r.LateMinutes > 0 ? $"{r.LateMinutes}m" : "-")</td>
                                <td>@(r.OvertimeMinutes > 0 ? $"{r.OvertimeMinutes}m" : "-")</td>
                                <td><span class="badge @badge">@r.Status</span></td>
                                <td>@(r.Remarks ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent"><h6 class="fw-bold mb-0">My Regularization Requests</h6></div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0 small">
                            <thead class="table-light">
                                <tr><th>Date</th><th>Requested</th><th>Reason</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                @if (!Model.Regularizations.Any())
                                {
                                    <tr><td colspan="4" class="text-center text-body-secondary py-3">No regularization requests found.</td></tr>
                                }
                                @foreach (var reg in Model.Regularizations)
                                {
                                    <tr>
                                        <td>@reg.AttendanceDate.ToString("dd MMM yyyy")</td>
                                        <td>@reg.RequestedStatus</td>
                                        <td>@reg.Reason</td>
                                        <td><span class="badge @(reg.ApprovalStatus == "Approved" ? "bg-success" : reg.ApprovalStatus == "Rejected" ? "bg-danger" : "bg-warning text-dark")">@reg.ApprovalStatus</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent"><h6 class="fw-bold mb-0">My Overtime Claims</h6></div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0 small">
                            <thead class="table-light">
                                <tr><th>Date</th><th>Requested</th><th>Approved</th><th>Reason</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                @if (!Model.OvertimeRequests.Any())
                                {
                                    <tr><td colspan="5" class="text-center text-body-secondary py-3">No overtime claims submitted.</td></tr>
                                }
                                @foreach (var ot in Model.OvertimeRequests)
                                {
                                    <tr>
                                        <td>@ot.OvertimeDate.ToString("dd MMM yyyy")</td>
                                        <td>@ot.RequestedHours.ToString("0.##")h</td>
                                        <td>@(ot.ApprovalStatus == "Approved" ? $"{ot.ApprovedHours:0.##}h" : "-")</td>
                                        <td>@ot.Reason</td>
                                        <td><span class="badge @(ot.ApprovalStatus == "Approved" ? "bg-success" : ot.ApprovalStatus == "Rejected" ? "bg-danger" : "bg-warning text-dark")">@ot.ApprovalStatus</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Regularization Modal -->
    <div class="modal fade" id="essRegModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="essRegForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="EmployeeId" value="@Model.EmployeeId.Value" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">Submit Attendance Regularization</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Attendance Date *</label>
                            <input type="date" name="AttendanceDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Requested Status *</label>
                            <select name="RequestedStatus" class="form-select" required>
                                <option value="Present">Present</option>
                                <option value="HalfDay">HalfDay</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Check-In Time</label>
                            <input type="time" name="RequestedCheckIn" class="form-control" value="09:00" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Check-Out Time</label>
                            <input type="time" name="RequestedCheckOut" class="form-control" value="18:00" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Reason *</label>
                            <textarea name="Reason" class="form-control" rows="2" required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-primary" onclick="HrmsPortal.submitAjaxForm('#essRegForm', '/SelfService/SubmitRegularization', '#essRegModal')">Submit Request</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Overtime Modal -->
    <div class="modal fade" id="essOtModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="essOtForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="EmployeeId" value="@Model.EmployeeId.Value" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">Submit Overtime Claim</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Overtime Date *</label>
                            <input type="date" name="OvertimeDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Hours Requested *</label>
                            <input type="number" step="0.25" min="0.25" max="24" name="RequestedHours" class="form-control" value="2.0" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Reason / Task Summary *</label>
                            <textarea name="Reason" class="form-control" rows="2" required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-primary" onclick="HrmsPortal.submitAjaxForm('#essOtForm', '/SelfService/SubmitOvertime', '#essOtModal')">Submit Claim</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/portal.js" asp-append-version="true"></script>
}
