@model DailyAttendancePageViewModel
@{
    ViewData["Title"] = "Daily Attendance Register";
    ViewData["BreadcrumbParent"] = "Attendance & Shifts";
    var canManage = User.HasPermission("ATTENDANCE.MANAGE");
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="MonthlyReport" class="btn btn-outline-secondary btn-sm"><i class="bi bi-file-earmark-bar-graph me-1"></i>Monthly Report</a>
        <a asp-action="ExportDaily" asp-route-date="@Model.AttendanceDate.ToString("yyyy-MM-dd")" asp-route-branchId="@Model.BranchId" asp-route-departmentId="@Model.DepartmentId" asp-route-status="@Model.Status" asp-route-search="@Model.SearchTerm" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export CSV
        </a>
        @if (canManage)
        {
            <a asp-action="Import" class="btn btn-outline-primary btn-sm"><i class="bi bi-upload me-1"></i>Import CSV</a>
            <button type="button" class="btn btn-primary btn-sm" onclick="HrmsAtt.openManualModal('', '@Model.AttendanceDate.ToString("yyyy-MM-dd")')">
                <i class="bi bi-plus-circle me-1"></i>Mark Attendance
            </button>
        }
    </div>
}

<!-- KPI Summary Strip -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary">Active Workforce</div>
                <div class="fs-4 fw-bold">@Model.Kpi.TotalActiveEmployees</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-success fw-semibold">Present</div>
                <div class="fs-4 fw-bold text-success">@Model.Kpi.PresentCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-warning fw-semibold">Late Arrivals</div>
                <div class="fs-4 fw-bold text-warning">@Model.Kpi.LateCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-danger fw-semibold">Absent</div>
                <div class="fs-4 fw-bold text-danger">@Model.Kpi.AbsentCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-info fw-semibold">On Leave / Half</div>
                <div class="fs-4 fw-bold text-info">@(Model.Kpi.OnLeaveCount + Model.Kpi.HalfDayCount)</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-primary fw-semibold">Overtime (Hrs)</div>
                <div class="fs-4 fw-bold text-primary">@Math.Round(Model.Kpi.TotalOvertimeMinutes / 60.0, 1)</div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Punch Bar -->
@if (canManage || Model.CurrentUserEmployeeId.HasValue)
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-3">
            <form id="quickPunchForm" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Quick Clock-In / Clock-Out (Today)</label>
                    @if (canManage)
                    {
                        <select name="EmployeeId" class="form-select form-select-sm hrms-select2" required>
                            <option value="">Select Employee...</option>
                            @foreach (var emp in Model.Employees)
                            {
                                <option value="@emp.EmployeeId" selected="@(Model.CurrentUserEmployeeId == emp.EmployeeId)">@emp.EmployeeCode - @emp.FullName</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input type="hidden" name="EmployeeId" value="@Model.CurrentUserEmployeeId" />
                        <input type="text" class="form-control form-control-sm" value="@User.GetFullName()" readonly />
                    }
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Remarks (Optional)</label>
                    <input type="text" name="Remarks" class="form-control form-control-sm" maxlength="400" placeholder="e.g. Working from HQ / Remote" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="button" class="btn btn-success btn-sm flex-fill" onclick="HrmsAtt.submitAjaxForm('#quickPunchForm', '@Url.Action("CheckIn")')">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Check In
                    </button>
                    <button type="button" class="btn btn-outline-danger btn-sm flex-fill" onclick="HrmsAtt.submitAjaxForm('#quickPunchForm', '@Url.Action("CheckOut")')">
                        <i class="bi bi-box-arrow-right me-1"></i>Check Out
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<!-- Filter Strip -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Date</label>
                <input type="date" name="date" value="@Model.AttendanceDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Branch</label>
                <select name="branchId" class="form-select form-select-sm">
                    <option value="">All Branches</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.BranchId" selected="@(Model.BranchId == b.BranchId)">@b.BranchName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Department</label>
                <select name="departmentId" class="form-select form-select-sm">
                    <option value="">All Departments</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.DepartmentId" selected="@(Model.DepartmentId == d.DepartmentId)">@d.DepartmentName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="Present" selected="@(Model.Status == "Present")">Present</option>
                    <option value="Late" selected="@(Model.Status == "Late")">Late</option>
                    <option value="Absent" selected="@(Model.Status == "Absent")">Absent</option>
                    <option value="HalfDay" selected="@(Model.Status == "HalfDay")">Half Day</option>
                    <option value="OnLeave" selected="@(Model.Status == "OnLeave")">On Leave</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="Code or name..." />
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-funnel"></i></button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Register Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-att-datatable w-100">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Employee</th>
                        <th>Department</th>
                        <th>Shift</th>
                        <th>Check In</th>
                        <th>Check Out</th>
                        <th>Work Hrs</th>
                        <th>Late / OT</th>
                        <th>Status</th>
                        <th>Source</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Records)
                    {
                        var badge = r.Status switch
                        {
                            "Present" => "bg-success-subtle text-success-emphasis",
                            "Late" => "bg-warning-subtle text-warning-emphasis",
                            "Absent" => "bg-danger-subtle text-danger-emphasis",
                            "HalfDay" => "bg-info-subtle text-info-emphasis",
                            _ => "bg-secondary-subtle text-secondary-emphasis"
                        };
                        <tr>
                            <td class="fw-semibold">@r.EmployeeCode</td>
                            <td>
                                <a asp-action="EmployeeCalendar" asp-route-employeeId="@r.EmployeeId" asp-route-year="@r.AttendanceDate.Year" asp-route-month="@r.AttendanceDate.Month" class="fw-semibold text-decoration-none">@r.FullName</a>
                                <div class="small text-body-secondary">@r.BranchName</div>
                            </td>
                            <td>@r.DepartmentName</td>
                            <td>@(r.ShiftName ?? "Default")</td>
                            <td>@(r.CheckInTime?.ToString("hh:mm tt") ?? "-")</td>
                            <td>@(r.CheckOutTime?.ToString("hh:mm tt") ?? "-")</td>
                            <td>@r.WorkHoursFormatted</td>
                            <td class="small">
                                @if (r.LateMinutes > 0) { <span class="text-warning fw-semibold me-2">+@r.LateMinutes m late</span> }
                                @if (r.OvertimeMinutes > 0) { <span class="text-primary fw-semibold">@r.OvertimeMinutes m OT</span> }
                                @if (r.LateMinutes == 0 && r.OvertimeMinutes == 0) { <span class="text-body-secondary">-</span> }
                            </td>
                            <td><span class="badge @badge">@r.Status</span></td>
                            <td><span class="small text-body-secondary">@r.Source</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="EmployeeCalendar" asp-route-employeeId="@r.EmployeeId" asp-route-year="@r.AttendanceDate.Year" asp-route-month="@r.AttendanceDate.Month" class="btn btn-sm btn-outline-info" title="Monthly Calendar"><i class="bi bi-calendar3"></i></a>
                                @if (canManage)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary" title="Edit Record"
                                            onclick='HrmsAtt.openManualModal(@r.EmployeeId, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.AttendanceDate.ToString("yyyy-MM-dd"))), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.Status)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.CheckInTime?.ToString("HH:mm") ?? "")), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.CheckOutTime?.ToString("HH:mm") ?? "")), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.Remarks ?? "")))'>
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (canManage)
{
    <div class="modal fade" id="manualAttendanceModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Mark / Update Attendance</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="manualAttendanceForm" onsubmit="event.preventDefault(); HrmsAtt.submitAjaxForm('#manualAttendanceForm', '@Url.Action("MarkManual")', '#manualAttendanceModal');">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Employee</label>
                                <select id="manEmployeeId" name="EmployeeId" class="form-select" required>
                                    <option value="">Select Employee...</option>
                                    @foreach (var emp in Model.Employees)
                                    {
                                        <option value="@emp.EmployeeId">@emp.EmployeeCode - @emp.FullName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Date</label>
                                <input id="manAttendanceDate" type="date" name="AttendanceDate" class="form-control" value="@Model.AttendanceDate.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Status</label>
                                <select id="manStatus" name="Status" class="form-select" required>
                                    <option value="Present">Present</option>
                                    <option value="Late">Late</option>
                                    <option value="Absent">Absent</option>
                                    <option value="HalfDay">Half Day</option>
                                    <option value="OnLeave">On Leave</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Check-In Time</label>
                                <input id="manCheckIn" type="time" name="CheckInTime" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Check-Out Time</label>
                                <input id="manCheckOut" type="time" name="CheckOutTime" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Remarks</label>
                                <textarea id="manRemarks" name="Remarks" class="form-control" rows="2" maxlength="400"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Attendance</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/attendance.js" asp-append-version="true"></script>
}
