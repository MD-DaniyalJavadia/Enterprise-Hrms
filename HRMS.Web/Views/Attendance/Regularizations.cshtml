@model RegularizationsPageViewModel
@{
    ViewData["Title"] = "Regularization & Overtime Requests";
    ViewData["BreadcrumbParent"] = "Attendance & Shifts";
    var canManage = User.HasPermission("ATTENDANCE.MANAGE");
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        @if (canManage || Model.CurrentUserEmployeeId.HasValue)
        {
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#regularizationModal">
                <i class="bi bi-clock-history me-1"></i>Request Regularization
            </button>
            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#overtimeModal">
                <i class="bi bi-plus-circle me-1"></i>Submit Overtime
            </button>
        }
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Approval Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="Pending" selected="@(Model.FilterStatus == "Pending")">Pending</option>
                    <option value="Approved" selected="@(Model.FilterStatus == "Approved")">Approved</option>
                    <option value="Rejected" selected="@(Model.FilterStatus == "Rejected")">Rejected</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Regularizations" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-reg" type="button">
            Attendance Regularizations <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">@Model.Regularizations.Count</span>
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-ot" type="button">
            Overtime Requests <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">@Model.OvertimeRequests.Count</span>
        </button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tab-reg">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle hrms-att-datatable w-100">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Date</th>
                                <th>Requested Timing</th>
                                <th>Status</th>
                                <th>Reason</th>
                                <th>Approval</th>
                                @if (canManage) { <th class="text-end">Review</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Regularizations)
                            {
                                var cls = r.ApprovalStatus == "Approved" ? "bg-success-subtle text-success-emphasis"
                                        : r.ApprovalStatus == "Rejected" ? "bg-danger-subtle text-danger-emphasis"
                                        : "bg-warning-subtle text-warning-emphasis";
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@r.FullName</div>
                                        <div class="small text-body-secondary">@r.EmployeeCode &bull; @r.DepartmentName</div>
                                    </td>
                                    <td>@r.AttendanceDate.ToString("MMM dd, yyyy")</td>
                                    <td class="small">@(r.RequestedCheckIn?.ToString("HH:mm") ?? "--") - @(r.RequestedCheckOut?.ToString("HH:mm") ?? "--")</td>
                                    <td>@r.RequestedStatus</td>
                                    <td class="small">@r.Reason</td>
                                    <td>
                                        <span class="badge @cls">@r.ApprovalStatus</span>
                                        @if (!string.IsNullOrEmpty(r.ReviewedByName))
                                        {
                                            <div class="small text-body-secondary">by @r.ReviewedByName</div>
                                        }
                                    </td>
                                    @if (canManage)
                                    {
                                        <td class="text-end text-nowrap">
                                            @if (r.ApprovalStatus == "Pending")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-success" onclick='HrmsAtt.reviewRegularization(@r.RegularizationId, "Approved", @Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.FullName)))' title="Approve"><i class="bi bi-check-lg"></i></button>
                                                <button type="button" class="btn btn-sm btn-outline-danger" onclick='HrmsAtt.reviewRegularization(@r.RegularizationId, "Rejected", @Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.FullName)))' title="Reject"><i class="bi bi-x-lg"></i></button>
                                            }
                                            else
                                            {
                                                <span class="small text-body-secondary">Reviewed</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="tab-ot">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle hrms-att-datatable w-100">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Date</th>
                                <th>Requested Hrs</th>
                                <th>Approved Hrs</th>
                                <th>Reason</th>
                                <th>Approval</th>
                                @if (canManage) { <th class="text-end">Review</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model.OvertimeRequests)
                            {
                                var cls = o.ApprovalStatus == "Approved" ? "bg-success-subtle text-success-emphasis"
                                        : o.ApprovalStatus == "Rejected" ? "bg-danger-subtle text-danger-emphasis"
                                        : "bg-warning-subtle text-warning-emphasis";
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@o.FullName</div>
                                        <div class="small text-body-secondary">@o.EmployeeCode &bull; @o.DepartmentName</div>
                                    </td>
                                    <td>@o.OvertimeDate.ToString("MMM dd, yyyy")</td>
                                    <td class="fw-semibold">@o.RequestedHours.ToString("0.##") h</td>
                                    <td>@(o.ApprovalStatus == "Approved" ? $"{o.ApprovedHours:0.##} h" : "-")</td>
                                    <td class="small">@o.Reason</td>
                                    <td><span class="badge @cls">@o.ApprovalStatus</span></td>
                                    @if (canManage)
                                    {
                                        <td class="text-end text-nowrap">
                                            @if (o.ApprovalStatus == "Pending")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-success" onclick='HrmsAtt.reviewOvertime(@o.OvertimeRequestId, "Approved", @o.RequestedHours, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(o.FullName)))' title="Approve"><i class="bi bi-check-lg"></i></button>
                                                <button type="button" class="btn btn-sm btn-outline-danger" onclick='HrmsAtt.reviewOvertime(@o.OvertimeRequestId, "Rejected", @o.RequestedHours, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(o.FullName)))' title="Reject"><i class="bi bi-x-lg"></i></button>
                                            }
                                            else
                                            {
                                                <span class="small text-body-secondary">Reviewed</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Regularization Modal -->
<div class="modal fade" id="regularizationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Submit Attendance Regularization</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="regularizationForm" onsubmit="event.preventDefault(); HrmsAtt.submitAjaxForm('#regularizationForm', '@Url.Action("SubmitRegularization")', '#regularizationModal');">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Employee</label>
                            @if (canManage)
                            {
                                <select name="EmployeeId" class="form-select" required>
                                    <option value="">Select Employee...</option>
                                    @foreach (var emp in Model.Employees)
                                    {
                                        <option value="@emp.EmployeeId" selected="@(Model.CurrentUserEmployeeId == emp.EmployeeId)">@emp.EmployeeCode - @emp.FullName</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input type="hidden" name="EmployeeId" value="@Model.CurrentUserEmployeeId" />
                                <input type="text" class="form-control" value="@User.GetFullName()" readonly />
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Attendance Date</label>
                            <input type="date" name="AttendanceDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Requested Status</label>
                            <select name="RequestedStatus" class="form-select">
                                <option value="Present">Present</option>
                                <option value="HalfDay">Half Day</option>
                                <option value="Late">Late</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Check-In Time</label>
                            <input type="time" name="RequestedCheckIn" class="form-control" value="09:00" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Check-Out Time</label>
                            <input type="time" name="RequestedCheckOut" class="form-control" value="18:00" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Reason</label>
                            <textarea name="Reason" class="form-control" rows="2" maxlength="500" required></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Overtime Modal -->
<div class="modal fade" id="overtimeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Submit Overtime Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="overtimeForm" onsubmit="event.preventDefault(); HrmsAtt.submitAjaxForm('#overtimeForm', '@Url.Action("SubmitOvertime")', '#overtimeModal');">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Employee</label>
                            @if (canManage)
                            {
                                <select name="EmployeeId" class="form-select" required>
                                    <option value="">Select Employee...</option>
                                    @foreach (var emp in Model.Employees)
                                    {
                                        <option value="@emp.EmployeeId" selected="@(Model.CurrentUserEmployeeId == emp.EmployeeId)">@emp.EmployeeCode - @emp.FullName</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input type="hidden" name="EmployeeId" value="@Model.CurrentUserEmployeeId" />
                                <input type="text" class="form-control" value="@User.GetFullName()" readonly />
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Overtime Date</label>
                            <input type="date" name="OvertimeDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Requested Hours</label>
                            <input type="number" step="0.25" min="0.25" max="24" name="RequestedHours" class="form-control" value="2.0" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Justification</label>
                            <textarea name="Reason" class="form-control" rows="2" maxlength="500" required></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit Overtime</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/attendance.js" asp-append-version="true"></script>
}
