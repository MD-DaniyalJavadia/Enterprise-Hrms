@model HolidayPageViewModel
@{
    ViewData["Title"] = "Holiday Calendar";
    ViewData["BreadcrumbParent"] = "Attendance & Shifts";
    var canManage = User.HasPermission("ATTENDANCE.MANAGE");
}

@section PageActions {
    @if (canManage)
    {
        <button type="button" class="btn btn-primary btn-sm" onclick="HrmsAtt.openHolidayModal()">
            <i class="bi bi-plus-circle me-1"></i>Add Holiday
        </button>
    }
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Year</label>
                <select name="year" class="form-select form-select-sm">
                    @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 2; y++)
                    {
                        <option value="@y" selected="@(Model.Year == y)">@y</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Branch</label>
                <select name="branchId" class="form-select form-select-sm">
                    <option value="">All Branches</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.BranchId" selected="@(Model.BranchId == b.BranchId)">@b.BranchName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-funnel me-1"></i>Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-att-datatable w-100">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Day</th>
                        <th>Holiday Name</th>
                        <th>Type</th>
                        <th>Branch Applicability</th>
                        <th>Description</th>
                        @if (canManage) { <th class="text-end">Actions</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model.Holidays)
                    {
                        <tr>
                            <td class="fw-semibold">@h.HolidayDate.ToString("MMM dd, yyyy")</td>
                            <td>@h.HolidayDate.DayOfWeek</td>
                            <td class="fw-semibold">@h.HolidayName</td>
                            <td>
                                <span class="badge @(h.HolidayType == "Public" ? "bg-primary-subtle text-primary-emphasis" : h.HolidayType == "Company" ? "bg-info-subtle text-info-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                                    @h.HolidayType
                                </span>
                            </td>
                            <td>@h.BranchName</td>
                            <td class="small text-body-secondary">@(h.Description ?? "-")</td>
                            @if (canManage)
                            {
                                <td class="text-end text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            onclick='HrmsAtt.openHolidayModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { holidayId = h.HolidayId, branchId = h.BranchId?.ToString() ?? "", holidayName = h.HolidayName, holidayDate = h.HolidayDate.ToString("yyyy-MM-dd"), holidayType = h.HolidayType, description = h.Description ?? "", isActive = h.IsActive })))'>
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="HrmsAtt.deleteRecord('@Url.Action("DeleteHoliday", new { id = h.HolidayId })', '@h.HolidayName')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (canManage)
{
    <div class="modal fade" id="holidayModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="holModalTitle">Add Holiday</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="holidayForm" onsubmit="event.preventDefault(); HrmsAtt.submitAjaxForm('#holidayForm', '@Url.Action("SaveHoliday")', '#holidayModal');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="holId" name="HolidayId" value="0" />
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Holiday Name</label>
                                <input id="holName" type="text" name="HolidayName" class="form-control" maxlength="120" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Date</label>
                                <input id="holDate" type="date" name="HolidayDate" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Type</label>
                                <select id="holType" name="HolidayType" class="form-select">
                                    <option value="Public">Public</option>
                                    <option value="Company">Company</option>
                                    <option value="Optional">Optional</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Branch (Leave blank for all branches)</label>
                                <select id="holBranchId" name="BranchId" class="form-select">
                                    <option value="">All Branches (Company-Wide)</option>
                                    @foreach (var b in Model.Branches)
                                    {
                                        <option value="@b.BranchId">@b.BranchName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Description</label>
                                <textarea id="holDescription" name="Description" class="form-control" rows="2" maxlength="300"></textarea>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="holIsActive" name="IsActive" value="true" checked />
                                    <label class="form-check-label small" for="holIsActive">Active</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Holiday</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/attendance.js" asp-append-version="true"></script>
}
