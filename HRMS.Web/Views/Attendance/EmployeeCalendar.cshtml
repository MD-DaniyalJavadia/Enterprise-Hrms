@model EmployeeCalendarViewModel
@{
    ViewData["Title"] = "Employee Attendance Calendar";
    ViewData["BreadcrumbParent"] = "Attendance & Shifts";
    var firstDay = new DateTime(Model.Year, Model.Month, 1);
    var daysInMonth = DateTime.DaysInMonth(Model.Year, Model.Month);
    var startOffset = (int)firstDay.DayOfWeek;
    var logsByDate = Model.Logs.ToDictionary(x => x.AttendanceDate.Date);
    var holidaysByDate = Model.Holidays.GroupBy(h => h.HolidayDate.Date).ToDictionary(g => g.Key, g => g.First());
}

@section PageActions {
    <a asp-action="MonthlyReport" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to Monthly Report
    </a>
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-semibold">Employee</label>
                <select name="employeeId" class="form-select form-select-sm hrms-select2">
                    @foreach (var emp in Model.Employees)
                    {
                        <option value="@emp.EmployeeId" selected="@(Model.EmployeeId == emp.EmployeeId)">@emp.EmployeeCode - @emp.FullName (@emp.DepartmentName)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Year</label>
                <select name="year" class="form-select form-select-sm">
                    @for (int y = DateTime.Today.Year - 2; y <= DateTime.Today.Year + 1; y++)
                    {
                        <option value="@y" selected="@(Model.Year == y)">@y</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Month</label>
                <select name="month" class="form-select form-select-sm">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(Model.Month == m)">@(new DateTime(2026, m, 1).ToString("MMMM"))</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Load</button>
            </div>
        </form>
    </div>
</div>

@if (Model.EmployeeId > 0)
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
            <div>
                <span class="fw-bold">@Model.EmployeeName</span>
                <span class="badge bg-primary-subtle text-primary-emphasis ms-2">@Model.EmployeeCode</span>
                <span class="small text-body-secondary ms-2">@Model.DesignationTitle &bull; @Model.DepartmentName</span>
            </div>
            <span class="fw-semibold text-primary">@firstDay.ToString("MMMM yyyy")</span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered align-top mb-0" style="table-layout: fixed; min-width: 720px;">
                    <thead class="table-light text-center small">
                        <tr>
                            <th>Sun</th><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int cell = 0;
                            int totalCells = startOffset + daysInMonth;
                            int rows = (int)Math.Ceiling(totalCells / 7.0);
                        }
                        @for (int r = 0; r < rows; r++)
                        {
                            <tr>
                                @for (int c = 0; c < 7; c++)
                                {
                                    int dayNum = cell - startOffset + 1;
                                    cell++;
                                    if (dayNum < 1 || dayNum > daysInMonth)
                                    {
                                        <td class="bg-body-tertiary" style="height: 88px;"></td>
                                    }
                                    else
                                    {
                                        var currentDate = new DateTime(Model.Year, Model.Month, dayNum);
                                        logsByDate.TryGetValue(currentDate, out var rec);
                                        holidaysByDate.TryGetValue(currentDate, out var hol);
                                        <td style="height: 88px;">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="small fw-bold @(currentDate == DateTime.Today ? "text-primary" : "")">@dayNum</span>
                                                @if (hol is not null)
                                                {
                                                    <span class="badge bg-purple-subtle bg-info-subtle text-info-emphasis" title="@hol.HolidayName">Holiday</span>
                                                }
                                            </div>
                                            @if (hol is not null)
                                            {
                                                <div class="small text-info fw-medium text-truncate">@hol.HolidayName</div>
                                            }
                                            @if (rec is not null)
                                            {
                                                var cls = rec.Status switch
                                                {
                                                    "Present" => "bg-success-subtle text-success-emphasis",
                                                    "Late" => "bg-warning-subtle text-warning-emphasis",
                                                    "Absent" => "bg-danger-subtle text-danger-emphasis",
                                                    _ => "bg-secondary-subtle text-secondary-emphasis"
                                                };
                                                <span class="badge @cls d-block text-start mb-1">@rec.Status</span>
                                                <div class="text-body-secondary" style="font-size: 0.72rem;">
                                                    @(rec.CheckInTime?.ToString("HH:mm") ?? "--") - @(rec.CheckOutTime?.ToString("HH:mm") ?? "--")
                                                </div>
                                            }
                                            else if (currentDate.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday && hol is null)
                                            {
                                                <div class="small text-body-secondary">Weekend</div>
                                            }
                                        </td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/attendance.js" asp-append-version="true"></script>
}
