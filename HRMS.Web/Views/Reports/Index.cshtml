@using System.Text.Json
@model ReportsHubPageViewModel
@{
    ViewData["Title"] = "Executive Reports & Analytics Hub";
    ViewData["BreadcrumbParent"] = "Reports & Analytics";
    var camelOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var hubPayload = JsonSerializer.Serialize(new
    {
        departmentStats = Model.DepartmentStats,
        financialTrends = Model.FinancialTrends,
        attritionBreakdown = Model.AttritionBreakdown
    }, camelOpts);
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        @if (Model.CanExport)
        {
            <button type="button" class="btn btn-primary btn-sm" onclick="HrmsReports.openTemplateModal()">
                <i class="bi bi-bookmark-plus me-1"></i>Save Report Preset
            </button>
        }
    </div>
}

<!-- Interactive Filter Bar (AJAX Refresh) -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form onsubmit="event.preventDefault(); HrmsReports.refreshHub();" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Branch</label>
                <select id="hubBranchId" class="form-select form-select-sm">
                    <option value="">All Branches</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.BranchId" selected="@(Model.BranchId == b.BranchId)">@b.BranchName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Department</label>
                <select id="hubDepartmentId" class="form-select form-select-sm">
                    <option value="">All Departments</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.DepartmentId" selected="@(Model.DepartmentId == d.DepartmentId)">@d.DepartmentName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">From Date</label>
                <input type="date" id="hubFromDate" class="form-control form-control-sm" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">To Date</label>
                <input type="date" id="hubToDate" class="form-control form-control-sm" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" id="hubRefreshBtn" class="btn btn-primary btn-sm flex-fill">
                    <i class="bi bi-arrow-clockwise me-1"></i>Apply Live
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Executive Cross-Module KPI Strip -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary fw-semibold">Active Headcount</div>
                <div class="fs-4 fw-bold text-primary" id="kpiHeadcount">@Model.Kpi.ActiveHeadcount</div>
                <div class="small text-body-secondary" id="kpiProbation">@Model.Kpi.ProbationCount on probation</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary fw-semibold">Period Turnover</div>
                <div class="fs-4 fw-bold text-danger" id="kpiTurnover">@Model.Kpi.TurnoverRatePercent%</div>
                <div class="small text-body-secondary" id="kpiSeparations">@Model.Kpi.ActiveSeparationCases active exit cases</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary fw-semibold">Monthly Gross Pay</div>
                <div class="fs-4 fw-bold text-success" id="kpiPayroll">@Model.Kpi.MonthlyPayrollCost.ToString("C0")</div>
                <div class="small text-body-secondary" id="kpiLoans">Loans: @Model.Kpi.OutstandingLoanPortfolio.ToString("C0")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary fw-semibold">Attendance Rate</div>
                <div class="fs-4 fw-bold text-info" id="kpiAttendance">@Model.Kpi.AttendanceCompliancePercent%</div>
                <div class="small text-body-secondary" id="kpiLeaveDays">@Model.Kpi.ApprovedLeaveDaysInPeriod.ToString("F1") approved leave days</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary fw-semibold">Open Requisitions</div>
                <div class="fs-4 fw-bold text-warning" id="kpiOpenReqs">@Model.Kpi.OpenRequisitionsCount</div>
                <div class="small text-body-secondary" id="kpiAppraisals">Appraisals: @Model.Kpi.AppraisalCompletionPercent% done</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary fw-semibold">Asset Portfolio</div>
                <div class="fs-4 fw-bold" id="kpiAssetValue">@Model.Kpi.ActiveAssetPortfolioValue.ToString("C0")</div>
                <div class="small text-body-secondary">Active company assets</div>
            </div>
        </div>
    </div>
</div>

<!-- Analytics Charts -->
<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-building me-2 text-primary"></i>Department Headcount vs. Net Payroll</h6>
            </div>
            <div class="card-body">
                <canvas id="repDeptCostChart" height="140"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-graph-up me-2 text-success"></i>6-Month Payroll &amp; Expense Trend</h6>
            </div>
            <div class="card-body">
                <canvas id="repFinTrendChart" height="140"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Standard Enterprise Report Catalog & Attrition Chart -->
<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent py-3">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-collection me-2 text-primary"></i>Enterprise Report Suite</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <a asp-action="Workforce" class="card border h-100 text-decoration-none text-reset">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-semibold text-primary"><i class="bi bi-people me-2"></i>Workforce &amp; Headcount</span>
                                    <i class="bi bi-arrow-right small"></i>
                                </div>
                                <div class="small text-body-secondary">Demographics, job grades, tenure, reporting managers, and base compensation roster.</div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a asp-action="AttendanceLeave" class="card border h-100 text-decoration-none text-reset">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-semibold text-info"><i class="bi bi-clock-history me-2"></i>Attendance &amp; Leave</span>
                                    <i class="bi bi-arrow-right small"></i>
                                </div>
                                <div class="small text-body-secondary">Punctuality, late minutes, overtime hours, leave taken, and remaining leave accruals.</div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a asp-action="PayrollCost" class="card border h-100 text-decoration-none text-reset">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-semibold text-success"><i class="bi bi-cash-stack me-2"></i>Payroll Cost-to-Company</span>
                                    <i class="bi bi-arrow-right small"></i>
                                </div>
                                <div class="small text-body-secondary">Monthly payroll register, tax deductions, employer contributions, and net disbursement.</div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a asp-action="TalentRecruitment" class="card border h-100 text-decoration-none text-reset">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-semibold text-warning"><i class="bi bi-award me-2"></i>Recruitment &amp; Talent</span>
                                    <i class="bi bi-arrow-right small"></i>
                                </div>
                                <div class="small text-body-secondary">Hiring requisition pipeline funnel, appraisal ratings, and training certifications.</div>
                            </div>
                        </a>
                    </div>
                    <div class="col-12">
                        <a asp-action="FinancialCompliance" class="card border text-decoration-none text-reset">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-semibold text-danger"><i class="bi bi-shield-check me-2"></i>Loans, Expenses, Assets &amp; Exit Compliance</span>
                                    <i class="bi bi-arrow-right small"></i>
                                </div>
                                <div class="small text-body-secondary">Employee loan balances, approved expense claims, custody assets, policy sign-offs, and settlements.</div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent py-3">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-pie-chart me-2 text-danger"></i>Attrition &amp; Separation Drivers</h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="repAttritionChart" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Saved Presets & Recent Export Audit Log -->
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-bookmarks me-2 text-primary"></i>Saved Report Presets</h6>
                @if (Model.CanExport)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="HrmsReports.openTemplateModal()">+ New Preset</button>
                }
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Preset Name</th>
                                <th>Module</th>
                                <th>Scope</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.SavedTemplates.Any())
                            {
                                <tr><td colspan="4" class="text-center text-body-secondary py-4">No saved report presets yet.</td></tr>
                            }
                            else
                            {
                                @foreach (var t in Model.SavedTemplates)
                                {
                                    var targetAction = t.ReportKey switch
                                    {
                                        "AttendanceLeave" => "AttendanceLeave",
                                        "PayrollCost" => "PayrollCost",
                                        "TalentRecruitment" => "TalentRecruitment",
                                        "FinancialCompliance" => "FinancialCompliance",
                                        _ => "Workforce"
                                    };
                                    var rangeFrom = DateTime.Today.AddDays(-Math.Max(1, t.DateRangeDays) + 1).ToString("yyyy-MM-dd");
                                    var rangeTo = DateTime.Today.ToString("yyyy-MM-dd");
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@t.TemplateName</div>
                                            @if (!string.IsNullOrWhiteSpace(t.Notes))
                                            {
                                                <div class="text-body-secondary">@t.Notes</div>
                                            }
                                        </td>
                                        <td><span class="badge bg-primary-subtle text-primary-emphasis">@t.ReportKey</span></td>
                                        <td class="text-body-secondary">
                                            @(t.BranchName ?? "All Branches") &bull; @(t.DepartmentName ?? "All Depts") &bull; @(t.DateRangeDays)d
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <a asp-action="@targetAction" asp-route-branchId="@t.BranchId" asp-route-departmentId="@t.DepartmentId"
                                               asp-route-fromDate="@rangeFrom" asp-route-toDate="@rangeTo"
                                               class="btn btn-sm btn-outline-success" title="Run Preset">
                                                <i class="bi bi-play-fill"></i> Run
                                            </a>
                                            @if (Model.CanExport)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary" title="Edit"
                                                        onclick='HrmsReports.openTemplateModal(@Html.Raw(JsonSerializer.Serialize(t, camelOpts)))'>
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-danger" title="Delete"
                                                        onclick='HrmsReports.deleteTemplate(@t.TemplateId, @Html.Raw(JsonSerializer.Serialize(t.TemplateName)))'>
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-clock-history me-2 text-info"></i>Recent Report Export Audit Log</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Report</th>
                                <th>Format</th>
                                <th class="text-end">Rows</th>
                                <th>Exported By</th>
                                <th>Timestamp</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentExports.Any())
                            {
                                <tr><td colspan="5" class="text-center text-body-secondary py-4">No report exports logged yet.</td></tr>
                            }
                            else
                            {
                                @foreach (var ex in Model.RecentExports)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@ex.ReportTitle</div>
                                            @if (!string.IsNullOrWhiteSpace(ex.FilterSummary))
                                            {
                                                <div class="text-body-secondary">@ex.FilterSummary</div>
                                            }
                                        </td>
                                        <td><span class="badge bg-secondary-subtle text-secondary-emphasis">@ex.ExportFormat</span></td>
                                        <td class="text-end font-monospace">@ex.RecordCount</td>
                                        <td>@ex.ExportedByName</td>
                                        <td class="text-body-secondary">@ex.ExportedDate.ToString("dd MMM HH:mm")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.CanExport)
{
    <!-- Save Report Preset Modal -->
    <div class="modal fade" id="reportTemplateModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="repTplModalTitle">Save Report Preset</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="reportTemplateForm" onsubmit="event.preventDefault(); HrmsReports.submitAjaxForm('#reportTemplateForm', '@Url.Action("SaveTemplate")', '#reportTemplateModal');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="repTplId" name="TemplateId" value="0" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Preset Name <span class="text-danger">*</span></label>
                            <input type="text" id="repTplName" name="TemplateName" class="form-control" maxlength="120" required />
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-7">
                                <label class="form-label small fw-semibold">Report Module <span class="text-danger">*</span></label>
                                <select id="repTplKey" name="ReportKey" class="form-select" required>
                                    <option value="Workforce">Workforce &amp; Headcount</option>
                                    <option value="AttendanceLeave">Attendance &amp; Leave</option>
                                    <option value="PayrollCost">Payroll Cost-to-Company</option>
                                    <option value="TalentRecruitment">Recruitment &amp; Talent</option>
                                    <option value="FinancialCompliance">Financial &amp; Compliance</option>
                                </select>
                            </div>
                            <div class="col-5">
                                <label class="form-label small fw-semibold">Window (Days)</label>
                                <input type="number" id="repTplDays" name="DateRangeDays" class="form-control" min="1" max="365" value="30" required />
                            </div>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-semibold">Branch Scope</label>
                                <select id="repTplBranch" name="BranchId" class="form-select">
                                    <option value="">All Branches</option>
                                    @foreach (var b in Model.Branches)
                                    {
                                        <option value="@b.BranchId">@b.BranchName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold">Department Scope</label>
                                <select id="repTplDept" name="DepartmentId" class="form-select">
                                    <option value="">All Departments</option>
                                    @foreach (var d in Model.Departments)
                                    {
                                        <option value="@d.DepartmentId">@d.DepartmentName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Optional Status Filter</label>
                            <input type="text" id="repTplStatus" name="StatusFilter" class="form-control" maxlength="40" placeholder="e.g., Active, Approved, Open" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Notes</label>
                            <textarea id="repTplNotes" name="Notes" class="form-control" rows="2" maxlength="300"></textarea>
                        </div>
                        <div class="form-check form-switch">
                            <input type="hidden" name="IsShared" value="false" />
                            <input class="form-check-input" type="checkbox" id="repTplShared" name="IsShared" value="true" checked />
                            <label class="form-check-label small fw-semibold" for="repTplShared">Share Preset Across Authorized Users</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Preset</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        window.HRMS_REPORTS_HUB_DATA = @Html.Raw(hubPayload);
    </script>
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
