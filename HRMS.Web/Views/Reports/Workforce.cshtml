@model WorkforceReportPageViewModel
@{
    ViewData["Title"] = "Workforce Headcount & Compensation Report";
    ViewData["BreadcrumbParent"] = "Reports & Analytics";
    var activeCount = Model.Rows.Count(x => x.IsActive);
    var totalBaseSalary = Model.Rows.Where(x => x.IsActive).Sum(x => x.BaseSalary);
    var avgTenure = Model.Rows.Any() ? Model.Rows.Average(x => x.TenureYears) : 0m;
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Analytics Hub
        </a>
        @if (Model.CanExport)
        {
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    onclick="HrmsReports.printReport('Workforce', 'Workforce Headcount & Compensation Report', @Model.Rows.Count, 'Headcount Print')">
                <i class="bi bi-printer me-1"></i>Print / PDF
            </button>
            <a asp-action="ExportWorkforce" asp-route-branchId="@Model.BranchId" asp-route-departmentId="@Model.DepartmentId"
               asp-route-employmentStatus="@Model.EmploymentStatus" asp-route-search="@Model.Search"
               class="btn btn-success btn-sm">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export CSV
            </a>
        }
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary fw-semibold">Matched Employees</div>
                <div class="fs-4 fw-bold">@Model.Rows.Count</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-success fw-semibold">Active Staff</div>
                <div class="fs-4 fw-bold text-success">@activeCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-primary fw-semibold">Annual Base Payroll</div>
                <div class="fs-4 fw-bold text-primary">@totalBaseSalary.ToString("C0")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-info fw-semibold">Avg Tenure</div>
                <div class="fs-4 fw-bold text-info">@avgTenure.ToString("F1") <span class="fs-6 fw-normal text-body-secondary">yrs</span></div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Branch</label>
                <select name="branchId" class="form-select form-select-sm">
                    <option value="">All Branches</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.BranchId" selected="@(Model.BranchId == b.BranchId)">@b.BranchName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Department</label>
                <select name="departmentId" class="form-select form-select-sm">
                    <option value="">All Departments</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.DepartmentId" selected="@(Model.DepartmentId == d.DepartmentId)">@d.DepartmentName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Status</label>
                <select name="employmentStatus" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="1" selected="@(Model.EmploymentStatus == 1)">Active</option>
                    <option value="2" selected="@(Model.EmploymentStatus == 2)">Probation</option>
                    <option value="3" selected="@(Model.EmploymentStatus == 3)">OnLeave</option>
                    <option value="4" selected="@(Model.EmploymentStatus == 4)">Resigned</option>
                    <option value="5" selected="@(Model.EmploymentStatus == 5)">Terminated</option>
                    <option value="6" selected="@(Model.EmploymentStatus == 6)">Inactive</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Keyword</label>
                <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Code, name, email..." />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-funnel me-1"></i>Generate</button>
                <a asp-action="Workforce" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-rep-datatable w-100">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Branch / Dept</th>
                        <th>Designation &amp; Grade</th>
                        <th>Manager</th>
                        <th>Hire Date</th>
                        <th class="text-end">Tenure</th>
                        <th class="text-end">Annual Base</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var stBadge = row.IsActive ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis";
                        <tr>
                            <td class="small">
                                <div class="fw-semibold">@row.FullName</div>
                                <div class="text-body-secondary font-monospace">@row.EmployeeCode &bull; @row.Gender</div>
                            </td>
                            <td class="small">
                                <div>@row.DepartmentName</div>
                                <div class="text-body-secondary">@row.BranchName</div>
                            </td>
                            <td class="small">
                                <div>@row.DesignationTitle</div>
                                <div class="text-body-secondary">Grade: @row.JobGrade</div>
                            </td>
                            <td class="small">@row.ManagerName</td>
                            <td class="small">@row.HireDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end small font-monospace">@row.TenureYears.ToString("F1")y</td>
                            <td class="text-end small fw-semibold">@row.BaseSalary.ToString("C0")</td>
                            <td><span class="badge @stBadge">@row.EmploymentStatusLabel</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
