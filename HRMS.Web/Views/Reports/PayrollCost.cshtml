@using System.Text.Json
@model PayrollCostReportPageViewModel
@{
    ViewData["Title"] = "Payroll Register & Cost-to-Company Report";
    ViewData["BreadcrumbParent"] = "Reports & Analytics";
    var camelOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var totalGross = Model.Rows.Sum(x => x.GrossPay);
    var totalTax = Model.Rows.Sum(x => x.IncomeTax);
    var totalNet = Model.Rows.Sum(x => x.NetPay);
    var totalCtc = Model.Rows.Sum(x => x.CostToCompany);
    var currentYear = DateTime.Today.Year;
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Analytics Hub
        </a>
        @if (Model.CanExport)
        {
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    onclick="HrmsReports.printReport('PayrollCost', 'Payroll Cost-to-Company Register', @Model.Rows.Count, '@Model.PayrollYear-@Model.PayrollMonth')">
                <i class="bi bi-printer me-1"></i>Print / PDF
            </button>
            <a asp-action="ExportPayrollCost" asp-route-payrollYear="@Model.PayrollYear" asp-route-payrollMonth="@Model.PayrollMonth"
               asp-route-branchId="@Model.BranchId" asp-route-departmentId="@Model.DepartmentId"
               class="btn btn-success btn-sm">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export CSV
            </a>
        }
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-body-secondary fw-semibold">Total Gross Pay</div>
                <div class="fs-4 fw-bold text-primary">@totalGross.ToString("C2")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-warning fw-semibold">Income Tax Withheld</div>
                <div class="fs-4 fw-bold text-warning">@totalTax.ToString("C2")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-success fw-semibold">Total Net Disbursement</div>
                <div class="fs-4 fw-bold text-success">@totalNet.ToString("C2")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-info fw-semibold">Total Cost-to-Company</div>
                <div class="fs-4 fw-bold text-info">@totalCtc.ToString("C2")</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Year</label>
                <select name="payrollYear" class="form-select form-select-sm">
                    @for (var y = currentYear; y >= currentYear - 3; y--)
                    {
                        <option value="@y" selected="@(Model.PayrollYear == y)">@y</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Month</label>
                <select name="payrollMonth" class="form-select form-select-sm">
                    @for (var m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(Model.PayrollMonth == m)">@(new DateTime(2000, m, 1).ToString("MMMM"))</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Branch</label>
                <select name="branchId" class="form-select form-select-sm">
                    <option value="">All Branches</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.BranchId" selected="@(Model.BranchId == b.BranchId)">@b.BranchName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Department</label>
                <select name="departmentId" class="form-select form-select-sm">
                    <option value="">All Departments</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.DepartmentId" selected="@(Model.DepartmentId == d.DepartmentId)">@d.DepartmentName</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-funnel me-1"></i>Generate</button>
                <a asp-action="PayrollCost" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

@if (Model.Rows.Any())
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-transparent py-3">
            <h6 class="mb-0 fw-semibold"><i class="bi bi-bar-chart me-2 text-primary"></i>Department Payroll Cost Breakdown</h6>
        </div>
        <div class="card-body">
            <canvas id="repPayrollDeptChart" height="90"></canvas>
        </div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-rep-datatable w-100">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Department</th>
                        <th>Period / Status</th>
                        <th class="text-end">Basic</th>
                        <th class="text-end">Allowances &amp; Var</th>
                        <th class="text-end">Gross</th>
                        <th class="text-end">Tax &amp; Ded.</th>
                        <th class="text-end">Net Pay</th>
                        <th class="text-end">CTC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var varEarnings = row.TotalAllowances + row.OvertimePay + row.LeaveEncashmentPay + row.BonusAmount;
                        <tr>
                            <td class="small">
                                <div class="fw-semibold">@row.EmployeeName</div>
                                <div class="text-body-secondary font-monospace">@row.EmployeeCode &bull; @row.DesignationTitle</div>
                            </td>
                            <td class="small">
                                <div>@row.DepartmentName</div>
                                <div class="text-body-secondary">@row.BranchName</div>
                            </td>
                            <td class="small">
                                <div>@row.PeriodLabel</div>
                                <span class="badge bg-info-subtle text-info-emphasis">@row.PayrollStatus</span>
                            </td>
                            <td class="text-end small">@row.BasicPay.ToString("C0")</td>
                            <td class="text-end small">@varEarnings.ToString("C0")</td>
                            <td class="text-end small fw-semibold">@row.GrossPay.ToString("C0")</td>
                            <td class="text-end small text-danger">-@row.TotalDeductions.ToString("C0")</td>
                            <td class="text-end small fw-bold text-success">@row.NetPay.ToString("C0")</td>
                            <td class="text-end small fw-semibold text-primary">@row.CostToCompany.ToString("C0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.HRMS_PAYROLL_REPORT_ROWS = @Html.Raw(JsonSerializer.Serialize(Model.Rows, camelOpts));
    </script>
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
