@model FinancialComplianceReportPageViewModel
@{
    ViewData["Title"] = "Loans, Expenses, Assets & Compliance Report";
    ViewData["BreadcrumbParent"] = "Reports & Analytics";
    var totalLoanBalance = Model.FinancialRows.Sum(x => x.RemainingLoanBalance);
    var totalApprovedExpenses = Model.FinancialRows.Sum(x => x.ApprovedExpenseAmount);
    var totalAssetValue = Model.ComplianceRows.Sum(x => x.AssignedAssetValue);
    var activeExits = Model.ComplianceRows.Count(x => x.SeparationStatus != "ActiveEmployee");
}

@section PageActions {
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Analytics Hub
        </a>
        @if (Model.CanExport)
        {
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    onclick="HrmsReports.printReport('FinancialCompliance', 'Financial & Compliance Audit Report', @(Model.FinancialRows.Count + Model.ComplianceRows.Count), '@Model.FromDate.ToString("yyyy-MM-dd") to @Model.ToDate.ToString("yyyy-MM-dd")')">
                <i class="bi bi-printer me-1"></i>Print / PDF
            </button>
            <a asp-action="ExportFinancialLoans" asp-route-departmentId="@Model.DepartmentId"
               asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")"
               class="btn btn-success btn-sm">
                <i class="bi bi-download me-1"></i>Loans &amp; Expenses CSV
            </a>
            <a asp-action="ExportComplianceLedger" asp-route-departmentId="@Model.DepartmentId"
               asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")"
               class="btn btn-outline-success btn-sm">
                <i class="bi bi-download me-1"></i>Assets &amp; Compliance CSV
            </a>
        }
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-warning fw-semibold">Outstanding Loans</div>
                <div class="fs-4 fw-bold text-warning">@totalLoanBalance.ToString("C0")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-success fw-semibold">Approved Expenses</div>
                <div class="fs-4 fw-bold text-success">@totalApprovedExpenses.ToString("C0")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-primary fw-semibold">Issued Asset Custody Value</div>
                <div class="fs-4 fw-bold text-primary">@totalAssetValue.ToString("C0")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="small text-danger fw-semibold">Separation Records</div>
                <div class="fs-4 fw-bold text-danger">@activeExits</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Department</label>
                <select name="departmentId" class="form-select form-select-sm">
                    <option value="">All Departments</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.DepartmentId" selected="@(Model.DepartmentId == d.DepartmentId)">@d.DepartmentName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Expense From</label>
                <input type="date" name="fromDate" class="form-control form-control-sm" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Expense To</label>
                <input type="date" name="toDate" class="form-control form-control-sm" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-funnel me-1"></i>Generate</button>
                <a asp-action="FinancialCompliance" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-transparent py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-bank me-2 text-warning"></i>Employee Loans &amp; Expense Reimbursements</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-rep-datatable w-100">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Department</th>
                        <th class="text-center">Active Loans</th>
                        <th class="text-end">Total Principal</th>
                        <th class="text-end">Remaining Balance</th>
                        <th class="text-center">Expense Claims</th>
                        <th class="text-end">Claimed</th>
                        <th class="text-end">Approved / Paid</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.FinancialRows)
                    {
                        <tr>
                            <td class="small">
                                <div class="fw-semibold">@f.EmployeeName</div>
                                <div class="text-body-secondary font-monospace">@f.EmployeeCode</div>
                            </td>
                            <td class="small">@f.DepartmentName</td>
                            <td class="text-center small">@f.ActiveLoansCount</td>
                            <td class="text-end small">@f.TotalLoanPrincipal.ToString("C2")</td>
                            <td class="text-end small fw-semibold @(f.RemainingLoanBalance > 0 ? "text-warning" : "text-body-secondary")">@f.RemainingLoanBalance.ToString("C2")</td>
                            <td class="text-center small">@f.ExpenseClaimCount</td>
                            <td class="text-end small">@f.TotalClaimedAmount.ToString("C2")</td>
                            <td class="text-end small fw-semibold text-success">@f.ApprovedExpenseAmount.ToString("C2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-shield-check me-2 text-primary"></i>Asset Custody, Policy Sign-Offs &amp; Separation Audit</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle hrms-rep-datatable w-100">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Department</th>
                        <th class="text-center">Assets Held</th>
                        <th class="text-end">Asset Value</th>
                        <th class="text-center">Policy Sign-Offs</th>
                        <th>Separation Case</th>
                        <th>Settlement Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.ComplianceRows)
                    {
                        <tr>
                            <td class="small">
                                <div class="fw-semibold">@c.EmployeeName</div>
                                <div class="text-body-secondary font-monospace">@c.EmployeeCode</div>
                            </td>
                            <td class="small">@c.DepartmentName</td>
                            <td class="text-center small fw-semibold">@c.AssignedAssetCount</td>
                            <td class="text-end small">@c.AssignedAssetValue.ToString("C0")</td>
                            <td class="text-center small">
                                <span class="badge @(c.AcknowledgedPoliciesCount >= c.MandatoryPoliciesCount ? "bg-success-subtle text-success-emphasis" : "bg-warning-subtle text-warning-emphasis")">
                                    @c.AcknowledgedPoliciesCount / @c.MandatoryPoliciesCount
                                </span>
                            </td>
                            <td class="small">
                                @if (c.SeparationNumber != "-")
                                {
                                    <span class="font-monospace fw-semibold">@c.SeparationNumber</span>
                                    <span class="badge bg-info-subtle text-info-emphasis ms-1">@c.SeparationStatus</span>
                                }
                                else
                                {
                                    <span class="text-body-secondary">Active</span>
                                }
                            </td>
                            <td class="small">
                                @if (c.SettlementStatus != "-")
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">@c.SettlementStatus</span>
                                    @if (c.SettlementNetAmount.HasValue)
                                    {
                                        <span class="ms-1 fw-semibold">@c.SettlementNetAmount.Value.ToString("C0")</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-body-secondary">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
